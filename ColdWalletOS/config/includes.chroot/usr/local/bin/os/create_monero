#!/bin/bash

# ---------------------------------------------------------
#  UI THEME (Stealth)
# ---------------------------------------------------------
export PATH=$PATH:/usr/sbin:/sbin
export TERM=linux
stty sane

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8" # Color 4 (Blue) -> Cyan
    echo -ne "\e]P7ffffff" # Color 7 (Lightgray) -> Pure White
    clear
fi

# 2. ASSIGN NEWT COLORS
# window = black (Dark Gray)
# border/title/text = blue (Cyan)
# button = white (fg) on black (bg)
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# ---------------------------------------------------------
#  CONFIG
# ---------------------------------------------------------
WALLET_DIR="/mnt/vault/monero"
TEMP_NAME="vault_temp"
PASS_FILE="/mnt/vault/config/password.cfg"
PASSWORD=$(tr -d '\n' < "$PASS_FILE")

mkdir -p "$WALLET_DIR"

ADDR_FILE="/tmp/xmr_addr.$$"
VIEW_FILE="/tmp/xmr_view.$$"

# ---------------------------------------------------------
#  GAUGE + WORK
# ---------------------------------------------------------
(
echo 5
sleep 0.1

# 1) Create wallet and capture all output (stdout+stderr)
CREATE_OUT=$(printf "n\n" | /usr/local/bin/monero-wallet-cli \
  --generate-new-wallet "$WALLET_DIR/$TEMP_NAME" \
  --password "$PASSWORD" \
  --daemon-address 127.0.0.1:0 \
  --mnemonic-language English \
  --log-file "$WALLET_DIR/${TEMP_NAME}.log" \
  --offline \
  --create-address-file \
  2>&1)

echo 40
sleep 0.1

# 2) Parse view key from creation output
VIEW_KEY=$(printf '%s\n' "$CREATE_OUT" | awk -F': ' '/^View key:/ {print $2}')
echo "$VIEW_KEY" > "$VIEW_FILE"

echo 60
sleep 0.1

# 3) Read address from .address.txt
if [ -f "$WALLET_DIR/${TEMP_NAME}.address.txt" ]; then
    ADDR=$(tr -d '[:space:]' < "$WALLET_DIR/${TEMP_NAME}.address.txt")
    echo "$ADDR" > "$ADDR_FILE"
fi

echo 80
sleep 0.1

# 4) Move wallet files into address folder
if [ -n "$ADDR" ]; then
    mkdir -p "$WALLET_DIR/$ADDR"
    mv "$WALLET_DIR/$TEMP_NAME"        "$WALLET_DIR/$ADDR/wallet"      2>/dev/null
    mv "$WALLET_DIR/$TEMP_NAME.keys"   "$WALLET_DIR/$ADDR/wallet.keys" 2>/dev/null
    mv "$WALLET_DIR/${TEMP_NAME}.log"  "$WALLET_DIR/$ADDR/wallet.log"  2>/dev/null
    rm -f "$WALLET_DIR/${TEMP_NAME}.address.txt"
fi

sync

echo 100
sleep 0.1
) | whiptail --gauge "Creating Monero wallet...\nPlease wait." 8 50 0

sync

# ---------------------------------------------------------
#  READ BACK ADDRESS & VIEW KEY
# ---------------------------------------------------------
ADDR=$(cat "$ADDR_FILE" 2>/dev/null)
VIEW_KEY=$(cat "$VIEW_FILE" 2>/dev/null)
rm -f "$ADDR_FILE" "$VIEW_FILE"

# ---------------------------------------------------------
#  CREATE WATCH-ONLY INFO
# ---------------------------------------------------------
if [ -n "$ADDR" ] && [ -n "$VIEW_KEY" ]; then
    WATCH_BASE="/mnt/sallyport/watch_monero"
    WATCH_PATH="$WATCH_BASE/$ADDR"
    mkdir -p "$WATCH_PATH"

    # Loop indefinitely until a valid date is entered
    while :; do
        # We leave the init text empty "" so there is no pre-fill
        RESTORE_DATE=$(whiptail --title "Set Restore Date (REQUIRED)" \
            --nocancel \
            --inputbox "\nEnter the wallet restore date (YYYY-MM-DD).\n" \
            10 50 "" 3>&1 1>&2 2>&3)

        # Validate format using regex (YYYY-MM-DD)
        if [[ $RESTORE_DATE =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            # Format is correct, exit the loop
            break
        else
            whiptail --title "Invalid Format" \
                --msgbox "ERROR: '$RESTORE_DATE' is not valid.\n\nYou must enter the date manually as YYYY-MM-DD.\nExample: 2026-04-29" 10 50
        fi
    done

    {
        echo "ADDRESS: $ADDR"
        echo "VIEW_KEY: $VIEW_KEY"
        echo "RESTORE_DATE: $RESTORE_DATE"
        echo "TYPE: watch-only"
    } > "$WATCH_PATH/watch_info.txt"
    
    # Copy the file into the vault directory
    cp "$WATCH_PATH/watch_info.txt" "$WALLET_DIR/$ADDR/watch_info.txt"
    
    sync

    whiptail --title "Monero Wallet Created" \
             --msgbox "\nYour Monero wallet has been generated.\n\nAddress:\n$ADDR" \
             0 0
             
    whiptail --title " WALLET RECOVERY " \
             --msgbox "\nIt is highly recommended that you write down the information displayed on the next screen. This will allow you to restore your wallet on any other machine in case of data loss.\n\nSTORE IT IN A SAFE PLACE!\n" \
             0 0
             
    # ---------------------------------------------------------
    #  RPC QUERY LOGIC FOR NEWLY CREATED WALLET
    # ---------------------------------------------------------
    RPC_PORT="38088"
    WALLET_PATH="$WALLET_DIR/$ADDR/wallet"

    # Ensure no lingering RPC processes are alive
    killall monero-wallet-rpc 2>/dev/null
    sleep 1

    # Start the RPC daemon pointing to the new wallet file
    monero-wallet-rpc --wallet-file "$WALLET_PATH" --password "$PASSWORD" --rpc-bind-port "$RPC_PORT" \
        --rpc-bind-ip 127.0.0.1 --disable-rpc-login --offline --detach >/dev/null 2>&1

    # Wait for RPC to respond
    until curl -s http://127.0.0.1:"$RPC_PORT"/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"get_version"}' >/dev/null 2>&1; do
        sleep 0.5
    done

    # Query the seed directly from the daemon
    SEED_RESPONSE=$(curl -s -X POST http://127.0.0.1:"$RPC_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"query_key","params":{"key_type":"mnemonic"}}')

    # Kill the temporary daemon safely
    curl -s -X POST http://127.0.0.1:"$RPC_PORT"/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"stop_wallet"}' >/dev/null 2>&1

    # ---------------------------------------------------------
    #  FORMATTING: COMPACT 3-COLUMN GRID (24 WORDS ONLY)
    # ---------------------------------------------------------
    SEED_RAW=$(echo "$SEED_RESPONSE" | jq -r '.result.key')

    # Format the top layout rows to exactly match the viewing script's appearance
    ADDR_SHORT="${ADDR:0:8}...${ADDR: -8}"
    FORMATTED_SEED="Address (shortened): $ADDR_SHORT\nRestore Date: $RESTORE_DATE\n"
    
    # Build the 3-column grid, stopping exactly after word 24
    i=1
    for word in $SEED_RAW; do
        if [ $i -gt 24 ]; then
            break
        fi
        
        FORMATTED_SEED+="$(printf "%-15s" "$i.$word")"
        if (( i % 3 == 0 )); then 
            FORMATTED_SEED+="\n" 
        fi
        ((i++))
    done

    # Display the final seed window
    whiptail --title " RECOVERY SEED " --msgbox "$(echo -e "$FORMATTED_SEED")" 16 50
    
    # Return to management environment console
    /usr/local/bin/os/main_menu
else
    whiptail --title "Error" \
             --msgbox "\nWallet generation failed.\n" \
             0 0
             
    /usr/local/bin/os/main_menu
fi
