#!/bin/bash

# ---------------------------------------------------------
#  UI THEME
# ---------------------------------------------------------
export PATH=$PATH:/usr/sbin:/sbin
export TERM=linux
stty sane

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8" # Color 4 (Blue) -> Cyan
    echo -ne "\e]P7ffffff" # Color 7 (Lightgray) -> Pure White
    clear
fi

# 2. ASSIGN NEWT COLORS
# window = black (Dark Gray)
# border/title/text = blue (Cyan)
# button = white (fg) on black (bg)
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

BASE_DIR="/mnt/vault/ethers"
mkdir -p "$BASE_DIR" >/dev/null 2>&1

ADDR_FILE="/tmp/eth_addr.$$"

# ---------------------------------------------------------
#  SHOW GAUGE IMMEDIATELY — WORK HAPPENS BEHIND IT
# ---------------------------------------------------------
(
echo 5
sleep 0.1

# Generate keypair silently
openssl ecparam -name secp256k1 -genkey -noout 2>/dev/null \
    | openssl ec -text -noout 2>/dev/null \
    > temp_key.txt 2>/dev/null

echo 35
sleep 0.1

# Extract private key
PRIV_HEX=$(grep "priv:" -A 3 temp_key.txt | tail -n +2 | tr -d ' \n:' | sed 's/^00//')

# Extract public key
PUB_HEX=$(grep "pub:" -A 5 temp_key.txt | tail -n +2 | tr -d ' \n:' | sed 's/^04//')

echo 65
sleep 0.1

# Compute Ethereum address
ADDR="0x$(node -e "
try {
    const { keccak256 } = require('/usr/local/lib/node_modules/js-sha3');
    const pubBytes = Buffer.from('$PUB_HEX', 'hex');
    console.log(keccak256(pubBytes).slice(-40));
} catch (e) { process.exit(1); }
" 2>/dev/null)"

# Pass address back to parent
echo "$ADDR" > "$ADDR_FILE"

echo 85
sleep 0.1

# Save wallet
if [ ${#ADDR} -ne 42 ]; then
    FOLDER_NAME="ETH_$(date +%s)"
else
    FOLDER_NAME="$ADDR"
fi

WALLET_PATH="$BASE_DIR/$FOLDER_NAME"
mkdir -p "$WALLET_PATH" >/dev/null 2>&1

{
    echo "ADDRESS: $ADDR"
    echo "PRIVATE_KEY: $PRIV_HEX"
    echo "PUBLIC_KEY: $PUB_HEX"
} > "$WALLET_PATH/keys.txt"
sync

# ---------------------------------------------------------
#  CREATE WATCH-ONLY WALLET VERSION
# ---------------------------------------------------------
WATCH_BASE="/mnt/sallyport/watch_ethereum"
WATCH_PATH="$WATCH_BASE/$FOLDER_NAME"

mkdir -p "$WATCH_PATH" >/dev/null 2>&1

{
    echo "ADDRESS: $ADDR"
    echo "PUBLIC_KEY: $PUB_HEX"
    echo "TYPE: watch-only"
} > "$WATCH_PATH/watch_info.txt"
sync

# Cleanup
rm temp_key.txt >/dev/null 2>&1

echo 100
sleep 0.1
) |
whiptail --gauge "Creating Ethereum wallet...\nPlease wait." 8 50 0
sync

# ---------------------------------------------------------
#  READ ADDRESS BACK FROM TEMP FILE
# ---------------------------------------------------------
ADDR=$(cat "$ADDR_FILE" 2>/dev/null)
rm -f "$ADDR_FILE"

# ---------------------------------------------------------
#  SHOW FINAL POPUP
# ---------------------------------------------------------
whiptail --title "Wallet Created" \
         --msgbox "\nYour Ethereum wallet has been generated.\n\nAddress:\n$ADDR" \
         0 0

/usr/local/bin/os/main_menu
