#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_monero"
VAULT_DIR="/mnt/vault/monero"
PASS_FILE="/mnt/vault/config/password.cfg"
LOG_FILE="/tmp/logs/sign_monero_rpc.log"

mkdir -p "$(dirname "$LOG_FILE")"

PASSWORD=$(tr -d '\n\r ' < "$PASS_FILE")

log() { echo "[$(date '+%F %T')] $1" >> "$LOG_FILE"; }

UNSIGNED_LIST=$(find "$WATCH_DIR" -type f -name "unsigned_tx_*")
[ -z "$UNSIGNED_LIST" ] && exit 0

start_rpc() {
    local WALLET_PATH=$1
    local TARGET_PORT=$2

    monero-wallet-rpc \
        --wallet-file "$WALLET_PATH" \
        --password "$PASSWORD" \
        --rpc-bind-port "$TARGET_PORT" \
        --rpc-bind-ip 127.0.0.1 \
        --disable-rpc-login \
        --offline \
        --daemon-address "" \
        --log-file /tmp/wallet-rpc.log \
        --detach

    until curl -s http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"get_version"}' >/dev/null; do
        sleep 0.5
    done
}

stop_rpc() {
    local TARGET_PORT=$1
    curl -s -X POST http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"stop_wallet"}' >/dev/null 2>&1
}

hex_to_bin_file() {
    local HEX="$1"
    local OUTFILE="$2"
    printf '%b' "$(echo "$HEX" | sed 's/../\\x&/g')" > "$OUTFILE"
}

sign_tx_rpc() {
    local OUTDIR=$1
    local REAL_WALLET=$2
    local HEX_FILE=$3
    local WALLET_PORT=$4

    local OUTPUTS_BIN="$OUTDIR/outputs.bin"
    local KEY_IMAGES_OUT="$OUTDIR/key_images.bin"
    local ID_PART="${HEX_FILE#unsigned_tx_}"
    local SIGNED_TX_OUT="$OUTDIR/signed_tx_${ID_PART}"

    log "Starting RPC for wallet: $REAL_WALLET on Port $WALLET_PORT"
    start_rpc "$REAL_WALLET" "$WALLET_PORT"

    # 1. Import outputs (binary -> hex)
    if [ -f "$OUTPUTS_BIN" ]; then
        local OUT_HEX
        OUT_HEX=$(od -An -v -tx1 "$OUTPUTS_BIN" | tr -d '\n\r ')

        curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
            -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"import_outputs\",\"params\":{\"outputs_data_hex\":\"$OUT_HEX\"}}" \
            >> "$LOG_FILE"
    else
        log "WARNING: outputs.bin missing, attempting signing with cached state..."
    fi

    # 2. Load unsigned tx hex
    local TXSET_HEX
    TXSET_HEX=$(tr -d '\n\r ' < "$OUTDIR/$HEX_FILE")

    curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
        -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"sign_transfer\",\"params\":{\"unsigned_txset\":\"$TXSET_HEX\"}}" \
        > "$OUTDIR/signed_resp.json"

    local SIGNED_HEX
    SIGNED_HEX=$(sed -n 's/.*"signed_txset":[[:space:]]*"\([^"]*\)".*/\1/p' "$OUTDIR/signed_resp.json")

    if [ -n "$SIGNED_HEX" ]; then
        hex_to_bin_file "$SIGNED_HEX" "$SIGNED_TX_OUT"
        log "Signed tx written: $SIGNED_TX_OUT"
    else
        log "ERROR: sign_transfer failed — keeping unsigned tx hex"
        stop_rpc "$WALLET_PORT"
        return
    fi

    # 3. Corrected Key Image Export (API Compliant)
    curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"export_key_images","params":{"all_keys":true}}' \
        > "$OUTDIR/ki_resp.json"

    local CLEAN_KI_JSON
    CLEAN_KI_JSON=$(tr -d '\n\r ' < "$OUTDIR/ki_resp.json")
    
    if echo "$CLEAN_KI_JSON" | grep -q '"result":'; then
        local KI_HEX
        KI_HEX=$(echo "$CLEAN_KI_JSON" | grep -oP '"key_images":.*?,"offset":.*?' | grep -oP '"offset":\K[a-f0-9]+')
        [ -z "$KI_HEX" ] && KI_HEX=$(echo "$CLEAN_KI_JSON" | grep -oP '"key_images":\[\{.*?"key_image":"\K[a-f0-9]{64}')
        [ -z "$KI_HEX" ] && KI_HEX=$(echo "$CLEAN_KI_JSON" | grep -oP '"signed_key_images_blob":"\K[a-f0-9]+')

        if [ -n "$KI_HEX" ]; then
            hex_to_bin_file "$KI_HEX" "$KEY_IMAGES_OUT"
            log "Valid key_images.bin compiled successfully."
        else
            cp "$OUTDIR/ki_resp.json" "$KEY_IMAGES_OUT"
            log "Key images saved as raw JSON payload structure."
        fi
    else
        log "ERROR: Key image export failed entirely."
    fi

    # 4. HARDENED SAFE CLEANUP OF ARTIFACTS
    if [ -s "$SIGNED_TX_OUT" ] && [ -s "$KEY_IMAGES_OUT" ] && ! echo "$CLEAN_KI_JSON" | grep -q '"error"'; then
        rm -f "$OUTDIR/$HEX_FILE"
        log "Deleted unsigned tx hex: $HEX_FILE"
    else
        log "CRITICAL: Missing valid signed tx or key images data — PRESERVING unsigned tx hex"
        rm -f "$KEY_IMAGES_OUT"
    fi

    # 5. DIRECTORY SNAPSHOT
    echo "--------------------------------------------------"
    echo "Current file status for wallet folder: $SUB_DIR"
    ls -l "$OUTDIR"
    echo "--------------------------------------------------"
    
    log "Folder state for $SUB_DIR:"
    ls -l "$OUTDIR" >> "$LOG_FILE"

    stop_rpc "$WALLET_PORT"
    rm -f "$OUTDIR/signed_resp.json" "$OUTDIR/ki_resp.json"
}

# Loop over the found items
for HEX_PATH in $UNSIGNED_LIST; do
    SUB_DIR=$(basename "$(dirname "$HEX_PATH")")
    OUTDIR="$WATCH_DIR/$SUB_DIR"
    REAL_WALLET="$VAULT_DIR/$SUB_DIR/wallet"
    HEX_FILE=$(basename "$HEX_PATH")
    PORT_FILE="${OUTDIR}/rpc_port.cfg"

    # Verify this specific directory has an active port layout configured
    if [ ! -f "$PORT_FILE" ]; then
        log "ERROR: $HEX_FILE ($SUB_DIR) - No rpc_port.cfg found. Skipping."
        echo "[FAILED] $HEX_FILE ($SUB_DIR) - No rpc_port.cfg found"
        continue
    fi

    RPC_PORT=$(cat "$PORT_FILE" | tr -d '\n\r ')

    log "Processing $HEX_FILE for $SUB_DIR on Port $RPC_PORT"
    sign_tx_rpc "$OUTDIR" "$REAL_WALLET" "$HEX_FILE" "$RPC_PORT"
done

log "--- RPC Signing Session Complete ---"