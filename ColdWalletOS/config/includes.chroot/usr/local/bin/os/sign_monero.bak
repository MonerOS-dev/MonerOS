#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_monero"
VAULT_DIR="/mnt/vault/monero"
PASS_FILE="/mnt/vault/config/password.cfg"
LOG_FILE="/tmp/logs/sign_monero_rpc.log"

# --- YOUR STYLE ---
export TERM=linux
if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8"
    echo -ne "\e]P7ffffff"
    clear
fi

export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

mkdir -p "$(dirname "$LOG_FILE")"

# Ensure jq is installed
if ! command -v jq &> /dev/null; then
    echo "[$(date '+%F %T')] ERROR: 'jq' is required but not installed." >> "$LOG_FILE"
    exit 1
fi

PASSWORD=$(tr -d '\n\r ' < "$PASS_FILE")
log() { echo "[$(date '+%F %T')] $1" >> "$LOG_FILE"; }

UNSIGNED_LIST=($(find "$WATCH_DIR" -type f -name "unsigned_tx_*"))
[ -z "$UNSIGNED_LIST" ] && exit 0
TOTAL_FILES=${#UNSIGNED_LIST[@]}
CURRENT_COUNT=0

start_rpc() {
    local WALLET_PATH=$1
    local TARGET_PORT=$2

    monero-wallet-rpc \
        --wallet-file "$WALLET_PATH" \
        --password "$PASSWORD" \
        --rpc-bind-port "$TARGET_PORT" \
        --rpc-bind-ip 127.0.0.1 \
        --disable-rpc-login \
        --offline \
        --daemon-address "" \
        --log-file /tmp/wallet-rpc.log \
        --detach >/dev/null 2>&1

    until curl -s http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"get_version"}' >/dev/null; do
        sleep 0.5
    done
}

stop_rpc() {
    local TARGET_PORT=$1
    curl -s -X POST http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"stop_wallet"}' >/dev/null 2>&1
}

sign_tx_rpc() {
    local OUTDIR=$1
    local REAL_WALLET=$2
    local HEX_FILE=$3
    local WALLET_PORT=$4

    local OUTPUTS_HEX="$OUTDIR/outputs.hex"
    local KEY_IMAGES_OUT="$OUTDIR/key_images.json"
    local ID_PART="${HEX_FILE#unsigned_tx_}"
    local SIGNED_TX_OUT="$OUTDIR/signed_tx_${ID_PART}"

    log "Starting RPC for wallet: $REAL_WALLET on Port $WALLET_PORT"
    start_rpc "$REAL_WALLET" "$WALLET_PORT"

    # 1. Import outputs.hex (RPC format)
    if [ -f "$OUTPUTS_HEX" ]; then
        log "Found outputs.hex, importing to cold wallet..."
        local OUT_HEX
        OUT_HEX=$(tr -d '\n\r ' < "$OUTPUTS_HEX")

        curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
            -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"import_outputs\",\"params\":{\"outputs_data_hex\":\"$OUT_HEX\"}}" >> "$LOG_FILE" 2>&1
    else
        log "WARNING: outputs.hex missing — cold wallet may be out of sync."
    fi

    # 2. Load and sign unsigned TX hex
    local TXSET_HEX
    TXSET_HEX=$(tr -d '\n\r ' < "$OUTDIR/$HEX_FILE")

    curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
        -d "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"sign_transfer\",\"params\":{\"unsigned_txset\":\"$TXSET_HEX\"}}" > "$OUTDIR/signed_resp.json" 2>/dev/null

    local SIGNED_HEX
    SIGNED_HEX=$(jq -r '.result.signed_txset // empty' "$OUTDIR/signed_resp.json")

    if [ -n "$SIGNED_HEX" ]; then
        printf '%b' "$(echo "$SIGNED_HEX" | sed 's/../\\x&/g')" > "$SIGNED_TX_OUT"
        log "Signed tx written: $SIGNED_TX_OUT"
    else
        log "ERROR: sign_transfer failed — keeping unsigned tx"
        stop_rpc "$WALLET_PORT"
        return
    fi

    # 3. Export key images (RPC JSON format)
    curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"export_key_images","params":{"all":true}}' > "$OUTDIR/ki_resp.json" 2>/dev/null

    if jq -e '.result.signed_key_images' "$OUTDIR/ki_resp.json" >/dev/null 2>&1; then
        jq '.result' "$OUTDIR/ki_resp.json" > "$KEY_IMAGES_OUT"
        log "Valid key_images.json exported successfully."
    else
        log "ERROR: Key image export failed."
        jq '.error // .' "$OUTDIR/ki_resp.json" >> "$LOG_FILE"
    fi

    # 4. Cleanup
    if [ -s "$SIGNED_TX_OUT" ] && [ -s "$KEY_IMAGES_OUT" ]; then
        rm -f "$OUTDIR/$HEX_FILE"
        log "Deleted processed unsigned tx."
    else
        log "CRITICAL: Missing signed tx or key images — preserving unsigned tx."
    fi

    stop_rpc "$WALLET_PORT"
    rm -f "$OUTDIR/signed_resp.json" "$OUTDIR/ki_resp.json"
}

# --- Loop over unsigned transactions ---
{
    for HEX_PATH in "${UNSIGNED_LIST[@]}"; do
        SUB_DIR=$(basename "$(dirname "$HEX_PATH")")
        OUTDIR="$WATCH_DIR/$SUB_DIR"
        REAL_WALLET="$VAULT_DIR/$SUB_DIR/wallet"
        HEX_FILE=$(basename "$HEX_PATH")
        PORT_FILE="${OUTDIR}/rpc_port.cfg"

        if [ ! -f "$PORT_FILE" ]; then
            log "ERROR: $HEX_FILE ($SUB_DIR) - No rpc_port.cfg found. Skipping."
            continue
        fi

        PERCENT=$(( (CURRENT_COUNT * 100) / TOTAL_FILES ))
        echo "XXX"
        echo "$PERCENT"
        echo "Signing: $SUB_DIR"
        echo "XXX"

        RPC_PORT=$(tr -d '\n\r ' < "$PORT_FILE")
        log "Processing $HEX_FILE for $SUB_DIR on Port $RPC_PORT"
        sign_tx_rpc "$OUTDIR" "$REAL_WALLET" "$HEX_FILE" "$RPC_PORT"

        CURRENT_COUNT=$((CURRENT_COUNT + 1))
    done

    echo "XXX"
    echo "100"
    echo "Signing Complete"
    echo "XXX"
} | whiptail --title " RPC Transaction Signing " --gauge "Starting..." 6 50 0

log "--- RPC Signing Session Complete ---"