#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_monero"
VAULT_DIR="/mnt/vault/monero"
PASS_FILE="/mnt/vault/config/password.cfg"
LOG_FILE="/tmp/logs/sync_monero_rpc.log"

mkdir -p "$(dirname "$LOG_FILE")"

# Verify 'jq' is present for reliable JSON payload generation
if ! command -v jq &> /dev/null; then
    echo "[$(date '+%F %T')] ERROR: 'jq' tool is required but not installed." >> "$LOG_FILE"
    exit 1
fi

PASSWORD=$(tr -d '\n\r ' < "$PASS_FILE")
log() { echo "[$(date '+%F %T')] $1" >> "$LOG_FILE"; }

start_rpc() {
    local WALLET_PATH=$1
    local TARGET_PORT=$2

    monero-wallet-rpc \
        --wallet-file "$WALLET_PATH" \
        --password "$PASSWORD" \
        --rpc-bind-port "$TARGET_PORT" \
        --rpc-bind-ip 127.0.0.1 \
        --disable-rpc-login \
        --offline \
        --daemon-address "" \
        --log-file /tmp/wallet-sync-rpc.log \
        --detach

    until curl -s http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"get_version"}' >/dev/null; do
        sleep 0.5
    done
}

stop_rpc() {
    local TARGET_PORT=$1
    curl -s -X POST http://127.0.0.1:"$TARGET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"stop_wallet"}' >/dev/null 2>&1
}

sync_wallet_state() {
    local OUTDIR=$1
    local REAL_WALLET=$2
    local WALLET_PORT=$3

    local OUTPUTS_HEX="$OUTDIR/outputs.hex"
    local KEY_IMAGES_OUT="$OUTDIR/key_images.json"

    log "Starting RPC for synchronization: $REAL_WALLET on Port $WALLET_PORT"
    start_rpc "$REAL_WALLET" "$WALLET_PORT"

    # --- 1. IMPORT OUTPUTS FROM HOT WALLET (VIA RAW HEX PARAMETER) ---
    if [ -f "$OUTPUTS_HEX" ]; then
        log "Found $OUTPUTS_HEX. Importing outputs via raw hex RPC parameter..."
        
        local OUT_HEX
        OUT_HEX=$(tr -d '\n\r ' < "$OUTPUTS_HEX")

        jq -n --arg hex "$OUT_HEX" \
          '{"jsonrpc":"2.0","id":"0","method":"import_outputs","params":{"outputs_data_hex":$hex}}' \
          > "$OUTDIR/.cold_payload.json"

        local IMPORT_RESP
        IMPORT_RESP=$(curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
            -H "Content-Type: application/json" \
            -d @"$OUTDIR/.cold_payload.json")
        
        rm -f "$OUTDIR/.cold_payload.json"

        if echo "$IMPORT_RESP" | jq -e '.result' >/dev/null 2>&1; then
            local IMPORTED_COUNT
            IMPORTED_COUNT=$(echo "$IMPORT_RESP" | jq -r '.result.num_imported // "0"')
            log "SUCCESS: Hot wallet outputs processed by cold daemon. Imported items: $IMPORTED_COUNT"
            
            # FORCE BLOCKCHAIN DATA RE-INDEX FLUSH
            curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"store"}' >/dev/null
        else
            log "ERROR: Failed to import outputs. JSON response: $IMPORT_RESP"
        fi
    else
        log "Notice: No outputs.hex found. Skipping output sync step."
    fi

    # --- 2. EXPORT KEY IMAGES FOR HOT WALLET (FORCE UNCONDITIONAL EXPORT) ---
    log "Exporting all key images unconditionally from cold wallet..."
    curl -s -X POST http://127.0.0.1:"$WALLET_PORT"/json_rpc \
        -d '{"jsonrpc":"2.0","id":"0","method":"export_key_images","params":{"all":true}}' > "$OUTDIR/ki_temp.json"
    
    if jq -e '.result.signed_key_images' "$OUTDIR/ki_temp.json" >/dev/null 2>&1; then
        jq '.result' "$OUTDIR/ki_temp.json" > "$KEY_IMAGES_OUT"
        log "SUCCESS: Complete key image structure exported safely to $KEY_IMAGES_OUT"
        rm -f "$OUTPUTS_HEX"
    else
        log "ERROR: Key image export completely failed."
        jq '.error // .' "$OUTDIR/ki_temp.json" >> "$LOG_FILE"
    fi

    rm -f "$OUTDIR/ki_temp.json"
    stop_rpc "$WALLET_PORT"
}

for DIR_PATH in "$WATCH_DIR"/*; do
    [ -d "$DIR_PATH" ] || continue
    SUB_DIR=$(basename "$DIR_PATH")
    PORT_FILE="${DIR_PATH}/rpc_port.cfg"
    REAL_WALLET="$VAULT_DIR/$SUB_DIR/wallet"

    if [ ! -f "$PORT_FILE" ]; then
        continue
    fi

    if [ ! -f "$REAL_WALLET" ]; then
        log "WARNING: Port file exists for $SUB_DIR, but cold wallet file is missing at $REAL_WALLET. Skipping."
        continue
    fi

    RPC_PORT=$(tr -d '\n\r ' < "$PORT_FILE")

    log "----------------------------------------------------"
    log "Processing Sync Loop for: $SUB_DIR (Port: $RPC_PORT)"
    sync_wallet_state "$DIR_PATH" "$REAL_WALLET" "$RPC_PORT"
done

log "--- Cold Wallet Resync Session Complete ---"