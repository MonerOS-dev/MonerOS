#!/bin/bash

# ---------------------------------------------------------
#  UI THEME (Stealth)
# ---------------------------------------------------------
export PATH=$PATH:/usr/sbin:/sbin:/usr/local/bin
export TERM=linux
stty sane

if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8"
    echo -ne "\e]P7ffffff"
    clear
fi

export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# Configuration
WATCH_DIR="/mnt/sallyport/watch_bitcoin"
BASE_DIR="/mnt/vault/bitcoin"
LOG_FILE="/tmp/logs/sign_bitcoin.log"

mkdir -p "$(dirname "$LOG_FILE")"

log() { echo "[$(date '+%F %T')] $1" >> "$LOG_FILE"; }

# Ensure jq is installed
if ! command -v jq &> /dev/null; then
    log "ERROR: 'jq' is required but not installed."
    exit 1
fi

UNSIGNED_LIST=($(find "$WATCH_DIR" -type f -name "unsigned_tx_*.psbt"))
[ ${#UNSIGNED_LIST[@]} -eq 0 ] && exit 0

TOTAL_FILES=${#UNSIGNED_LIST[@]}
CURRENT_COUNT=0

for TX_PATH in "${UNSIGNED_LIST[@]}"; do
    SUB_DIR=$(basename "$(dirname "$TX_PATH")")
    OUTDIR="$WATCH_DIR/$SUB_DIR"
    WALLET_PATH="$BASE_DIR/$SUB_DIR/wallet"
    UNSIGNED_FILE=$(basename "$TX_PATH")
    
    ID_PART="${UNSIGNED_FILE#unsigned_tx_}"
    ID_PART="${ID_PART%.psbt}"
    
    RECORD_FILE="$OUTDIR/unsigned_record_${ID_PART}"
    SIGNED_RECORD_FILE="$OUTDIR/signed_record_${ID_PART}"
    SIGNED_TX_FINAL="$OUTDIR/signed_tx_${ID_PART}.json"

    # Read record content if it exists, otherwise provide fallback text
    if [ -f "$RECORD_FILE" ]; then
        RECORD_CONTENT=$(cat "$RECORD_FILE")
    else
        RECORD_CONTENT="No record details found for ID: $ID_PART\nAddress: $SUB_DIR"
    fi
    
    # Prompt user with whiptail (Yes = Approve/Sign, No = Deny)
    whiptail --title " Review Bitcoin Transaction " \
             --fb \
             --yes-button "Approve" \
             --no-button "Deny" \
             --yesno "$RECORD_CONTENT" 14 50
    CHOICE=$?

    if [ $CHOICE -eq 1 ]; then
        # User selected 'Deny' (No)
        log "User chose to DENY/DELETE transaction $ID_PART for $SUB_DIR"
        rm -f "$TX_PATH" "$RECORD_FILE"
        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        continue
    fi

    # User selected 'Approve' (Yes)
    log "Processing and signing $UNSIGNED_FILE for $SUB_DIR"

    if [ ! -f "$WALLET_PATH" ]; then
        log "ERROR: Wallet file not found for address $SUB_DIR"
        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        continue
    fi


    # Read PSBT contents
    PSBT_CONTENT=$(tr -d '\n\r ' < "$TX_PATH")

    TMP_OUT="/tmp/electrum_out_$$"
    
    # Run expect with hidden logging, forcing the Enter key automatically
    expect -c "
        log_user 0
        spawn electrum --offline -w \"$WALLET_PATH\" signtransaction \"$PSBT_CONTENT\"
        expect {
            \"Password:\" {
                send \"\r\"
                exp_continue
            }
            eof
        }
        # Write clean output directly to file
        set fd [open \"$TMP_OUT\" w]
        puts -nonewline \$fd \$expect_out(buffer)
        close \$fd
    " 2>> "$LOG_FILE"

    # Read back the clean output and cleanup
    SIGNED_OUT=$(cat "$TMP_OUT")
    rm -f "$TMP_OUT"

    # --- MAKE SURE THIS IF CHECK IS PRESENT ---
    if [ -n "$SIGNED_OUT" ] && [[ "$SIGNED_OUT" != *"error"* ]]; then
        FINAL_HEX=$(python3 -c "
import json
raw_output = '''$SIGNED_OUT'''.strip()
hex_val = ''

try:
    data = json.loads(raw_output)
    hex_val = data.get('complete_hex', data.get('hex', ''))
except Exception:
    hex_val = raw_output

# Clean up leading/trailing whitespace, newlines, and quotes
hex_val = hex_val.strip('\r\n \"\'')

print(hex_val)
" 2>/dev/null)

        if [ -z "$FINAL_HEX" ]; then
            FINAL_HEX="$SIGNED_OUT"
        fi

        cat <<EOF > "$SIGNED_TX_FINAL"
{
  "hex": "$FINAL_HEX",
  "address": "$SUB_DIR",
  "complete": true
}
EOF
        rm -f "$TX_PATH"
        if [ -f "$RECORD_FILE" ]; then
            mv "$RECORD_FILE" "$SIGNED_RECORD_FILE"
            log "Renamed record to signed_record_${ID_PART}"
        fi
        log "SUCCESS: Signed PSBT for $SUB_DIR"
    else
        log "ERROR: Failed to sign $SUB_DIR via Electrum"
    fi

    CURRENT_COUNT=$((CURRENT_COUNT + 1))
done

log "--- Bitcoin Signing Session Complete ---"