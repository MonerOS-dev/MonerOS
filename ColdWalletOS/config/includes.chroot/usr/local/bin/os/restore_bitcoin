#!/bin/bash

# ---------------------------------------------------------
#  UI THEME (Stealth)
# ---------------------------------------------------------
export PATH=$PATH:/usr/sbin:/sbin:/usr/local/bin
export TERM=linux
stty sane

if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8"; echo -ne "\e]P7ffffff"; clear
fi

export NEWT_COLORS='
  root=black,black; window=blue,black; shadow=black,black
  border=blue,black; title=blue,black; textbox=white,black
  label=white,black; listbox=white,black; actlistbox=black,blue
  button=white,black; actbutton=black,white; entry=white,black'

# ---------------------------------------------------------
#  CONFIG
# ---------------------------------------------------------
BASE_DIR="/mnt/vault/bitcoin"
TEMP_WALLET="/tmp/electrum_temp_$$"
ADDR_FILE="/tmp/btc_addr_$$"

mkdir -p "$BASE_DIR"

# 1. COLLECT SEED WORDS (1-12 for Electrum)
MNEMONIC_ARRAY=()
for i in {1..12}; do
    WORD=$(whiptail --title "Restore Wallet (Word $i/12)" --fb --inputbox "\nEnter word $i:" 10 50 3>&1 1>&2 2>&3)
    
    # If the user hits Cancel, return to main menu
    if [ $? -ne 0 ]; then
        /usr/local/bin/os/main_menu
        exit 0
    fi
    MNEMONIC_ARRAY+=("$WORD")
done
MNEMONIC=$(IFS=' '; echo "${MNEMONIC_ARRAY[*]}")

# 2. COLLECT RESTORE DATE
while :; do
    RESTORE_DATE=$(whiptail --title "Set Restore Date" \
        --fb --inputbox "\nEnter restore date (YYYY-MM-DD):" 10 50 "" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ]; then
        /usr/local/bin/os/main_menu
        exit 0
    fi

    if [[ $RESTORE_DATE =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        break
    else
        whiptail --msgbox "Invalid format. Use YYYY-MM-DD." 8 50
    fi
done

sleep 1

# 3. Restore and Verify via Python + Electrum CLI
RESTORE_SUCCESS=false
ADDR=""

python3 -c "
import subprocess
seed = '$MNEMONIC'
wallet_path = '$TEMP_WALLET'
try:
    # Electrum restore command via interactive stdin pipe
    p = subprocess.Popen(['electrum', '--offline', '-w', wallet_path, 'restore', seed],
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    p.communicate(input=b'\n\n') # Feed empty line for password / options if prompted
except Exception:
    pass
" 2>/dev/null

# Extract address and master public key to confirm restoration succeeded
if [ -f "$TEMP_WALLET" ]; then
    ADDR=$(python3 -c "
import subprocess, json
try:
    res = subprocess.check_output(['electrum', '-o', '-w', '$TEMP_WALLET', 'listaddresses'])
    addrs = json.loads(res.decode())
    print(addrs[0] if addrs else '')
except Exception:
    print('')
" 2>/dev/null)

    ZPUB=$(python3 -c "
import json
try:
    with open('$TEMP_WALLET', 'r') as f:
        data = json.load(f)
        keystore = data.get('keystore', {})
        zpub = keystore.get('zpub', '') or keystore.get('xpub', '') or keystore.get('ypub', '')
        print(zpub)
except Exception:
    print('')
" 2>/dev/null)
fi

if [ -n "$ADDR" ]; then
    RESTORE_SUCCESS=true
fi

# Handle Failure / Retry Loop
if [ "$RESTORE_SUCCESS" = false ]; then
    rm -rf "$TEMP_WALLET"
    sync
    
    whiptail --title "RESTORE FAILED" --yesno \
"\nWallet restoration failed.\n\nWould you like to retry the process?" 10 50 \
--fb --yes-button "Retry" --no-button "Cancel"
    
    if [ $? -eq 0 ]; then
        exec /usr/local/bin/os/restore_bitcoin
    else
        /usr/local/bin/os/main_menu
        exit 0
    fi
fi

# 4. PARSE & MOVE
WALLET_DIR="$BASE_DIR/$ADDR"
mkdir -p "$WALLET_DIR"
mv "$TEMP_WALLET" "$WALLET_DIR/wallet"

{
    echo "ADDRESS: $ADDR"
    echo "ZPUB: $ZPUB"
    echo "RESTORE_DATE: $RESTORE_DATE"
} > "$WALLET_DIR/watch_info.txt"

# Save watch info for Sallyport
WATCH_BASE="/mnt/sallyport/watch_bitcoin/$ADDR"
mkdir -p "$WATCH_BASE"
cp "$WALLET_DIR/watch_info.txt" "$WATCH_BASE/watch_info.txt"

sync

whiptail --title "Bitcoin Wallet Restored" \
         --msgbox "\nYour Bitcoin wallet has been restored.\n\nAddress:\n$ADDR" 0 0

/usr/local/bin/os/main_menu