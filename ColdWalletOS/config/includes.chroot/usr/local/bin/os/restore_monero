#!/bin/bash

# ---------------------------------------------------------
#  UI THEME (Stealth)
# ---------------------------------------------------------
export PATH=$PATH:/usr/sbin:/sbin
export TERM=linux
stty sane

if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8"; echo -ne "\e]P7ffffff"; clear
fi

export NEWT_COLORS='
  root=black,black; window=blue,black; shadow=black,black
  border=blue,black; title=blue,black; textbox=white,black
  label=white,black; listbox=white,black; actlistbox=black,blue
  button=white,black; actbutton=black,white; entry=white,black'

# ---------------------------------------------------------
#  CONFIG
# ---------------------------------------------------------
WALLET_DIR="/mnt/vault/monero"
TEMP_NAME="vault_temp"
PASS_FILE="/mnt/vault/config/password.cfg"
PASSWORD=$(tr -d '\n' < "$PASS_FILE")
LOG_FILE="$WALLET_DIR/${TEMP_NAME}.log"

mkdir -p "$WALLET_DIR"
rm -f "$LOG_FILE" && touch "$LOG_FILE"

# 1. COLLECT SEED WORDS (1-24)
MNEMONIC_ARRAY=()
for i in {1..24}; do
    WORD=$(whiptail --title "Restore Wallet (Word $i/24)" --fb --inputbox "\nEnter word $i:" 10 50 3>&1 1>&2 2>&3)
    
    # If the user hits Cancel (Exit status 1), return to main menu
    if [ $? -ne 0 ]; then
        /usr/local/bin/os/main_menu
        exit 0
    fi
    MNEMONIC_ARRAY+=("$WORD")
done
MNEMONIC=$(IFS=' '; echo "${MNEMONIC_ARRAY[*]}")

# 2. COLLECT RESTORE DATE
while :; do
    RESTORE_DATE=$(whiptail --title "Set Restore Date" \
        --fb --inputbox "\nEnter restore date (YYYY-MM-DD):" 10 50 "" 3>&1 1>&2 2>&3)
    
    # If the user hits Cancel (Exit status 1), return to main menu
    if [ $? -ne 0 ]; then
        /usr/local/bin/os/main_menu
        exit 0
    fi

    # Validate format
    if [[ $RESTORE_DATE =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        break
    else
        whiptail --msgbox "Invalid format. Use YYYY-MM-DD." 8 50
    fi
done

sleep 1

# 3. Restore and Verify
# We capture the initialization output directly into a variable
RESTORE_OUT=$(expect <<EOF
    log_file "$LOG_FILE"
    set timeout 60
    spawn -noecho /usr/local/bin/monero-wallet-cli \
        --restore-deterministic-wallet "$WALLET_DIR/$TEMP_NAME" \
        --password "$PASSWORD" \
        --daemon-address 127.0.0.1:0 \
        --offline \
        --create-address-file

    expect "Wallet file name"
    send -- "$WALLET_DIR/$TEMP_NAME\r"
    expect "Specify Electrum seed"
    send -- "$MNEMONIC\r"
    expect "Enter seed offset passphrase"
    send -- "\r"
    expect "Restore from specific blockchain height"
    send -- "0\r"
    expect "If you are new to Monero"
    send -- "exit\r"
    expect eof
EOF
)

# Extract the view key directly from the captured output
VIEW_KEY=$(echo "$RESTORE_OUT" | awk -F': ' '/^View key:/ {print $2}' | tr -d '[:space:]')

# Extract the seed block: Everything between the NOTE line and the trailing asterisks
# This waits for the wallet to finish writing its final state
sleep 3 

# Improved robust extraction - extracts up to 24 words to match the input format length
ACTUAL_SEED=$(grep -oE '\b[a-z]{3,}\b' "$LOG_FILE" | grep -A 25 "edgy" | head -n 24 | tr '\n' ' ' | xargs)

# Normalize inputs for comparison
INPUT_CLEAN=$(echo $MNEMONIC | xargs)
RETURNED_CLEAN=$(echo $ACTUAL_SEED | xargs)

# Compare input 24 words with the extracted 24 words
if [ "$INPUT_CLEAN" != "$RETURNED_CLEAN" ]; then
    # Cleanup
    rm -rf "$WALLET_DIR/$TEMP_NAME"*
    rm -f "$LOG_FILE"
    sync
    
    # FAILED: Present choice instead of just showing the log
    whiptail --title "RESTORE FAILED" --yesno \
"\nWallet restoration failed.\n\nWould you like to retry the process?" 10 50 \
--fb --yes-button "Retry" --no-button "Cancel"
    
    # Capture the choice
    if [ $? -eq 0 ]; then
        # User selected Retry
        exec /usr/local/bin/os/restore_monero
    else
        # User selected Cancel
        /usr/local/bin/os/main_menu
        exit 0
    fi
fi

# 4. PARSE & MOVE
# Look for the address in the generated address file (or the log as before)
if [ -f "$WALLET_DIR/${TEMP_NAME}.address.txt" ]; then
    ADDR=$(tr -d '[:space:]' < "$WALLET_DIR/${TEMP_NAME}.address.txt")
fi

if [ -n "$ADDR" ] && [ -n "$VIEW_KEY" ]; then
    mkdir -p "$WALLET_DIR/$ADDR"
    mv "$WALLET_DIR/$TEMP_NAME"       "$WALLET_DIR/$ADDR/wallet"     2>/dev/null
    mv "$WALLET_DIR/$TEMP_NAME.keys"  "$WALLET_DIR/$ADDR/wallet.keys" 2>/dev/null
    mv "$LOG_FILE"                    "$WALLET_DIR/$ADDR/wallet.log"  2>/dev/null
    rm -f "$WALLET_DIR/${TEMP_NAME}.address.txt"

    # Save watch info
    WATCH_BASE="/mnt/sallyport/watch_monero/$ADDR"
    mkdir -p "$WATCH_BASE"
    
    {
        echo "ADDRESS: $ADDR"
        echo "VIEW_KEY: $VIEW_KEY"
        echo "RESTORE_DATE: $RESTORE_DATE"
        echo "TYPE: watch-only"
    } > "$WATCH_BASE/watch_info.txt"
    
    cp "$WATCH_BASE/watch_info.txt" "$WALLET_DIR/$ADDR/watch_info.txt"
    
    sync
    whiptail --title "Monero Wallet Restored" \
             --msgbox "\nYour Monero wallet has been restored.\n\nAddress:\n$ADDR" 0 0
else
    # FAILED: Present choice instead of just showing the log
    whiptail --title "RESTORE FAILED" --yesno \
"\nWallet restoration failed.\n\nWould you like to retry the process?" 10 50 \
--fb --yes-button "Retry" --no-button "Cancel"
    
    # Capture the choice
    if [ $? -eq 0 ]; then
        # User selected Retry
        exec /usr/local/bin/os/restore_monero
    else
        # User selected Cancel
        /usr/local/bin/os/main_menu
        exit 0
    fi
fi

/usr/local/bin/os/main_menu