#!/bin/bash

# --- UI THEME (Stealth) ---
export PATH=$PATH:/usr/sbin:/sbin:/usr/local/bin
export TERM=linux
stty sane

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8" # Color 4 (Blue) -> Cyan
    echo -ne "\e]P7ffffff" # Color 7 (Lightgray) -> Pure White
    clear
fi

# 2. ASSIGN NEWT COLORS
# window = black (Dark Gray)
# border/title/text = blue (Cyan)
# button = white (fg) on black (bg)
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# Configuration
WATCH_DIR="/mnt/sallyport/watch_dogecoin"
VAULT_DIR="/mnt/vault/dogecoin"
LOG_FILE="/tmp/logs/sign_doge.log"

mkdir -p "$(dirname "$LOG_FILE")"
log_msg() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

# 1. Find unsigned transactions
UNSIGNED_LIST=$(find "$WATCH_DIR" -type f -name "unsigned_doge_*.json")
if [ -z "$UNSIGNED_LIST" ]; then
    exit 0
fi

TOTAL_FILES=$(echo "$UNSIGNED_LIST" | wc -l)
CURRENT_COUNT=0

# --- THE SIGNING LOOP ---
{
    export NEWT_COLORS
    for TX_PATH in $UNSIGNED_LIST; do
        DOGE_ADDRESS=$(basename "$(dirname "$TX_PATH")")
        UNSIGNED_FILE=$(basename "$TX_PATH")
        ID_PART=$(echo "$UNSIGNED_FILE" | sed 's/unsigned_doge_//')
        OUTDIR="$(dirname "$TX_PATH")"
        SIGNED_TX_FINAL="$OUTDIR/signed_doge_$ID_PART"

        echo "XXX"
        echo $(( (CURRENT_COUNT * 100) / TOTAL_FILES ))
        echo ""
        echo "XXX"

        # 2. ISOLATED DAEMON PER TRANSACTION
        TEMP_DATA="/tmp/doge_sig_$DOGE_ADDRESS"
        rm -rf "$TEMP_DATA" && mkdir -p "$TEMP_DATA"
        
        # Force as default wallet
        cp "$VAULT_DIR/$DOGE_ADDRESS/wallet.dat" "$TEMP_DATA/wallet.dat"

        dogecoind -datadir="$TEMP_DATA" -daemon -connect=0 -listen=0 -dnsseed=0 >/dev/null 2>&1
        
        # Wait for RPC readiness
        until dogecoin-cli -datadir="$TEMP_DATA" getwalletinfo >/dev/null 2>&1; do sleep 1; done

        # 3. Parse Manifest
        export TX_PATH
        PARSED_DATA=$(python3 -c "
import json, os
try:
    with open(os.environ['TX_PATH'], 'r') as f:
        data = json.load(f)
        ins = [{'txid': i['txid'], 'vout': i['vout']} for i in data['inputs']]
        outs = {o['address']: round(float(o['value'])/100000000, 8) for o in data['outputs']}
        scripts = [{'txid': i['txid'], 'vout': i['vout'], 'scriptPubKey': i['script']} for i in data['inputs']]
        print(json.dumps(ins) + '|' + json.dumps(outs) + '|' + json.dumps(scripts))
except Exception as e:
    print('PY_ERR:' + str(e))
")

        RAW_INPUTS=$(echo "$PARSED_DATA" | cut -d'|' -f1)
        RAW_OUTPUTS=$(echo "$PARSED_DATA" | cut -d'|' -f2)
        PREV_SCRIPTS=$(echo "$PARSED_DATA" | cut -d'|' -f3)

        # 4. Sign
        RAW_HEX=$(dogecoin-cli -datadir="$TEMP_DATA" createrawtransaction "$RAW_INPUTS" "$RAW_OUTPUTS")
        SIGNED_JSON=$(dogecoin-cli -datadir="$TEMP_DATA" signrawtransaction "$RAW_HEX" "$PREV_SCRIPTS")
        
        RESULT_PARSE=$(echo "$SIGNED_JSON" | python3 -c "
import sys, json
try:
    obj = json.load(sys.stdin)
    print(f\"{obj.get('complete', False)}|{obj.get('hex', '')}\")
except:
    print('False|')
")

        IS_COMPLETE=$(echo "$RESULT_PARSE" | cut -d'|' -f1)
        SIGNED_HEX=$(echo "$RESULT_PARSE" | cut -d'|' -f2)

        if [ "$IS_COMPLETE" == "True" ]; then
            echo "{ \"hex\": \"$SIGNED_HEX\", \"address\": \"$DOGE_ADDRESS\" }" > "$SIGNED_TX_FINAL"
            rm -f "$TX_PATH"
            log_msg "SUCCESS: $DOGE_ADDRESS"
        else
            log_msg "FAILURE: $DOGE_ADDRESS. RPC: $SIGNED_JSON"
        fi

        # 5. Shutdown and Cleanup
        dogecoin-cli -datadir="$TEMP_DATA" stop >/dev/null 2>&1
        sleep 2
        rm -rf "$TEMP_DATA"
        CURRENT_COUNT=$((CURRENT_COUNT + 1))
    done

    echo "XXX"
    echo 100
    echo "DOGE Signing Complete."
    echo "XXX"

} | whiptail --title " Signing Dogecoin Transactions " --gauge "Initializing..." 6 50 0