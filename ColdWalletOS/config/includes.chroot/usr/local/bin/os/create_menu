#!/bin/bash

# Ensure we can find cryptsetup/mount/etc ---
export PATH=$PATH:/usr/sbin:/sbin

export TERM=linux
stty sane

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P459cbe8" # Color 4 (Blue) -> Cyan
    echo -ne "\e]P7ffffff" # Color 7 (Lightgray) -> Pure White
    clear
fi

# 2. ASSIGN NEWT COLORS
# window = black (Dark Gray)
# border/title/text = blue (Cyan)
# button = white (fg) on black (bg)
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

while true; do
    # Arrow keys only - Tag and Description are merged
    OPTION=$(whiptail --title " Create Menu " \
                      --fb \
                      --nocancel \
                      --ok-button "Select" \
                      --menu "\nChoose a crypto..." \
                      16 50 7 \
                      " Bitcoin" "" \
                      " Monero" "" \
                      " Etherium" "" \
                      " Litecoin" "" \
                      " Dogecoin" "" \
                      " Avalanche" "" \
                      " Main Menu" "" \
                      3>&1 1>&2 2>&3)

    case "$OPTION" in
        " Bitcoin") /usr/local/bin/os/create_bitcoin ;;
        " Monero") /usr/local/bin/os/create_monero ;;
        " Etherium") /usr/local/bin/os/create_ethers ;;
        " Litecoin") /usr/local/bin/os/create_litecoin ;;
        " Dogecoin") /usr/local/bin/os/create_dogecoin ;;
        " Avalanche") /usr/local/bin/os/create_avalanche ;;
        " Main Menu") /usr/local/bin/os/main_menu ;;
    esac
done
