echo $txtAddr.Size = New-Object System.Drawing.Size(290, 25) >> "%psScript%"
echo $form.Controls.Add($txtAddr) >> "%psScript%"
echo $lblAmt = New-Object System.Windows.Forms.Label >> "%psScript%"
