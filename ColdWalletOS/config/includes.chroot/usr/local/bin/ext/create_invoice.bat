echo $lblAmt.Size = New-Object System.Drawing.Size(160, 20) >> "%psScript%"
echo $lblAmt.Text = "Payment Amount (BTC/XMR):" >> "%psScript%"
echo $form.Controls.Add($lblAmt) >> "%psScript%"
echo $txtAmt = New-Object System.Windows.Forms.TextBox >> "%psScript%"
echo $txtAmt.Location = New-Object System.Drawing.Point(190, 120) >> "%psScript%"
echo $txtAmt.Size = New-Object System.Drawing.Size(290, 25) >> "%psScript%"
echo $form.Controls.Add($txtAmt) >> "%psScript%"
echo $lblPwd = New-Object System.Windows.Forms.Label >> "%psScript%"
echo $lblPwd.Location = New-Object System.Drawing.Point(20, 170) >> "%psScript%"
echo $lblPwd.Size = New-Object System.Drawing.Size(160, 20) >> "%psScript%"
echo $lblPwd.Text = "Password:" >> "%psScript%"
echo $form.Controls.Add($lblPwd) >> "%psScript%"
echo $txtPwd = New-Object System.Windows.Forms.TextBox >> "%psScript%"
echo $txtPwd.Location = New-Object System.Drawing.Point(190, 170) >> "%psScript%"
echo $txtPwd.Size = New-Object System.Drawing.Size(290, 25) >> "%psScript%"
echo $txtPwd.UseSystemPasswordChar = $true >> "%psScript%"
echo $form.Controls.Add($txtPwd) >> "%psScript%"
echo $btnSub = New-Object System.Windows.Forms.Button >> "%psScript%"
echo $btnSub.Location = New-Object System.Drawing.Point(190, 220) >> "%psScript%"
echo $btnSub.Size = New-Object System.Drawing.Size(290, 35) >> "%psScript%"
echo $btnSub.Text = "Generate Secure Invoice" >> "%psScript%"
echo $form.Controls.Add($btnSub) >> "%psScript%"
echo $form.AcceptButton = $btnSub >> "%psScript%"
echo $global:formData = $null >> "%psScript%"
echo $btnSub.Add_Click({ >> "%psScript%"
echo      if ([string]::IsNullOrWhiteSpace($txtAddr.Text) -or [string]::IsNullOrWhiteSpace($txtAmt.Text) -or [string]::IsNullOrWhiteSpace($txtPwd.Text)) { >> "%psScript%"
echo          [System.Windows.Forms.MessageBox]::Show("Please fill in all fields including the password.", "Validation Error", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error) >> "%psScript%"
echo          return >> "%psScript%"
echo      } >> "%psScript%"
echo      $global:formData = @{ >> "%psScript%"
echo          Currency = $cmbCurr.SelectedItem.ToString() >> "%psScript%"
echo          Address = $txtAddr.Text >> "%psScript%"
echo          Amount = $txtAmt.Text >> "%psScript%"
echo          Password = $txtPwd.Text >> "%psScript%"
echo      } >> "%psScript%"
echo      $form.Close() >> "%psScript%"
echo }) >> "%psScript%"
echo [void]$form.ShowDialog() >> "%psScript%"
echo if ($global:formData) { >> "%psScript%"
echo      $tempDir = Join-Path $env:TEMP ([Guid]::NewGuid().ToString()) >> "%psScript%"
echo      [void](New-Item -ItemType Directory -Path $tempDir) >> "%psScript%"
echo      $jsonPath = Join-Path $tempDir 'invoice.json' >> "%psScript%"
echo      [PSCustomObject]@{ >> "%psScript%"
echo          Currency = $global:formData.Currency >> "%psScript%"
echo          Address = $global:formData.Address >> "%psScript%"
echo          Amount = $global:formData.Amount >> "%psScript%"
echo          Created = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss') >> "%psScript%"
echo      } ^| ConvertTo-Json ^| Set-Content -Path $jsonPath >> "%psScript%"
echo      $timestamp = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() >> "%psScript%"
echo      $invoiceDir = Join-Path (Get-Location) 'invoices' >> "%psScript%"
echo      if (-not (Test-Path $invoiceDir)) { [void](New-Item -ItemType Directory -Path $invoiceDir) } >> "%psScript%"
echo      $outPath = Join-Path $invoiceDir ($timestamp.ToString() + '.enc') >> "%psScript%"
echo      if (Test-Path $outPath) { Remove-Item $outPath } >> "%psScript%"
echo      $bytes = [System.IO.File]::ReadAllBytes($jsonPath) >> "%psScript%"
echo      $salt = New-Object byte[] 16 >> "%psScript%"
echo      [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($salt) >> "%psScript%"
echo      $derive = New-Object System.Security.Cryptography.Rfc2898DeriveBytes($global:formData.Password, $salt, 10000, [System.Security.Cryptography.HashAlgorithmName]::SHA256) >> "%psScript%"
echo      $key = $derive.GetBytes(32) >> "%psScript%"
echo      $iv = $derive.GetBytes(16) >> "%psScript%"
echo      $aes = [System.Security.Cryptography.Aes]::Create() >> "%psScript%"
echo      $aes.Key = $key >> "%psScript%"
echo      $aes.IV = $iv >> "%psScript%"
echo      $encryptor = $aes.CreateEncryptor() >> "%psScript%"
echo      $encryptedBytes = $encryptor.TransformFinalBlock($bytes, 0, $bytes.Length) >> "%psScript%"
echo      $fs = New-Object System.IO.FileStream($outPath, [System.IO.FileMode]::Create) >> "%psScript%"
echo      $fs.Write($salt, 0, 16) >> "%psScript%"
echo      $fs.Write($iv, 0, 16) >> "%psScript%"
echo      $fs.Write($encryptedBytes, 0, $encryptedBytes.Length) >> "%psScript%"
echo      $fs.Close() >> "%psScript%"
echo      Remove-Item -Recurse -Force $tempDir >> "%psScript%"
echo      [System.Windows.Forms.MessageBox]::Show("Encrypted invoice created successfully at: $outPath", "Success", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information) >> "%psScript%"
echo } >> "%psScript%"

powershell -NoProfile -ExecutionPolicy Bypass -File "%psScript%"
del "%psScript%"
endlocal