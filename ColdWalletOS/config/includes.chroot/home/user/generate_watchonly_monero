#!/bin/bash
set -e

# --- Configuration ---
WALLET_DIR="/mnt/vault/monero"
COLD_WALLET="$WALLET_DIR/cold.wallet"
SALLY_DIR="/mnt/sallyport"
WATCH_ONLY="$SALLY_DIR/watch_only.wallet"

mkdir -p "$WALLET_DIR"

if ! mountpoint -q "$SALLY_DIR"; then
    echo "[ColdWalletOS] ERROR: Sally port not mounted."
    exit 1
fi

if [ ! -f "${COLD_WALLET}.keys" ]; then
    echo "----------------------------------------------------------------"
    echo "[ColdWalletOS] NO COLD WALLET FOUND. GENERATING NEW..."
    
    # We increase the capture range to 5 lines to ensure all 25 words are caught
    GEN_OUTPUT=$(echo -e "1\nexit" | timeout 30 monero-wallet-cli --offline --generate-new-wallet "$COLD_WALLET" --password "" || true)
    
    ADDRESS=$(echo "$GEN_OUTPUT" | grep -oE "4[0-9a-zA-Z]{94}")
    # Capturing more lines and stopping before the next section
    SEED=$(echo "$GEN_OUTPUT" | grep -A 5 "the following 25 words")
    VIEW_KEY=$(echo "$GEN_OUTPUT" | grep "View key:" | awk '{print $3}')
    
    echo -e "\n--- !! WRITE THIS DOWN (ENSURE 25 WORDS) !! ---"
    echo "$SEED"
    echo "----------------------------------------------------------------"
    echo "ADDRESS: $ADDRESS"
else
    echo "----------------------------------------------------------------"
    echo "[ColdWalletOS] COLD WALLET DETECTED. RETRIEVING ADDRESS..."
    
    RETRIEVAL=$(echo -e "N\naddress\nviewkey\nexit" | stdbuf -oL timeout 15 monero-wallet-cli --offline --untrusted-daemon --wallet-file "$COLD_WALLET" --password "" || true)
    
    ADDRESS=$(echo "$RETRIEVAL" | grep -oE "4[0-9a-zA-Z]{94}" | head -n 1)
    VIEW_KEY=$(echo "$RETRIEVAL" | grep "View key:" | awk '{print $3}')
    
    echo "ADDRESS: $ADDRESS"
fi

# Handle Watch-Only Silently
if [ ! -f "${WATCH_ONLY}.keys" ]; then
    echo -e "1\n$ADDRESS\n$VIEW_KEY\n0\nexit" | timeout 30 monero-wallet-cli --offline \
        --generate-from-view-key "$WATCH_ONLY" \
        --password "" > /dev/null 2>&1 || true
fi

echo "----------------------------------------------------------------"