#!/bin/bash

# --- 0. SECURITY TRAP ---
cleanup() {
    unset VAULT_PASS
    # Clean up any lingering temp mounts from the scan phases
    for mnt in /tmp/tmp.*; do
        if mountpoint -q "$mnt"; then
            sudo umount -l "$mnt" 2>/dev/null
            rmdir "$mnt" 2>/dev/null
        fi
    done
    #echo -e "\n\ní ¾í·¹ Security Scrub: Password wiped from memory."
}
trap cleanup EXIT

# --- 1. INTERNAL VAULT (Same Disk as OS) ---
LIVE_DEV=$(findmnt -n -o SOURCE /run/live/medium)
PARENT_DISK=$(lsblk -no PKNAME "$LIVE_DEV" | head -n 1)
TARGET="/dev/${PARENT_DISK}3"
[[ "$PARENT_DISK" == nvme* ]] && TARGET="/dev/${PARENT_DISK}p3"

MOUNT_POINT="/mnt/vault"
MAPPER_NAME="cwos_unlocked"
CFG_FILE="$MOUNT_POINT/sallyport.cfg"

if mountpoint -q "$MOUNT_POINT"; then
    echo "âœ… INTERNAL VAULT MOUNTED"
    echo -n "Enter Vault Password: "; read -r -s VAULT_PASS; echo ""
else
    if sudo cryptsetup isLuks "$TARGET" 2>/dev/null; then
        echo -n "Enter Password: "; read -r -s VAULT_PASS; echo ""
        if ! sudo cryptsetup open "$TARGET" "$MAPPER_NAME" -d - <<< "$VAULT_PASS"; then
            echo "âŒ Incorrect password."; exit 1
        fi
    else
        echo "--- Initializing Internal Vault on $TARGET ---"
        read -r -s -p "Choose a passwordt: " VAULT_PASS; echo ""
        read -r -s -p "Confirm password: " VAULT_PASS2; echo ""
        [ "$VAULT_PASS" != "$VAULT_PASS2" ] && { echo "âŒ Mismatch."; exit 1; }
        
        sudo cryptsetup luksFormat --type luks2 "$TARGET" -d - <<< "$VAULT_PASS"
        sudo cryptsetup open "$TARGET" "$MAPPER_NAME" -d - <<< "$VAULT_PASS"
        sudo mkfs.ext4 -q -L cwos_vault "/dev/mapper/$MAPPER_NAME"
    fi
    sudo mkdir -p "$MOUNT_POINT"
    sudo mount "/dev/mapper/$MAPPER_NAME" "$MOUNT_POINT"
    sudo chown $USER:$USER "$MOUNT_POINT"
fi
echo "âœ… INTERNAL VAULT READY"

# --- 2. FILENAME CONFIG & COLLISION CHECK ---
FINAL_MOUNT="/mnt/sallyport"
FOUND=0
mapfile -t PARTITIONS < <(lsblk -lnpo NAME,TYPE | awk -v boot="$PARENT_DISK" '$1 !~ boot && $2=="part" {print $1}')

if [ -f "$CFG_FILE" ]; then
    CONTAINER_NAME=$(cat "$CFG_FILE")
    echo "í ½í´ Looking for saved ghost container: $CONTAINER_NAME"
else
    echo "--- Setup: No Sallyport Config Found ---"
    while true; do
        read -p "Choose a 'ghost' name for your NEW external vault file: " CONTAINER_NAME
        EXIST_CHECK=0
        for part in "${PARTITIONS[@]}"; do
            T_MNT=$(mktemp -d)
            if sudo mount -o ro "$part" "$T_MNT" >/dev/null 2>&1; then
                [ -f "$T_MNT/$CONTAINER_NAME" ] && EXIST_CHECK=1
                sudo umount -l "$T_MNT"
            fi
            rmdir "$T_MNT" 2>/dev/null
            [ $EXIST_CHECK -eq 1 ] && break
        done
        
        if [ $EXIST_CHECK -eq 1 ]; then
            echo "âŒ ERROR: '$CONTAINER_NAME' already exists. Choose a unique name."
        else
            break
        fi
    done
fi

# --- 3. AUTO-MOUNT PHASE ---
for part in "${PARTITIONS[@]}"; do
    TEMP_MOUNT=$(mktemp -d)
    if sudo mount "$part" "$TEMP_MOUNT" >/dev/null 2>&1; then
        if [ -f "$TEMP_MOUNT/$CONTAINER_NAME" ]; then
            echo "âœ¨ Found $CONTAINER_NAME on $part"
            sudo mkdir -p "$FINAL_MOUNT"
            printf '%s' "$VAULT_PASS" | sudo veracrypt --text --non-interactive --stdin \
                --mount "$TEMP_MOUNT/$CONTAINER_NAME" "$FINAL_MOUNT" && FOUND=1
        fi
        [ $FOUND -eq 0 ] && sudo umount -l "$TEMP_MOUNT" 2>/dev/null
    fi
    [ $FOUND -eq 0 ] && rmdir "$TEMP_MOUNT" 2>/dev/null
    [ $FOUND -eq 1 ] && break
done

# --- 4. EXTERNAL CREATION ---
if [ $FOUND -eq 0 ]; then
    echo "âŒ $CONTAINER_NAME not found. Hardware scan below:"
    echo "-----------------------------------------------------------"
    # Unified hardware listing: /dev/sdb: 466.3G - SanDisk 3.2 Gen1
    lsblk -dnpo NAME,SIZE,MODEL | grep -v "$PARENT_DISK" | grep -v "loop" | \
    awk '{dev=$1; size=$2; $1=$2=""; model=substr($0,3); print dev ": " size " - " model}'
    echo "-----------------------------------------------------------"

    if [ ${#PARTITIONS[@]} -eq 0 ]; then
        echo "âš ï¸ No formatted partitions found. You must format a disk."
        ACTION="2"
    else
        echo "Available Partitions:"
        lsblk -lnpo NAME,SIZE,FSTYPE,LABEL | grep -v "$PARENT_DISK" | grep "part" | column -t
        echo "-----------------------------------------------------------"
        read -p "Would you like to (1) Use existing partition or (2) Format new disk? (1/2/n): " ACTION
    fi

    if [ "$ACTION" == "1" ]; then
        read -p "Enter partition path: " NEW_PART
        PARENT_MOUNT="/mnt/sallyport_parent"
        sudo mkdir -p "$PARENT_MOUNT"
        if sudo mount "$NEW_PART" "$PARENT_MOUNT" 2>/dev/null; then
            echo "Creating ghost vault..."
            RAND_SIZE_KB=$(od -An -N4 -tu4 /dev/urandom | awk -v min=131072 -v max=1048576 '{print ( $1 % (max - min + 1 ) ) + min}')
            printf '%s' "$VAULT_PASS" | sudo veracrypt --text --non-interactive --stdin \
                --create "$PARENT_MOUNT/$CONTAINER_NAME" --size="${RAND_SIZE_KB}K" \
                --volume-type=normal --encryption=AES --hash=SHA-512 --filesystem=FAT --pim=0 --keyfiles="" --quick
            
            echo "$CONTAINER_NAME" > "$CFG_FILE"
            sudo mkdir -p "$FINAL_MOUNT"
            printf '%s' "$VAULT_PASS" | sudo veracrypt --text --non-interactive --stdin --mount "$PARENT_MOUNT/$CONTAINER_NAME" "$FINAL_MOUNT"
            echo "âœ… Created, saved, and mounted."
        fi
    elif [ "$ACTION" == "2" ]; then
        read -p "Enter disk to WIPE (e.g. /dev/sdb): " NEW_TARGET
        read -p "Type YES to confirm WIPE: " REALLY
        if [ "$REALLY" == "YES" ]; then
            sudo wipefs -a "$NEW_TARGET"
            sudo parted -s "$NEW_TARGET" mklabel gpt mkpart primary fat32 0% 100%
            sleep 2
            PART="${NEW_TARGET}1"; [[ "$NEW_TARGET" == nvme* ]] && PART="${NEW_TARGET}p1"
            sudo mkfs.vfat -F 32 "$PART"
            PARENT_MOUNT="/mnt/sallyport_parent"
            sudo mkdir -p "$PARENT_MOUNT"
            sudo mount "$PART" "$PARENT_MOUNT"
            RAND_SIZE_KB=$(od -An -N4 -tu4 /dev/urandom | awk -v min=131072 -v max=1048576 '{print ( $1 % (max - min + 1 ) ) + min}')
            printf '%s' "$VAULT_PASS" | sudo veracrypt --text --non-interactive --stdin \
                --create "$PARENT_MOUNT/$CONTAINER_NAME" --size="${RAND_SIZE_KB}K" \
                --volume-type=normal --encryption=AES --hash=SHA-512 --filesystem=FAT --pim=0 --keyfiles="" --quick
            
            echo "$CONTAINER_NAME" > "$CFG_FILE"
            sudo mkdir -p "$FINAL_MOUNT"
            printf '%s' "$VAULT_PASS" | sudo veracrypt --text --non-interactive --stdin --mount "$PARENT_MOUNT/$CONTAINER_NAME" "$FINAL_MOUNT"
            echo "âœ… Formatted, Created, Saved, and Mounted."
        fi
    fi
fi