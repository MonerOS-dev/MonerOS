#!/bin/bash

# 1. Create the user if it doesn't exist
if ! id -u user >/dev/null 2>&1; then
    useradd -m -s /bin/bash user
fi

# 2. Force the password to 'live'
echo "user:live" | chpasswd

# 3. Create the sudoers.d directory if it's missing
mkdir -p /etc/sudoers.d

# 4. Add to sudoers safely
echo "user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/99_cwos_user

# 5. Set correct permissions
chmod 440 /etc/sudoers.d/99_cwos_user