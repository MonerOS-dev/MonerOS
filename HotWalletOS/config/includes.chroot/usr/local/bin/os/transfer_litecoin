#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_litecoin"
BACKEND_DIR="/var/www/backend/Litecoin"
CONFIG_FILE="/home/user/password.cfg"
TIP_ADDRESS="LfxcYRpa754ChaSKBe4fKWqwYCoqNi9nGt"
LOG_FILE="/tmp/transfer_ltc.log"

# Arguments
ADDRESS=$1
DEST=$2
AMOUNT=$3
TIP_PERCENT=$4
INPUT_PASS=$5

# Paths
WALLET_DIR="${WATCH_DIR}/${ADDRESS}"
mkdir -p "$WALLET_DIR"

log_msg() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [LTC-ADDR: $ADDRESS] $1" >> "$LOG_FILE" 2>/dev/null; }

# 1. Password Verification
STORED_PASS=$(cat "$CONFIG_FILE" | tr -d '\r\n' | xargs)
if [[ "$INPUT_PASS" != "$STORED_PASS" ]]; then
    echo "FAILURE: Incorrect Wallet Password."
    exit 1
fi

# 2. Balance / Math Preparation
BALANCE_FILE="${BACKEND_DIR}/${ADDRESS}_unlocked.txt"
if [ -f "$BALANCE_FILE" ]; then
    CURRENT_BALANCE=$(cat "$BALANCE_FILE" | tr -d '\n\r ' | sed 's/[^0-9.]//g')
else
    CURRENT_BALANCE="0"
fi

FEE_SAT=40000 

if [[ "$AMOUNT" == "sweep_all" ]]; then
    # Using bc for comparison
    if (( $(echo "$CURRENT_BALANCE >= 0.015" | bc -l) )); then
        TIP_SAT=$(python3 -c "print(int(float('$CURRENT_BALANCE') * 100000000 * (float('$TIP_PERCENT') / 100)))")
    else
        TIP_SAT=0
    fi
    MAIN_SAT=0 
    export CALC_SWEEP=true
else
    MAIN_SAT=$(python3 -c "print(int(float('$AMOUNT') * 100000000))")
    TIP_SAT=$(python3 -c "print(int($MAIN_SAT * (float('$TIP_PERCENT') / 100)))")
    export CALC_SWEEP=false
fi

# 3. Fetch UTXOs from LitecoinSpace (No rate limits like BlockCypher)
export UTXO_JSON=$(curl -s -f --connect-timeout 10 "https://litecoinspace.org/api/address/${ADDRESS}/utxo")

if [[ -z "$UTXO_JSON" || "$UTXO_JSON" == "[]" ]]; then
    echo "FAILURE: API Empty. No coins found at $ADDRESS."
    exit 1
fi

# 4. Extract ScriptPubKey via Secondary LitecoinSpace Call
# We grab the first TXID to get the script (works for standard wallets)
TXID=$(python3 -c "import json, os; print(json.loads(os.environ['UTXO_JSON'])[0]['txid'])")
VOUT=$(python3 -c "import json, os; print(json.loads(os.environ['UTXO_JSON'])[0]['vout'])")

TX_DATA=$(curl -s -f "https://litecoinspace.org/api/tx/${TXID}")
export SCRIPT_PUBKEY=$(python3 -c "import json, sys; d=json.loads(sys.stdin.read()); print(d['vout'][$VOUT]['scriptpubkey'])" <<< "$TX_DATA")

if [[ -z "$SCRIPT_PUBKEY" ]]; then
    echo "FAILURE: Could not retrieve scriptpubkey from LitecoinSpace."
    exit 1
fi

export MAIN_SAT TIP_SAT FEE_SAT DEST ADDRESS TIP_ADDRESS

# 5. Python Logic (Assemble the Manifest)
MANIFEST=$(python3 -c "
import json, sys, os

def die(msg):
    print(f'\n[ERROR] {msg}', file=sys.stderr)
    sys.exit(1)

try:
    utxos = json.loads(os.environ.get('UTXO_JSON', '[]'))
    script = os.environ.get('SCRIPT_PUBKEY')
    
    selected_in = []
    total_in = 0
    
    for u in utxos:
        selected_in.append({
            'txid': u['txid'],
            'vout': u['vout'],
            'script': script,
            'value': int(u['value'])
        })
        total_in += int(u['value'])

    main_req = int(os.environ.get('MAIN_SAT', 0))
    tip_req = int(os.environ.get('TIP_SAT', 0))
    fee_req = int(os.environ.get('FEE_SAT', 40000))
    
    if os.environ.get('CALC_SWEEP') == 'true':
        final_main = total_in - tip_req - fee_req
    else:
        final_main = main_req
    
    final_tip = tip_req if final_main > 0 else 0

    if final_main <= 0:
        die(f'Insufficient funds. TotalIn:{total_in} Fee:{fee_req} Tip:{tip_req}')

    manifest = {
        'network': 'litecoin-mainnet',
        'from': os.environ.get('ADDRESS'),
        'inputs': selected_in,
        'outputs': [{'address': os.environ.get('DEST'), 'value': final_main}],
        'fee': fee_req
    }
    
    if final_tip > 5460:
        manifest['outputs'].append({'address': os.environ.get('TIP_ADDRESS'), 'value': final_tip})
    
    if os.environ.get('CALC_SWEEP') == 'false':
        change = total_in - final_main - final_tip - fee_req
        if change > 5460:
            manifest['outputs'].append({'address': os.environ.get('ADDRESS'), 'value': change})

    print(json.dumps(manifest))
except Exception as e:
    die(f'Logic Crash: {str(e)}')
")

if [[ $? -ne 0 ]]; then
    exit 1
fi

# 6. Final Save
TIMESTAMP=$(date +%s)
FILE_NAME="unsigned_ltc_${TIMESTAMP}.json"
echo "$MANIFEST" > "${WALLET_DIR}/${FILE_NAME}"
chmod 666 "${WALLET_DIR}/${FILE_NAME}"

echo "SUCCESS: Created ${FILE_NAME}"
log_msg "SUCCESS: ${FILE_NAME}"