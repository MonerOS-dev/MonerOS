#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

BASE_DIR="/mnt/sallyport/watch_dogecoin"
BACKEND_DIR="/var/www/backend/Dogecoin"

# --- Configuration ---
MAX_RETRIES=3
RETRY_DELAY=15
mkdir -p "$BACKEND_DIR"

echo "Getting DOGE Balance"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet directory does not exist. Exiting."
    exit 0
fi

fetch_balance_online() {
    local addr=$1
    local attempt=1

    while [ $attempt -le $MAX_RETRIES ]; do
        # SoChain API for DOGE
        local result=$(curl -s "https://chain.so/api/v2/get_address_balance/DOGE/${addr}")

        # Extract balance (SoChain returns DOGE as a float string, not Satoshis)
        # We look for "confirmed_balance":"123.456"
        local bal=$(echo "$result" | sed -n 's/.*"confirmed_balance":"\([0-9.]*\)".*/\1/p')
        
        # Also grab unconfirmed just in case
        local unconfirmed=$(echo "$result" | sed -n 's/.*"unconfirmed_balance":"\([0-9.]*\)".*/\1/p')

        # Default to 0.00000000 if empty
        bal=${bal:-0.00000000}
        unconfirmed=${unconfirmed:-0.00000000}

        # Validate we got a numeric result
        if [[ "$bal" =~ ^[0-9.]+$ ]]; then
            # Add confirmed + unconfirmed using awk (since they are decimals, not integers)
            local total_doge=$(awk "BEGIN {printf \"%.8f\", $bal + $unconfirmed}")
            echo "$total_doge"
            return 0
        fi

        echo "Attempt $attempt failed for $addr. Retrying in ${RETRY_DELAY}s..." >&2
        attempt=$((attempt + 1))
        [ $attempt -le $MAX_RETRIES ] && sleep $RETRY_DELAY
    done

    return 1
}

check_balance() {
    local dir=$1
    local INFO_FILE="${dir}watch_info.txt"
    
    if [ -f "$INFO_FILE" ]; then
        local ADDR=$(grep "ADDRESS:" "$INFO_FILE" | awk '{print $2}' | tr -d '\r')
        
        if [ -n "$ADDR" ]; then
            echo "Checking online Dogecoin balance for: $ADDR"
            local NEW_BAL=$(fetch_balance_online "$ADDR")
            
            if [ $? -eq 0 ]; then
                # Write to backend
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_balance.txt" > /dev/null
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_unlocked.txt" > /dev/null
                echo "SUCCESS: Updated $ADDR to $NEW_BAL DOGE"
            else
                echo "ERROR: Failed to fetch balance for $ADDR."
            fi
        fi
    fi
}

# --- Main Loop ---
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    check_balance "$dir"
done

echo "--- Dogecoin online balance refresh cycle complete ---"