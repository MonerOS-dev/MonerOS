#!/bin/bash
# --- /usr/local/bin/os/start_monero_daemons ---

BASE_DIR="/mnt/sallyport/watch_monero"
START_PORT=18084
NODE_CACHE_FILE="/home/user/monero_node.cfg"
TOR_PROXY="127.0.0.1:9050"
LOCAL_TOR_NODE="127.0.0.1:18081"

# Check cache file
if [ -f "$NODE_CACHE_FILE" ] && [ -n "$(tr -d '[:space:]' < "$NODE_CACHE_FILE")" ]; then
    TARGET_NODE=$(tr -d '\n\r ' < "$NODE_CACHE_FILE")
    echo "[*] Local cache file found. Using cached node: $TARGET_NODE"
    
    RPC_PROXY_FLAG=""
    if [[ "$TARGET_NODE" == *".onion"* ]]; then
        echo "[*] Remote Tor node detected from cache. Enabling Tor proxy flag."
        RPC_PROXY_FLAG="--proxy $TOR_PROXY"
    elif [[ "$TARGET_NODE" == "127.0.0.1"* ]] || [[ "$TARGET_NODE" == "localhost"* ]]; then
        echo "[!] Local node detected from cache. Bypassing Tor proxy flag."
    else
        echo "[!] Remote Clearnet node detected from cache. Bypassing Tor proxy flag."
    fi
fi

# --- WAIT INDEFINITELY FOR LOCAL NODE IF TARGET IS LOCAL ---
if [[ "$TARGET_NODE" == "127.0.0.1"* ]] || [[ "$TARGET_NODE" == "localhost"* ]]; then
    echo "[*] Local node target detected. Waiting for port 18081 to become active..."
    while ! ss -tln | grep -qE ":18081\b"; do
        sleep 2
    done
    echo "[+] Local node detected on 18081. Proceeding..."
fi

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

# 2. ASSIGN NEWT COLORS (Strict Black, Red, White Palette)
export NEWT_COLORS='
  root=black,black
  window=red,black
  shadow=black,black
  border=red,black
  title=red,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,red
  button=white,black
  actbutton=black,white
  entry=white,black
'

# --- 1. BLOCK KEYBOARD INTERRUPTS ---
trap '' SIGINT SIGTSTP

# Define target file container context here so cryptsetup knows what to test
TARGET_FILE="/mnt/external/sallyport.bin"

while true; do
    # Force whiptail's drawing engine to tty1, but keep the standard out pipeline clean for Bash
    PASSWORD=$(whiptail --passwordbox --fb --nocancel "\nEnter Master Password" 10 50 3>&1 1>&2 2>&3) </dev/tty1 >/dev/tty1
    STATUS=$?
    
    if [ $STATUS -ne 0 ]; then
        whiptail --fb --msgbox "Input cancelled or failed. Please try again." 9 50 </dev/tty1 >/dev/tty1
        continue
    fi
    
    if [ -z "$PASSWORD" ]; then
        whiptail --fb --msgbox "Password cannot be blank. Please try again." 9 50 </dev/tty1 >/dev/tty1
        continue
    fi
    
    # Test the passphrase using the verified syntax
    if printf '%s' "$PASSWORD" | sudo cryptsetup open --type luks --test-passphrase "$TARGET_FILE" -d - > /dev/null 2>&1; then
        # Success! Clear the screen and proceed with $PASSWORD intact
        clear
        break
    else
        whiptail --fb --msgbox "Incorrect password. Please try again." 9 50 </dev/tty1 >/dev/tty1
        unset PASSWORD
    fi
done

clear

# =====================================================================
# ROBUST TEARDOWN LOGIC
# Ensure all previous RPCs are fully dead before trying to re-bind ports
# =====================================================================
if pgrep -f "monero-wallet-rpc" > /dev/null; then
    echo "[*] Stopping existing RPC daemons gracefully to release ports..."
    sudo pkill -2 -f "monero-wallet-rpc" 2>/dev/null
    
    # Wait up to 12 seconds for graceful shutdown to finish saving LMDB state
    for i in {1..12}; do
        if ! pgrep -f "monero-wallet-rpc" > /dev/null; then
            break
        fi
        sleep 1
    done

    # Force kill if any are hung so the script can proceed safely
    if pgrep -f "monero-wallet-rpc" > /dev/null; then
        echo "[!] Force killing lingering daemons..."
        sudo pkill -9 -f "monero-wallet-rpc" 2>/dev/null
        sleep 1
    fi
fi

# Buffer to allow OS socket stack to clear TCP port bindings (TIME_WAIT state)
sleep 1
# =====================================================================

CURRENT_PORT=$START_PORT

# Prevent empty base directory from breaking loop evaluation
shopt -s nullglob

for dir in "$BASE_DIR"/*/; do
    WALLET_FILE="${dir}watchonly"
    if [ -f "$WALLET_FILE" ]; then
        ADDR_ID=$(basename "$dir")
        LOG_FILE="${dir}rpc_daemon.log"
        
        echo "[*] Launching persistent RPC for $ADDR_ID on port $CURRENT_PORT -> Target: $TARGET_NODE"
        
        # 1. Create a secure temporary file
        PASS_FILE=$(mktemp)
        echo -n "$PASSWORD" > "$PASS_FILE"
        
        # 2. Give the 'user' account permission to read it
        chown user:user "$PASS_FILE"
        chmod 600 "$PASS_FILE"
        
        # Start the background daemon pointing dynamically to verified destination
        sudo -u user monero-wallet-rpc \
            --wallet-file "$WALLET_FILE" \
            --password-file "$PASS_FILE" \
            --rpc-bind-port "$CURRENT_PORT" \
            --disable-rpc-login \
            --daemon-address "$TARGET_NODE" \
            $RPC_PROXY_FLAG \
            --trusted-daemon \
            --log-file "rpc_daemon.log" >/dev/null 2>&1 &
            
        sleep 3
            
        # Store the assigned port in the folder for other scripts to read dynamically
        echo "$CURRENT_PORT" > "${dir}rpc_port.cfg"
        
        CURRENT_PORT=$((CURRENT_PORT + 1))
        
        # Stagger startup to prevent disk I/O thrashing and CPU spikes
        sleep 0.5
    fi
done

# Clear the variable from memory immediately for security
unset PASSWORD
rm -f "$PASS_FILE"

shopt -u nullglob
echo "[+] All RPC daemons initiated and pointing to $TARGET_NODE."