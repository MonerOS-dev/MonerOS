            margin-top: 10px;
        }
        .btn-cancel:hover {
            background: #ff3333;
            color: #fff;
            border-color: #ff3333;
        }
        
        select {
            color: #008f11 !important;
            border-color: #222;
            background: rgba(0, 0, 0, 0.8);
        }
        
        select option {
            background: #0a0a0a;
            color: #ffffff;
        }

        .response { margin-top: 15px; padding: 15px; border: 2px solid; border-radius: 4px; }
        .success { border-color: var(--glow-green); background: rgba(0, 255, 65, 0.05); }
        .error { border-color: #ff3333; background: rgba(255, 0, 0, 0.05); color: #ff3333; }
    </style>
</head>
<body>
    <h1>HotWalletOS</h1>
    <div class="update-tag">AVALANCHE TRANSFER</div>
    
    <div class="container">
        <?php if ($message): ?>
            <div class="response <?php echo $status_class; ?>">
                <?php if ($status_class === "success"): ?>
                    <p style="letter-spacing:1px; color: var(--glow-green); font-size: 0.75rem; font-weight: bold; margin-bottom: 10px;">GENERATE UNSIGNED JSONS:</p>
                    <pre><?php echo htmlspecialchars($message); ?></pre>
                    <p style="font-size: 0.7rem; color: var(--silver-dark); margin-top: 10px; text-transform: uppercase;">JSONs saved to wallet folder. Transfer to Offline device.</p>
                <?php else: ?>
                    <p style="font-family: 'Roboto Mono', monospace; font-size: 0.85rem;"><?php echo nl2br(htmlspecialchars($message)); ?></p>
                <?php endif; ?>
            </div>
            <a href="index.php" class="btn-cmd btn-action" style="margin-top:20px;">RETURN TO DASHBOARD</a>
        <?php else: ?>
            <form method="POST" autocomplete="off">
                <div class="form-group">
                    <label>From Address (Read-Only)</label>
                    <input type="text" value="<?php echo $address; ?>" readonly tabindex="-1">
                </div>
                <div class="form-group">
                    <label>Destination Address (0x...)</label>
                    <input type="text" name="destination" placeholder="0x..." autocomplete="off" required>
                </div>
                <div class="form-group">
                    <label>Amount (or 'sweep_all') in AVAX</label>
                    <input type="text" name="amount" placeholder="0.1" autocomplete="off" required>
                </div>
                <div class="form-group">
                    <label>Development Contribution</label>
                    <select name="tip_percent">
                        <option value="0.40">0.40% (Recommended)</option>
                        <option value="0.30">0.30%</option>
                        <option value="0.20">0.20%</option>
                        <option value="0.10">0.10%</option>
                        <option value="0">0.00% (No Contribution)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Wallet Password</label>
                    <input type="password" name="password" autocomplete="new-password" required>
                </div>
                <button type="submit" class="btn-cmd btn-action">Create Unsigned AVAX Transaction</button>
            </form>
            <a href="index.php" class="btn-cmd btn-cancel">Cancel and Go Back</a>
        <?php endif; ?>
    </div>
</body>
</html>
EOF

    sed -i "s|REPLACE_ME_ADDRESS|$ADDRESS|g" "$TARGET_FILE"
    chown www-data:www-data "$TARGET_FILE"
    chmod 644 "$TARGET_FILE"
}

if [ -n "$SINGLE_ADDR" ]; then
    generate_page "$SINGLE_ADDR"
else
    cd "$WATCH_DIR" || exit
    for dir in 0x*/; do
        generate_page "${dir%/}"
    done
fi