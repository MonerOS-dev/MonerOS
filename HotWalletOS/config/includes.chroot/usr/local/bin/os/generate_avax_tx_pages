            --glow-green: #00ff41;
        }

        body {
            background: radial-gradient(circle at center, #1c1c1c 0%, #000000 100%);
            background-attachment: fixed;
            color: var(--silver-mid);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        h1 {
            font-size: clamp(2.5rem, 10vw, 4rem); 
            margin: 0;
            letter-spacing: 8px;
            color: var(--silver-light);
            text-transform: none;
            font-weight: 250;
            text-shadow: 0 0 20px rgba(192, 192, 192, 0.2);
            text-align: center;
        }

        .update-tag {
            font-size: 0.8rem;
            color: var(--silver-dark);
            margin-bottom: 20px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .container {
            background: linear-gradient(145deg, #1a1a1a, #050505);
            border: 2px solid #444;
            padding: 20px;
            border-radius: 4px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
            width: 100%;
            max-width: 550px;
            box-sizing: border-box;
            margin-bottom: 20px;
        }

        .container::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(to right, transparent, var(--silver-mid), transparent);
        }

        .form-group { 
            margin-bottom: 18px;
            width: 100%; 
            text-align: left;
        }
        
        label { 
            display: block; 
            margin-bottom: 8px;
            color: var(--silver-dark); 
            font-size: 0.7rem; 
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: bold;
        }
        
        input, select {
            width: 100%;
            padding: 12px;
            background: rgba(0, 0, 0, 0.6);
            border: 2px solid #333;
            color: var(--glow-green);
            font-family: 'Roboto Mono', monospace;
            box-sizing: border-box;
            border-radius: 2px;
            font-size: 0.95rem;
        }

        input[readonly] { 
            color: #008f11;
            border-color: #222;
            background: rgba(0, 0, 0, 0.8);
            cursor: not-allowed;
        }
        
        pre {
            background: #000;
            color: var(--glow-green);
            padding: 15px;
            border: 2px solid #333;
            overflow-x: auto;
            white-space: pre-wrap;
            font-size: 0.8rem;
            font-family: 'Roboto Mono', monospace;
        }

        .btn-cmd {
            display: block;
            width: 100%;
            padding: 14px;
            background: #000;
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            text-transform: uppercase;
            border: 2px solid #444;
            text-align: center;
            cursor: pointer;
            box-sizing: border-box;
        }

        .btn-action { color: var(--silver-light); }
        .btn-action:hover {
