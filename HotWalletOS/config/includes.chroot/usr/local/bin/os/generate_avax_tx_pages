#!/bin/bash

WATCH_DIR="/mnt/sallyport/watch_avalanche"
WEB_DIR="/var/www/html"
SINGLE_ADDR=$1

generate_page() {
    local ADDRESS=$1
    local TARGET_FILE="${WEB_DIR}/${ADDRESS}.php"
    
    echo "Generating page for: $ADDRESS"

    cat <<'EOF' > "$TARGET_FILE"
<?php
$address = "REPLACE_ME_ADDRESS";
$message = "";
$status_class = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $dest = $_POST['destination'] ?? '';
    $amount = strtolower($_POST['amount'] ?? '');
    $tip_percent = $_POST['tip_percent'] ?? '1.25'; 
    $input_pass = $_POST['password'] ?? '';
    
    $cmd = "sudo /usr/bin/bash /usr/local/bin/os/transfer_avalanche " . 
           escapeshellarg($address) . " " . 
           escapeshellarg($dest) . " " . 
           escapeshellarg($amount) . " " . 
           escapeshellarg($tip_percent) . " " . 
           escapeshellarg($input_pass);
           
    $output = shell_exec($cmd . " 2>&1");
    $message = trim($output);
    
    if (strpos($message, 'SUCCESS') !== false) {
        $status_class = "success";
    } else {
        $status_class = "error";
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HotWalletOS - AVAX Transfer</title>
