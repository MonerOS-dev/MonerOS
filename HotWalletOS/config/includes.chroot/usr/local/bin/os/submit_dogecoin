#!/bin/bash

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_dogecoin"
# Using Blockchair's Push API - usually very friendly to headless scripts
RPC_URL="https://api.blockchair.com/dogecoin/push/transaction"
LOG_FILE="/tmp/logs/submit_doge.log"

DEBUG=true
S_COUNT=0
F_COUNT=0

mkdir -p "$(dirname "$LOG_FILE")"
log_msg() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

echo "Submitting Doge Transactions via Blockchair API"

TX_LIST=$(find "$BASE_DIR" -type f -name "signed_doge_*.json" | sort -t '_' -k3 -n)

if [ -z "$TX_LIST" ]; then
    echo "SUCCESS: No Dogecoin transactions to process"
    exit 0
fi

for TX_PATH in $TX_LIST; do
    DIR=$(dirname "$TX_PATH")
    SIGNED_FILE=$(basename "$TX_PATH")
    UNSIGNED_PATTERN=$(echo "$SIGNED_FILE" | sed 's/signed_doge_/unsigned_doge_/')

    # 1. Extract raw hex
    RAW_HEX=$(python3 -c "import sys, json; print(json.load(open('$TX_PATH')).get('hex', ''))" 2>/dev/null)

    if [ -z "$RAW_HEX" ]; then
        echo "[FAILED] $SIGNED_FILE (Hex empty)"
        ((F_COUNT++))
        continue
    fi

    if [ "$DEBUG" = true ]; then echo "Broadcasting $SIGNED_FILE via Blockchair..."; fi

    # 2. Broadcast via Blockchair
    # Blockchair expects a POST with a JSON body: {"data": "HEX_HERE"}
    RESPONSE=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)" \
        --data "{\"data\":\"$RAW_HEX\"}" \
        "$RPC_URL")

    # 3. Check for Success
    # Blockchair returns {"data": {"transaction_hash": "..."}}
    TXID=$(echo "$RESPONSE" | python3 -c "import sys, json; print(json.load(sys.stdin).get('data', {}).get('transaction_hash', ''))" 2>/dev/null)

    if [ -n "$TXID" ] && [[ ${#TXID} -eq 64 ]]; then
        echo "[OK] $SIGNED_FILE | Hash: $TXID"
        log_msg "SUCCESS: $SIGNED_FILE | Hash: $TXID"
        ((S_COUNT++))
        rm -f "$TX_PATH"
        find "$DIR" -name "$UNSIGNED_PATTERN" -delete
    else
        # Extract the specific error if possible
        ERR_MSG=$(echo "$RESPONSE" | python3 -c "import sys, json; print(json.load(sys.stdin).get('context', {}).get('error', 'Unknown Error'))" 2>/dev/null)
        echo "[FAILED] $SIGNED_FILE | Response: $RESPONSE"
        log_msg "FAILED: $SIGNED_FILE | Error: $ERR_MSG"
        ((F_COUNT++))
    fi
    
    # Blockchair is generous, but let's not spam it
    sleep 2
done

echo "------------------------------------------------"
echo "Done. Success: $S_COUNT | Failed: $F_COUNT"