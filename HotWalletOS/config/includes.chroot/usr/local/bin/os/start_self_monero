#!/bin/bash

# =====================================================================
# MonerOS Unified Transition & Hardware Optimization Engine
# =====================================================================

clear

# Color Definitions
WHITE='\033[1;37m'
RED='\033[1;31m'
NC='\033[0m' # No Color

# Path Definitions
CONF_FILE="/home/user/monerod-tor.conf"
CLEARNET_CONF="/home/user/monerod-clearnet.conf"
LOG_FILE="/mnt/p4/monero/monerod.log"
NODE_CACHE_FILE="/home/user/monero_node.cfg"
MONERO_DIR="/mnt/p4/monero"
MONERO_PATH=$(command -v monerod)

# --- 1. PREPARE ENVIRONMENT ---
echo -e "${WHITE}[*] Preparing filesystem and permissions...${NC}"
sudo mkdir -p "$MONERO_DIR"
sudo touch "$LOG_FILE"
sudo chown -R user:user "$MONERO_DIR"
sudo chmod -R 775 "$MONERO_DIR"

# --- 2. SYSTEMD INJECTION ---
echo -e "${WHITE}[*] Injecting systemd service managers...${NC}"

# Clearnet Service
sudo tee /etc/systemd/system/monerod-sync.service > /dev/null <<EOF
[Unit]
Description=Monero Clearnet Sync (Managed)
After=network.target

[Service]
User=user
Group=user
Type=simple
ExecStart=$MONERO_PATH --config-file $CLEARNET_CONF --non-interactive
Restart=always
RestartSec=5
StandardOutput=append:$LOG_FILE
StandardError=append:$LOG_FILE
LimitNOFILE=65536
TimeoutStopSec=180
EOF

# Tor Service
sudo tee /etc/systemd/system/monerod-tor.service > /dev/null <<EOF
[Unit]
Description=Monero Tor Node (Managed)
After=network.target

[Service]
User=user
Group=user
Type=simple
ExecStart=$MONERO_PATH --config-file $CONF_FILE --zmq-rpc-bind-port 18083 --non-interactive
Restart=always
RestartSec=10
StandardOutput=append:$LOG_FILE
StandardError=append:$LOG_FILE
LimitNOFILE=65536
TimeoutStopSec=180
EOF

sudo systemctl daemon-reload

# --- 3. HARDWARE CONFIG ---
echo -e "${WHITE}[*] Creating monerod config files...${NC}"
sudo bash "/usr/local/bin/os/setup_monero_clearnet"
sudo bash "/usr/local/bin/os/setup_monero_tor"

# Ensure user owns the generated configs
sudo chown user:user "$CLEARNET_CONF" "$CONF_FILE"

# --- 4. STARTING SYNC ---
echo -e "${WHITE}[*] Starting Monero Sync via Systemd...${NC}"
sudo systemctl start monerod-sync.service

# Safety check
sleep 3
if ! systemctl is-active --quiet monerod-sync.service; then
    echo -e "${RED}[!] ERROR: Service failed to start. Checking logs...${NC}"
    sudo journalctl -u monerod-sync.service -n 20 --no-pager
    exit 1
fi

echo -n "Waiting for daemon to respond"
until monerod status >/dev/null 2>&1; do
    echo -n "."
    sleep 2
done
echo " Done."

# =====================================================================
# 5. LIVE LOG STREAMING & FORMATTING ENGINE (WITH WATCHDOG)
# =====================================================================

CURRENT_STATUS=$(monerod status 2>/dev/null)

if echo "$CURRENT_STATUS" | grep -qi "synchronized with the network"; then
    echo -e "${WHITE}[*] Daemon is already fully synchronized.${NC}"
else
    # Auto restarts after 5 minutes of no activity
    echo -e "${WHITE}[*] Syncing... (This may take a LONG time)${NC}"
    echo -e "  | Date | Time | Progress | % | Est. Remaining |"
    
    exec 3< <(tail -F -n 0 "$LOG_FILE" 2>/dev/null)
    TRACKED_EST="Calculating..."
    LAST_SYNC_TIME=$(date +%s) 
    
    # Infinite loop with a short timeout on the read command
    while :; do
        if read -t 5 -r line <&3; then
            if echo "$line" | grep -q "Synced"; then
                # Reset the watchdog timer every time progress is made
                LAST_SYNC_TIME=$(date +%s) 
                
                if echo "$line" | grep -q "estimated"; then
                    TRACKED_EST=$(echo "$line" | perl -pe 's/.*estimated (.*? left)\)/$1/')
                fi
                
                formatted_line=$(echo "$line" | env est="$TRACKED_EST" perl -pe '
                    s/^(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2}:\d{2}\.\d{3}).*?Synced (\d+\/\d+)(?:\s+\(([\d%]+),.*)?/\r\033[K| $1 | $2 | Synced $3 | $4 | $ENV{est} |/
                ')
                
                formatted_line=$(echo "$formatted_line" | sed 's/|  |/| 100% |/')
                echo -ne "$formatted_line"
            fi
            
            if echo "$line" | grep -qiE "100%|synchronized with the network" || [[ "$line" =~ Synced\ ([0-9]+)\/\1 ]]; then
                echo "" 
                break
            fi
        fi
        
        # --- WATCHDOG CHECK ---
        CURRENT_TIME=$(date +%s)
        if [ $((CURRENT_TIME - LAST_SYNC_TIME)) -gt 300 ]; then
            echo -e "\n${RED}[!] Sync stalled for 5 minutes. Watchdog force-restarting daemon...${NC}"
            sudo systemctl restart monerod-sync.service
            LAST_SYNC_TIME=$(date +%s) # Reset timer to allow daemon boot time
            sleep 5
        fi
    done
    
    exec 3<&-
    pkill -f "tail -F -n 0 $LOG_FILE" 2>/dev/null
fi



echo "-------------------------------------------------------"
echo -e "${WHITE}[!] 100% Synced! Transitioning to Tor-only mode.${NC}"

# --- CLEANED UP LMDB SHUTDOWN & SOCKET PURGE ---
echo -e "${RED}[!] Stopping sync daemon and flushing sockets...${NC}"
sudo systemctl stop monerod-sync.service

# Wait for process to fully exit safely
ELAPSED=0
TIMEOUT=300
while pgrep -x monerod >/dev/null; do
    sleep 5
    echo -n "."
    ELAPSED=$((ELAPSED + 5))
    if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
        echo -e "\n${RED}[!] Daemon hung. Forcing termination...${NC}"
        sudo pkill -9 -x monerod
        break
    fi
done
echo ""

# Forcefully clear any lingering TIME_WAIT/FIN sockets on Monero ports
sudo ss -K 'sport = :18080' 2>/dev/null
sudo ss -K 'sport = :18081' 2>/dev/null

# Give the Linux kernel network stack a strict buffer to release file descriptors
sleep 5

sudo pkill -f monero-wallet-rpc
echo "[!] Clearnet daemon and sockets successfully cleared."

# --- CLEANED UP LMDB SHUTDOWN WATCHDOG ---
if pgrep -x monerod >/dev/null; then
    echo -e "${RED}[!] Waiting for LMDB to safely save (DO NOT INTERRUPT)...${NC}"
    ELAPSED=0
    TIMEOUT=300 # 5 Minute hard cutoff
    
    while pgrep -x monerod >/dev/null; do
        sleep 5
        echo -n "."
        ELAPSED=$((ELAPSED + 5))
        
        if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
            echo -e "\n${RED}[!] Daemon hung for 5 minutes during flush. Sending SIGTERM...${NC}"
            sudo pkill -15 -x monerod
            sleep 10
            break
        fi
    done
    echo ""
fi

echo "[!] Clearnet daemon successfully stopped."

# --- 6. TOR EXECUTION ---
echo "Starting Tor daemon via Systemd..."
sudo rm -f "$LOG_FILE"
sudo touch "$LOG_FILE" && sudo chown user:user "$LOG_FILE"

sudo systemctl start monerod-tor.service
sleep 10

echo "-------------------------------------------------------"
echo -e "${WHITE}[!] Transition complete. MonerOS is now running Tor-only.${NC}"
echo "-------------------------------------------------------"

# Wait for both the local node's RPC interface AND P2P port 18080 to become active
echo -n "Waiting for local Tor node P2P and RPC to become fully active"
until ss -tln | grep -qE ":18080\b" && monerod --rpc-bind-port 18083 status >/dev/null 2>&1; do
    echo -n "."
    sleep 2
done
echo " Done."

#echo "127.0.0.1:18081" > "$NODE_CACHE_FILE"
#sudo chown user:user "$NODE_CACHE_FILE"

echo "-------------------------------------------------------"
echo -e "${WHITE}[!] Transition complete. MonerOS is now running Tor-only.${NC}"
echo -e "${WHITE}[*] Local node verified and written to cache: $NODE_CACHE_FILE${NC}"
echo "-------------------------------------------------------"

sleep 5