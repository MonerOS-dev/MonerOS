#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_avalanche"
BACKEND_DIR="/var/www/backend/Avalanche"
ETHERS_LIB="/usr/local/lib/ethers/node_modules/ethers"

# Avalanche C-Chain RPC Pool
RPC_URLS=(
    "https://api.avax.network/ext/bc/C/rpc"
    "https://avalanche.drpc.org"
    "https://1rpc.io/avax/c"
    "https://rpc.ankr.com/avalanche"
)

# --- Setup ---
echo "Getting AVAX Balance via RPC Pool"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet directory does not exist. Exiting."
    exit 0
fi

mkdir -p "$BACKEND_DIR"

# Temporary Node.js file (Unique timestamp to prevent collisions)
JS_BAL_FILE="/tmp/fetch_avax_bal_$(date +%s).js"

# 1. Generate the resilient JS helper
cat <<EOF > "$JS_BAL_FILE"
const ethers = require("$ETHERS_LIB");

const RPC_ENDPOINTS = [
    $(printf "'%s'," "${RPC_URLS[@]}")
];

async function getBal() {
    const address = process.argv[2];
    let lastError;

    for (const url of RPC_ENDPOINTS) {
        try {
            // Ethers v5/v6 compatibility check
            const provider = new (ethers.providers ? ethers.providers.JsonRpcProvider : ethers.JsonRpcProvider)(url);
            
            // Set a timeout for the balance call specifically
            const bal = await Promise.race([
                provider.getBalance(address),
                new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), 8000))
            ]);

            const format = (ethers.utils ? ethers.utils.formatEther : ethers.formatEther);
            process.stdout.write(format(bal));
            process.exit(0);
        } catch (e) {
            lastError = e;
            continue; 
        }
    }

    process.stderr.write("ALL_RPC_FAILED: " + (lastError ? lastError.message : "Unknown"));
    process.exit(1);
}
getBal();
EOF

fetch_balance_with_retry() {
    local addr=$1
    local attempt=1
    local MAX_RETRIES=2 # JS already cycles through all RPCs

    while [ $attempt -le $MAX_RETRIES ]; do
        result=$(node "$JS_BAL_FILE" "$addr" 2>/tmp/avax_bal_err.log)
        
        if [ $? -eq 0 ] && [ -n "$result" ]; then
            echo "$result"
            return 0
        fi

        sleep $((2 * attempt))
        attempt=$((attempt + 1))
    done

    return 1
}

check_balance() {
    local dir=$1
    INFO_FILE="${dir}watch_info.txt"

    if [ -f "$INFO_FILE" ]; then
        # Robust address extraction
        ADDR=$(grep "ADDRESS" "$INFO_FILE" | grep -oE '0x[a-fA-F0-9]{40}' | head -n 1)

        if [ -n "$ADDR" ]; then
            echo "Checking: $ADDR"
            NEW_BAL=$(fetch_balance_with_retry "$ADDR")

            if [ -n "$NEW_BAL" ]; then
                # Update backend files
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_balance.txt" > /dev/null
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_unlocked.txt" > /dev/null
                echo "  -> SUCCESS: $NEW_BAL AVAX"
            else
                echo "  -> FAILURE: All RPCs failed. Error: $(cat /tmp/avax_bal_err.log)"
            fi
        fi
    fi
}

# --- MAIN LOOP ---
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    check_balance "$dir"
done

# Cleanup
rm -f "$JS_BAL_FILE"
echo "--- Avalanche balance refresh cycle complete ---"