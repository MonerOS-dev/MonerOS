#!/bin/bash

BASE_DIR="/mnt/sallyport/watch_monero"
S_COUNT=0
F_COUNT=0

if ! command -v jq &> /dev/null; then
    echo "ERROR: 'jq' is required but not installed."
    exit 1
fi

echo "Processing Signed Transactions via Wallet RPC..."
echo "=================================================="

# Preserved structural loop logic, but hardened using process substitution for path safety
while read -r TX_PATH; do
    [ -z "$TX_PATH" ] && continue
    
    DIR=$(dirname "$TX_PATH")
    SIGNED_FILE=$(basename "$TX_PATH")
    UNSIGNED_FILE=$(echo "$SIGNED_FILE" | sed 's/signed_tx_/unsigned_tx_/')
    ADDR_ID=$(basename "$DIR")
    PORT_FILE="${DIR}/rpc_port.cfg"
    KEY_IMAGE_FILE="${DIR}/key_images.json"

    echo "Found signed transaction file: $SIGNED_FILE in directory: $ADDR_ID"

    if [ ! -f "$PORT_FILE" ]; then
        echo "[FAILED] $SIGNED_FILE ($ADDR_ID) - No rpc_port.cfg found"
        echo "Please make sure the RPC server is running for this wallet container."
        ((F_COUNT++))
        continue
    fi

    RPC_PORT=$(tr -d '\n\r ' < "$PORT_FILE")

    echo "--------------------------------------------------"
    echo "Processing wallet: $ADDR_ID on Port $RPC_PORT"

    # --- ADDED READINESS CHECK ---
    echo "Checking daemon readiness..."
    READY=false
    for i in {1..15}; do
        if curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"get_balance"}' | grep -q "balance"; then
            READY=true
            break
        fi
        echo "Daemon busy or syncing... waiting 3s (Attempt $i/15)..."
        sleep 5
    done
    
    if [ "$READY" = false ]; then
        echo "[FAILED] Daemon unresponsive after retries. Skipping..."
        ((F_COUNT++))
        continue
    fi
    
    if [ ! -f "$TX_PATH" ]; then
        echo "[FAILED] $SIGNED_FILE ($ADDR_ID) - Transaction file missing or modified mid-process"
        ((F_COUNT++))
        continue
    fi

    echo "Reading transaction file binaries and converting to standard hex map..."
    TX_HEX=$(od -An -v -tx1 "$TX_PATH" | tr -d '\n\r ')
    
    if [ -z "$TX_HEX" ]; then
        echo "[FAILED] Extraction failed. Hex string calculation returned null values."
        ((F_COUNT++))
        continue
    fi

    echo "Submitting transaction hex data string directly to local wallet RPC server..."
    SUBMIT_PAYLOAD=$(jq -n --arg hex "$TX_HEX" '{"jsonrpc":"2.0","id":"0","method":"submit_transfer","params":{"tx_data_hex":$hex}}')
    RPC_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -H "Content-Type: application/json" -d "$SUBMIT_PAYLOAD")

    echo "Analyzing transaction submission receipt parameters..."
    TX_HASH=$(echo "$RPC_RESPONSE" | jq -r '.result.tx_hash // .result.tx_hash_list[0] // empty')

    if [ -n "$TX_HASH" ] && [ "$TX_HASH" != "null" ]; then
        echo "[SUCCESS] Transaction accepted and relayed to the daemon network pool."
        echo "Wallet ID Target: [$ADDR_ID]"
        echo "Transaction File: [$SIGNED_FILE]"
        echo "Calculated TXID: <$TX_HASH>"
        ((S_COUNT++))

        echo "Executing post-execution house-cleaning loops..."
        echo "Clearing out residual log stacks and transient runtime binaries..."
        rm -f "${DIR}/monero-wallet-cli.log" "${DIR}/rpc_daemon.log" "${DIR}/tip.log" "${DIR}/signed_monero_tx" "$TX_PATH"
        
        if [ -f "${DIR}/${UNSIGNED_FILE}" ]; then
            echo "Matching raw unsigned source frame detected. Removing: ${UNSIGNED_FILE}"
            rm -f "${DIR}/${UNSIGNED_FILE}"
        fi

        echo "Triggering fresh export_outputs execution to maintain clean cold sync targets..."
        EXPORT_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"export_outputs","params":{"all":true}}')
        HEX=$(echo "$EXPORT_RESPONSE" | jq -r '.result.outputs_data_hex // empty')

        if [ -n "$HEX" ] && [ "$HEX" != "null" ]; then
            echo "$HEX" > "${DIR}/outputs.hex"
            echo "[OK] Updated outputs.hex written successfully to local mapping directory."
            
            # This prevents the "ghost" balance and stops the .new file corruption
            curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"store"}' >/dev/null
            echo "[OK] Wallet state saved to disk."
        else
            ERR_MSG=$(echo "$EXPORT_RESPONSE" | jq -r '.error.message // "Unknown RPC Error"')
            echo "[WARNING] Automated export_outputs chain failed: $ERR_MSG"
            echo "Please manually export output structures from cold view maps before subsequent transfers."
        fi
    else
        echo "[FAILED] Daemon rejected the signed transaction payload submission."
        echo "Wallet Container Reference: [$ADDR_ID]"
        ERR_MSG=$(echo "$RPC_RESPONSE" | jq -r '.error.message // empty')
        
        if [ -n "$ERR_MSG" ]; then
            echo "RPC Server Error Reason: $ERR_MSG"
        else
            echo "Raw Unparsed RPC Response Dump Below:"
            echo "$RPC_RESPONSE"
        fi
        
        ((F_COUNT++))
        echo "Preserving raw signed file blocks for debug inspection. Removing volatile locks..."
        rm -f "${DIR}/signed_monero_tx"
    fi
done < <(find "$BASE_DIR" -type f -name "signed_tx_*" | sort -t '_' -k3 -n)

echo "=================================================="
echo "TRANSACTION PROCESSING LOOP EXHAUSTED"
if [ "$F_COUNT" -eq 0 ]; then
    echo "SUMMARY_SUCCESS: All $S_COUNT signed transactions successfully compiled and pushed."
else
    echo "SUMMARY_FAILURE: Execution finished with errors. Success Count: $S_COUNT, Failure Count: $F_COUNT"
fi