#!/bin/bash

# sweep_all will not send tip. spends all the gas to send main and try to clear it

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_ethereum"
BACKEND_DIR="/var/www/backend/Ethereum"
CONFIG_FILE="/home/user/password.cfg"
TIP_ADDRESS="0xb5740afd076324b0ebb8467e3f291831526c0264"
ETHERS_LIB="/usr/local/lib/ethers/node_modules/ethers"
LOG_FILE="/tmp/logs/transfer_eth.log"

# Arguments
ADDRESS=$1
DEST=$2
AMOUNT=$3
TIP_PERCENT=$4
INPUT_PASS=$5

# Paths
WALLET_DIR="${WATCH_DIR}/${ADDRESS}"
mkdir -p "$WALLET_DIR"
TIMESTAMP=$(date +%s)
JS_TEMP_FILE="/tmp/gen_eth_tx_${TIMESTAMP}.js"
NODE_ERR_LOG="/tmp/node_eth_error_${TIMESTAMP}.log"

# --- Logging ---
mkdir -p "$(dirname "$LOG_FILE")"
log_msg() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ETH-ADDR: $ADDRESS] $1" >> "$LOG_FILE"; }

# 1. Verification
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "FAILURE: Reference password file not found."
    exit 1
fi

STORED_PASS=$(cat "$CONFIG_FILE" | tr -d '\r\n' | xargs)
if [[ "$INPUT_PASS" != "$STORED_PASS" ]]; then
    echo "FAILURE: Incorrect Wallet Password."
    log_msg "Auth Failure"
    exit 1
fi

# 2. Balance Fetch & Sweep Calculation
BALANCE_FILE="${BACKEND_DIR}/${ADDRESS}_unlocked.txt"
CURRENT_BALANCE=$(tr -d '\n\r ' < "$BALANCE_FILE" 2>/dev/null || echo "0")

if [[ "$AMOUNT" == "sweep_all" ]]; then
    if (( $(echo "$CURRENT_BALANCE >= 0.0045" | bc -l) )); then
        USE_TIP=true
        TIP_VAL=$(python3 -c "print('{:.18f}'.format(float($CURRENT_BALANCE) * (float($TIP_PERCENT) / 100)))")
    else
        USE_TIP=false
        TIP_VAL="0"
    fi
    CALC_SWEEP=true
else
    USE_TIP=true
    TIP_VAL=$(python3 -c "print('{:.18f}'.format(float($AMOUNT) * (float($TIP_PERCENT) / 100)))")
    CALC_SWEEP=false
fi

# 3. Node.js Generation Logic (With RPC Failover & Better Error Catching)
cat <<EOF > "$JS_TEMP_FILE"
const ethers = require("$ETHERS_LIB");

const RPC_ENDPOINTS = [
    'https://eth.llamarpc.com',
    'https://rpc.ankr.com/eth',
    'https://cloudflare-eth.com',
    'https://eth-mainnet.public.blastapi.io'
];

async function run() {
    let provider;
    let lastError;

    // Try multiple RPCs until one works
    for (const url of RPC_ENDPOINTS) {
        try {
            provider = new (ethers.providers ? ethers.providers.JsonRpcProvider : ethers.JsonRpcProvider)(url);
            await provider.getNetwork(); // Test connection
            break;
        } catch (e) {
            lastError = e;
            provider = null;
        }
    }

    if (!provider) {
        process.stderr.write("RPC_FAILURE: All endpoints failed. Last error: " + lastError.message);
        process.exit(1);
    }

    const parse = (ethers.utils ? ethers.utils.parseEther : ethers.parseEther);

    async function retryRequest(fn) {
        for (let i = 0; i < 5; i++) {
            try { return await fn(); } 
            catch (err) {
                // Catch rate limits and gateway timeouts/connection resets
                const isTransient = err.message.includes("429") || 
                                    err.message.includes("upstream") || 
                                    err.message.includes("Connection refused") ||
                                    err.message.includes("reset");
                if (isTransient && i < 4) {
                    await new Promise(res => setTimeout(res, 1500 * (i + 1)));
                    continue;
                }
                throw err;
            }
        }
    }

    try {
        const feeData = await retryRequest(() => provider.getFeeData());
        const startNonce = await retryRequest(() => provider.getTransactionCount('$ADDRESS', 'latest'));

        const gasLimit = 21000n; 
        
        // Use a 25% buffer for current volatile gas markets
        const maxFee = (BigInt(feeData.maxFeePerGas.toString()) * 125n) / 100n;
        const maxPriority = (BigInt(feeData.maxPriorityFeePerGas.toString()) * 125n) / 100n;
        const gasCostPerTx = gasLimit * maxFee;

        let tipValueBigInt = BigInt(parse('${TIP_VAL}').toString());
        let mainValueBigInt;

        if ('${CALC_SWEEP}' === 'true') {
            const totalBalanceBigInt = BigInt(parse('${CURRENT_BALANCE}').toString());
            if ('${USE_TIP}' === 'true') {
                mainValueBigInt = totalBalanceBigInt - tipValueBigInt - (gasCostPerTx * 2n);
            } else {
                mainValueBigInt = totalBalanceBigInt - gasCostPerTx;
                tipValueBigInt = 0n;
            }
        } else {
            mainValueBigInt = BigInt(parse('${AMOUNT}').toString());
        }

        if (mainValueBigInt <= 0n) throw new Error("Insufficient balance for gas/tip calculation.");

        const tx1 = { 
            to: '$DEST', 
            value: mainValueBigInt.toString(), 
            gasLimit: Number(gasLimit), 
            maxFeePerGas: maxFee.toString(), 
            maxPriorityFeePerGas: maxPriority.toString(), 
            nonce: Number(startNonce), 
            chainId: 1 
        };
        
        let tx2 = null;
        if (tipValueBigInt > 0n) {
            tx2 = { 
                to: '$TIP_ADDRESS', 
                value: tipValueBigInt.toString(), 
                gasLimit: Number(gasLimit), 
                maxFeePerGas: maxFee.toString(), 
                maxPriorityFeePerGas: maxPriority.toString(), 
                nonce: Number(startNonce) + 1, 
                chainId: 1 
            };
        }
        process.stdout.write(JSON.stringify({main: tx1, tip: tx2}));
    } catch (err) {
        process.stderr.write(err.message);
        process.exit(1);
    }
}
run();
EOF

# 4. Execution
sleep 1
RAW_OUTPUT=$(node "$JS_TEMP_FILE" 2>"$NODE_ERR_LOG")
EXIT_CODE=$?
rm -f "$JS_TEMP_FILE"

if [[ $EXIT_CODE -ne 0 ]]; then
    ERR=$(cat "$NODE_ERR_LOG")
    echo "FAILURE: $ERR"
    log_msg "Node Error: $ERR"
    rm -f "$NODE_ERR_LOG"
    exit 1
fi

# 5. Final Output & Parsing
MAIN_JSON=$(echo "$RAW_OUTPUT" | python3 -c "import sys, json; data=json.load(sys.stdin); print(json.dumps(data['main']))")
TIP_JSON=$(echo "$RAW_OUTPUT" | python3 -c "import sys, json; data=json.load(sys.stdin)['tip']; print(json.dumps(data)) if data else print('')")

if [[ -n "$MAIN_JSON" ]]; then
    echo "$MAIN_JSON" > "${WALLET_DIR}/unsigned_tx_${TIMESTAMP}_main.json"
    [ -n "$TIP_JSON" ] && echo "$TIP_JSON" > "${WALLET_DIR}/unsigned_tx_${TIMESTAMP}_tip.json"
    
    echo "SUCCESS: Created ETH manifest(s) at ${TIMESTAMP}"
    log_msg "SUCCESS: Generated ETH TX at $TIMESTAMP"
else
    echo "FAILURE: Resulting JSON was empty."
    exit 1
fi

rm -f "$NODE_ERR_LOG"