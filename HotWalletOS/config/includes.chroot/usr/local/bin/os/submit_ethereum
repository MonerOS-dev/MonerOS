#!/bin/bash

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_ethereum"
LOG_FILE="/tmp/logs/submit_eth.log"

# Fallback RPC Pool for redundancy
RPC_URLS=(
    "https://eth.llamarpc.com"
    "https://rpc.ankr.com/eth"
    "https://cloudflare-eth.com"
    "https://eth-mainnet.public.blastapi.io"
)

# --- Debug Mode ---
DEBUG=true

# Counters
S_COUNT=0
F_COUNT=0

mkdir -p "$(dirname "$LOG_FILE")"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

echo "Submitting signed Ethereum Transactions via RPC Pool"

# 1. Find and sort all signed transactions
TX_LIST=$(find "$BASE_DIR" -type f -name "signed_tx_*.json" | sort -t '_' -k3 -n)

if [ -z "$TX_LIST" ]; then
    echo "SUCCESS: No Ethereum transactions to process"
    exit 0
fi

for TX_PATH in $TX_LIST; do
    DIR=$(dirname "$TX_PATH")
    SIGNED_FILE=$(basename "$TX_PATH")
    UNSIGNED_FILE=$(echo "$SIGNED_FILE" | sed 's/signed_tx_/unsigned_tx_/')
    ADDR_ID=$(basename "$DIR")

    if [ "$DEBUG" = true ]; then
        echo "------------------------------------------------"
        echo "Processing: $SIGNED_FILE ($ADDR_ID)"
    fi

    RAW_HEX=$(python3 -c "import json; print(json.load(open('$TX_PATH'))['raw'])" 2>/dev/null)

    if [ -z "$RAW_HEX" ]; then
        echo "[FAILED] $SIGNED_FILE (JSON Parse Error)"
        ((F_COUNT++))
        continue
    fi

    # --- Improved Retry Logic with RPC Failover ---
    SUCCESS_FLAG=false
    
    # We iterate through our RPC list
    for CURRENT_RPC in "${RPC_URLS[@]}"; do
        ATTEMPT=1
        MAX_ATTEMPTS=2 # 2 attempts per RPC before switching
        
        while [ $ATTEMPT -le $MAX_ATTEMPTS ]; do
            if [ "$DEBUG" = true ]; then
                echo "Trying RPC: $CURRENT_RPC (Attempt $ATTEMPT)"
            fi

            # 3. Broadcast via JSON-RPC
            RESPONSE=$(curl -s -X POST \
                -H "Content-Type: application/json" \
                -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" \
                --connect-timeout 10 \
                --max-time 20 \
                --data "{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"$RAW_HEX\"],\"id\":1}" \
                "$CURRENT_RPC")

            # Check if Response is empty or contains Proxy Errors (Upstream/Connection Refused)
            if [ -z "$RESPONSE" ] || [[ "$RESPONSE" == *"upstream connect error"* ]] || [[ "$RESPONSE" == *"Connection refused"* ]]; then
                echo "[NETWORK ERROR] RPC $CURRENT_RPC is unresponsive."
                break # Exit the 'while' and try the next RPC in the 'for' loop
            fi

            TX_HASH=$(echo "$RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('result', ''))" 2>/dev/null)

            # 4. Success Check
            if [[ "$TX_HASH" == 0x* ]]; then
                echo "[OK] $SIGNED_FILE | Hash: $TX_HASH"
                log_msg "SUCCESS: $SIGNED_FILE | Hash: $TX_HASH | RPC: $CURRENT_RPC"
                ((S_COUNT++))
                
                rm -f "$TX_PATH"
                [ -f "$DIR/$UNSIGNED_FILE" ] && rm -f "$DIR/$UNSIGNED_FILE"
                
                SUCCESS_FLAG=true
                break 2 # Break both while and the RPC for loop
            else
                # Extract Error
                ERR=$(echo "$RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); err=data.get('error', {}); print(err.get('message', 'Unknown Error') if isinstance(err, dict) else str(err))" 2>/dev/null)
                
                # --- SPECIAL CASE: Already Known / Nonce Too Low ---
                if [[ "$ERR" == *"already known"* ]] || [[ "$ERR" == *"nonce too low"* ]] || [[ "$ERR" == *"replacement transaction underpriced"* ]]; then
                    echo "[ALREADY SUBMITTED] $SIGNED_FILE"
                    log_msg "ALREADY KNOWN: $SIGNED_FILE (RPC: $CURRENT_RPC)"
                    ((S_COUNT++))
                    rm -f "$TX_PATH"
                    [ -f "$DIR/$UNSIGNED_FILE" ] && rm -f "$DIR/$UNSIGNED_FILE"
                    SUCCESS_FLAG=true
                    break 2
                fi

                echo "[FAILED ATTEMPT] RPC: $CURRENT_RPC | Error: $ERR"
                sleep 2
                ((ATTEMPT++))
            fi
        done
        
        # If we succeeded, don't try the other RPCs
        [ "$SUCCESS_FLAG" = true ] && break
    done

    if [ "$SUCCESS_FLAG" = false ]; then
        echo "[FINAL FAILURE] $SIGNED_FILE could not be submitted to any RPC."
        log_msg "FAILED: $SIGNED_FILE | All RPCs exhausted"
        ((F_COUNT++))
    fi

    sleep 1
done

echo "------------------------------------------------"
[ "$F_COUNT" -eq 0 ] && echo "SUMMARY_SUCCESS: $S_COUNT processed" || echo "SUMMARY_FAILURE: $S_COUNT ok, $F_COUNT failed"