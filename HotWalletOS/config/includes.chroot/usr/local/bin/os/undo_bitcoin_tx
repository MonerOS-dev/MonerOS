#!/bin/bash

TARGET_DIR=$1

# 1. Ensure a directory path was provided
if [ -z "$TARGET_DIR" ]; then
    echo "Error: No target directory specified."
    exit 1
fi

# 2. Safety check: Ensure the path is actually inside the watch_bitcoin base directory
BASE_DIR="/mnt/sallyport/watch_bitcoin"
if [[ "$TARGET_DIR" != "$BASE_DIR"* ]]; then
    echo "Error: Invalid path security bounds."
    exit 1
fi

# 3. Check for root/sudo privileges (needed to delete files and manage permissions)
if [[ $EUID -ne 0 ]]; then
   echo "Error: Please run with sudo"
   exit 1
fi

# 4. Find and delete the pending transaction artifacts safely
if [ -d "$TARGET_DIR" ]; then
    rm -f "$TARGET_DIR"/unsigned_tx_*
    rm -f "$TARGET_DIR"/unsigned_record_*
    rm -f "$TARGET_DIR"/tip.log
    rm -f "$TARGET_DIR"/hot_process.log
    rm -f "$TARGET_DIR"/response.json
    echo "SUCCESS: Bitcoin transaction artifacts purged."
else
    echo "Error: Directory does not exist."
    exit 1
fi