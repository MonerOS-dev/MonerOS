#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_ethereum"

echo "Getting ETH Balance"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

BACKEND_DIR="/var/www/backend/Ethereum"
RPC_URL="https://eth.llamarpc.com"

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=2

mkdir -p "$BACKEND_DIR"

fetch_balance_with_retry() {
    local addr=$1
    local attempt=1
    local result=""

    while [ $attempt -le $MAX_RETRIES ]; do
        echo "  Attempt $attempt/$MAX_RETRIES..." >&2

        # We go back to the direct execution style that worked for you
        # We just add a final grep to strip the "Promise" noise
        result=$(ethers --rpc "$RPC_URL" eval "(async () => {
            const bal = await provider.getBalance('$addr');
            console.log(utils.formatEther(bal));
        })()" 2>/dev/null | grep -E '^[0-9.]+$' | head -n 1)

        if [ -n "$result" ]; then
            echo "$result"
            return 0
        fi

        attempt=$((attempt + 1))
        sleep $RETRY_DELAY
    done

    echo ""
    return 1
}

check_balance() {
    local dir=$1
    INFO_FILE="${dir}watch_info.txt"

    if [ -f "$INFO_FILE" ]; then
        # Reverting to your original address extraction style since it worked
        ADDR=$(grep "ADDRESS:" "$INFO_FILE" | awk '{print $2}' | tr -d '\r')

        if [ -n "$ADDR" ]; then
            echo "Checking balance for: $ADDR"
            NEW_BAL=$(fetch_balance_with_retry "$ADDR")

            # Simple "not empty" check. 
            # If the RPC returns 0.0, NEW_BAL is "0.0" (not empty), so it updates.
            # If the RPC fails, NEW_BAL is "" (empty), so it skips.
            if [ -n "$NEW_BAL" ]; then
                printf "%s" "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_balance.txt" > /dev/null
                printf "%s" "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_unlocked.txt" > /dev/null
                echo "SUCCESS: Updated $ADDR to $NEW_BAL ETH"
            else
                echo "SKIPPED: RPC failed. Preserving old data."
            fi
        fi
    fi
}

# --- MAIN LOOP ---
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    check_balance "$dir"
done

echo "--- Ethereum balance refresh cycle complete ---"

# Clean up leftover Node.js processes
sudo pkill -9 node || true
