#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

BASE_DIR="/mnt/sallyport/watch_bitcoin"

echo "Getting BTC Balance"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

BACKEND_DIR="/var/www/backend/Bitcoin"

# Ensure the backend directory exists
sudo mkdir -p "$BACKEND_DIR"

# Ensure Electrum daemon is running
if ! electrum daemon status > /dev/null 2>&1; then
    echo "Starting Electrum daemon..."
    electrum daemon -d
    sleep 2
fi

for dir in "$BASE_DIR"/*/; do
    # Path to the electrum wallet file
    WALLET_PATH="${dir}electrum_watch"

    if [ -f "$WALLET_PATH" ]; then
        ADDR_ID=$(basename "$dir")
        
        echo "--------------------------------------------------"
        echo "Processing: $ADDR_ID"

        # --- RETRY LOGIC START ---
        # We try 3 times to get a valid JSON response
        for i in {1..3}; do
            # Ensure the wallet is loaded before querying
            electrum load_wallet -w "$WALLET_PATH" > /dev/null 2>&1
            
            # Query the balance
            OUTPUT=$(electrum getbalance -w "$WALLET_PATH" 2>/dev/null)

            # If OUTPUT contains a '{', it's valid JSON; break the retry loop
            if [[ "$OUTPUT" == *"{"* ]]; then
                break
            fi
            
            echo "Attempt $i failed for $ADDR_ID, retrying..."
            sleep 1
        done
        # --- RETRY LOGIC END ---

        # Extract raw values from Electrum JSON
        CONFIRMED=$(echo "$OUTPUT" | python3 -c "import sys, json; print(json.load(sys.stdin).get('confirmed', '0'))")
        UNCONFIRMED=$(echo "$OUTPUT" | python3 -c "import sys, json; print(json.load(sys.stdin).get('unconfirmed', '0'))")

        # Fallback to 0 if empty
        [ -z "$CONFIRMED" ] && CONFIRMED="0"
        [ -z "$UNCONFIRMED" ] && UNCONFIRMED="0"

        # Calculate Logic:
        TOTAL_EXPECTED=$(python3 -c "c=float('$CONFIRMED'); u=float('$UNCONFIRMED'); print(f'{c+u:.8f}'.rstrip('0').rstrip('.'))")
        ACTUALLY_SPENDABLE=$(python3 -c "c=float('$CONFIRMED'); print(f'{c:.8f}'.rstrip('0').rstrip('.'))")

        # Clean up empty/dot results to 0
        [[ -z "$TOTAL_EXPECTED" || "$TOTAL_EXPECTED" == "." ]] && TOTAL_EXPECTED="0"
        [[ -z "$ACTUALLY_SPENDABLE" || "$ACTUALLY_SPENDABLE" == "." ]] && ACTUALLY_SPENDABLE="0"

        # Save results
        printf "%s" "$TOTAL_EXPECTED" | sudo tee "${BACKEND_DIR}/${ADDR_ID}_balance.txt" > /dev/null
        printf "%s" "$ACTUALLY_SPENDABLE" | sudo tee "${BACKEND_DIR}/${ADDR_ID}_unlocked.txt" > /dev/null

        echo "Saved Total Balance (_balance): $TOTAL_EXPECTED"
        echo "Saved Spendable Balance (_unlocked): $ACTUALLY_SPENDABLE"
    fi
done

echo "--------------------------------------------------"
echo "All Bitcoin balances updated."