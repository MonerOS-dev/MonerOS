#!/bin/bash

export TERM=linux
stty sane

if [ "$TERM" = "linux" ]; then
    echo -ne "\e]P4ff0000" 
    echo -ne "\e]P7ffffff" 
    clear
fi

export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

WIFI_CFG="/mnt/external/wifi.cfg"

WIFI_IF=$(ls /sys/class/net | grep -E '^wl' | head -n 1)

if [ -z "$WIFI_IF" ]; then
    whiptail --title " Critical Error " --msgbox "No Wi-Fi interface detected." 8 50
    exit 1
fi

attempt_connection() {
    local ssid="$1"
    local pass="$2"

    systemctl stop NetworkManager 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    killall dhclient 2>/dev/null
    sleep 1

    ip link set "$WIFI_IF" up
    sleep 1

    mkdir -p /run/wpa_supplicant
    WPA_CONF="/tmp/live-wifi.conf"
    echo "ctrl_interface=DIR=/run/wpa_supplicant" > "$WPA_CONF"
    wpa_passphrase "$ssid" "$pass" >> "$WPA_CONF"

    wpa_supplicant -B -i "$WIFI_IF" -c "$WPA_CONF" -f /tmp/wpa_error.log

    local success=0
    for i in {1..15}; do
        if wpa_cli -i "$WIFI_IF" status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
            success=1
            break
        fi
        sleep 1
    done

    if [ "$success" -eq 1 ]; then
        if dhclient "$WIFI_IF"; then
            return 0
        fi
    fi

    # --- CLEANUP ON FAILURE ---
    # Kill the background daemon so it doesn't lock the interface for NetworkManager
    killall wpa_supplicant dhclient 2>/dev/null
    return 1
}

# --- 1. TRY SAVED CREDENTIALS (MAX 3 RETRIES) ---
if [ -f "$WIFI_CFG" ]; then
    SAVED_SSID=$(sed -n '1p' "$WIFI_CFG")
    SAVED_PASS=$(sed -n '2p' "$WIFI_CFG")

    if [ -n "$SAVED_SSID" ]; then
        SAVED_SUCCESS=0
        
        # Try 3 times before giving up
        for attempt in {1..3}; do
            whiptail --title " Auto-Connecting " --infobox "Connecting to saved network: $SAVED_SSID\n(Attempt $attempt of 3)..." 8 50
            
            if attempt_connection "$SAVED_SSID" "$SAVED_PASS"; then
                SAVED_SUCCESS=1
                exit 0 # Success! Return to parent script
            fi
            
            sleep 3
        done

        # If 3 attempts failed, remove stale config and notify user
        if [ "$SAVED_SUCCESS" -eq 0 ]; then
            rm -f "$WIFI_CFG"
            whiptail --title " Saved Network Unavailable " --msgbox "Could not connect to '$SAVED_SSID'.\n\nPlease select a new network manually." 8 50
        fi
    fi
fi

# --- CLEANUP BEFORE INTERACTIVE SCAN ---
# Kill wpa_supplicant so it releases the Wi-Fi card back to NetworkManager
killall wpa_supplicant dhclient 2>/dev/null
systemctl restart NetworkManager 2>/dev/null
sleep 2

# --- 2. INTERACTIVE SETUP (Runs if no saved config or if saved network failed) ---

while true; do
    clear
    systemctl start NetworkManager 2>/dev/null
    nmcli radio wifi on
    sleep 2
    
    SSID_LIST=$(nmcli -t -f SSID dev wifi list | grep -v '^--' | grep -v '^$' | sort -u)

    if [ -z "$SSID_LIST" ]; then
        whiptail --title " Error " --msgbox "No Wi-Fi networks found. Scanning again..." 8 50
        continue 
    fi

    WHIPTAIL_OPTIONS=()
    while IFS= read -r line; do
        WHIPTAIL_OPTIONS+=("$line" "")
    done <<< "$SSID_LIST"

    CHOSEN_SSID=$(whiptail --fb --title " Wi-Fi Setup " \
        --menu "\nChoose Network\n" 16 50 5 \
        "${WHIPTAIL_OPTIONS[@]}" 3>&1 1>&2 2>&3)

    [ -z "$CHOSEN_SSID" ] && continue

    PASS=$(whiptail --fb --title " Authentication " \
        --passwordbox "Connecting to: $CHOSEN_SSID\n\nEnter Password:" 12 50 3>&1 1>&2 2>&3)

    [ -z "$PASS" ] && continue

    whiptail --title " Connecting " --infobox "Authenticating with $CHOSEN_SSID..." 8 50

    if attempt_connection "$CHOSEN_SSID" "$PASS"; then
        # Save new credentials for next boot
        mkdir -p "$(dirname "$WIFI_CFG")"
        echo "$CHOSEN_SSID" > "$WIFI_CFG"
        echo "$PASS" >> "$WIFI_CFG"
        chmod 600 "$WIFI_CFG"
        
        exit 0 # Success!
    else
        whiptail --title " Connection Failed " --msgbox "Failed to connect. Please check password and try again." 8 50
        
        # Bring NetworkManager cleanly back to life before scanning again
        systemctl restart NetworkManager 2>/dev/null
        sleep 3
        continue
    fi
done