#!/bin/bash

export TERM=linux
stty sane

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

# 2. ASSIGN NEWT COLORS
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

WIFI_CFG="/mnt/external/wifi.cfg"

# --- THE HARD LOCK LOOP ---
while true; do
    clear  # Keep the background clean

    # 1. Try saved credentials first
    if [ -f "$WIFI_CFG" ]; then
        # Read Line 1 as SSID, Line 2 as PASS
        SAVED_SSID=$(sed -n '1p' "$WIFI_CFG")
        SAVED_PASS=$(sed -n '2p' "$WIFI_CFG")

        nmcli radio wifi on
        
        # RETRY LOOP: Try 3 times before giving up on saved credentials
        SUCCESS=0
        for attempt in {1..3}; do
            # Removed the invalid '--ask no' flag
            if [ -n "$SAVED_SSID" ] && nmcli dev wifi connect "$SAVED_SSID" password "$SAVED_PASS" >/dev/null 2>&1; then
                
                # Force connection to be system-wide to bypass user-level Polkit checks
                nmcli connection modify "$SAVED_SSID" \
                    connection.permissions "" \
                    connection.autoconnect yes \
                    connection.autoconnect-retries 0 \
                    connection.autoconnect-priority 10 \
                    ipv4.dhcp-timeout 30 \
                    ipv4.may-fail no
                SUCCESS=1
                break
            fi
            sleep 3 
        done

        if [ "$SUCCESS" -eq 1 ]; then
            exit 0
        fi
        
        # If saved credentials consistently fail after 3 tries, remove file and alert user
        rm -f "$WIFI_CFG"
        whiptail --title " Connection Failed " --msgbox "Saved credentials in wifi.cfg failed consistently. Please select network manually." 0 0
    fi

    # 2. Scan for Networks
    nmcli radio wifi on
    sleep 1
    SSID_LIST=$(nmcli -t -f SSID dev wifi list | grep -v '^--' | grep -v '^$' | sort -u)

    if [ -z "$SSID_LIST" ]; then
        whiptail --title " Error " --msgbox "No Wi-Fi networks found. Scanning again..." 0 0
        continue 
    fi

    # 3. Build Menu
    WHIPTAIL_OPTIONS=()
    while IFS= read -r line; do
        WHIPTAIL_OPTIONS+=("$line" "")
    done <<< "$SSID_LIST"

    CHOSEN_SSID=$(whiptail --fb --title " Wi-Fi Setup " \
        --menu "\nChoose Network\n" 16 50 5 \
        "${WHIPTAIL_OPTIONS[@]}" 3>&1 1>&2 2>&3)

    if [ -z "$CHOSEN_SSID" ]; then
        continue
    fi
    
    # 4. Get password
    PASS=$(whiptail --fb --title " Authentication " \
        --passwordbox "Connecting to: $CHOSEN_SSID\n\nEnter Password:" 12 50 3>&1 1>&2 2>&3)

    if [ -z "$PASS" ]; then
        continue
    fi

    # 5. Attempt Connection & Apply Aggressive Persistence
    # Removed the invalid '--ask no' flag
    if nmcli dev wifi connect "$CHOSEN_SSID" password "$PASS"; then
    
        # connection.permissions "" makes this a global system connection, avoiding user prompts
        nmcli connection modify "$CHOSEN_SSID" \
            connection.permissions "" \
            connection.autoconnect yes \
            connection.autoconnect-retries 0 \
            connection.autoconnect-priority 10 \
            ipv4.dhcp-timeout 30 \
            ipv4.may-fail no
        
        # Save using NEWLINES to wifi.cfg
        mkdir -p "$(dirname "$WIFI_CFG")"
        {
          echo "$CHOSEN_SSID"
          echo "$PASS"
        } > "$WIFI_CFG"
        chmod 600 "$WIFI_CFG"
        
        exit 0
    else
        whiptail --title " Failure " --msgbox "Connection failed. Check the password and try again." 0 0
    fi
done