#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

BASE_DIR="/mnt/sallyport/watch_monero"

echo "Getting XMR Balance"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

PASS_FILE="/home/user/password.cfg"
REMOTE_NODE="cky2cwjjqchgqebbuheikewr26wy54wg3x637e3wc63mo33p4hhsu4qd.onion:18081"
TOR_PROXY="127.0.0.1:9050"
BACKEND_DIR="/var/www/backend/Monero"

# Read password from file
if [ -f "$PASS_FILE" ]; then
    PASSWORD=$(tr -d '\n\r' < "$PASS_FILE")
else
    echo "Error: Password file not found at $PASS_FILE"
    exit 1
fi

# --- CONNECTION & CONDITIONAL RECOVERY START ---
MAX_RETRIES=3
RETRY_COUNT=0
CONNECTED=false

echo "Checking connection to Monero Node ($REMOTE_NODE) via Tor..."

while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    # 1. Attempt Connection
    if curl -m 15 -s -f --socks5-hostname "$TOR_PROXY" "http://$REMOTE_NODE/get_info" > /dev/null; then
        echo "Successfully connected to the node."
        CONNECTED=true
        break
    else
        RETRY_COUNT=$((RETRY_COUNT + 1))
        echo "Attempt $RETRY_COUNT failed."

        # 2. Sequential "Soft" Fixes
        if [ $RETRY_COUNT -lt $MAX_RETRIES ]; then
            echo "Refreshing Tor circuits (SIGHUP) and retrying in 15s..."
            sudo killall -HUP tor
            sleep 15
        fi
    fi
done

# 3. CRITICAL FAILURE RECOVERY (The "Last Resort")
# Only runs if the above loop failed completely.
if [ "$CONNECTED" = false ]; then
    echo "Connection failed. Initiating deep recovery..."

    # Re-sync time ONLY now, because if Tor is failing, 
    # certificate expiration due to clock skew is a likely culprit.
    echo "Emergency time sync..."
    TIME=$(curl -sI --connect-timeout 5 http://deb.debian.org | grep -i '^Date:' | cut -d' ' -f2-)
    if [ -n "$TIME" ]; then
        sudo date -s "$TIME" > /dev/null
        sudo hwclock --systohc
        echo "Clock re-verified."
    fi

    # Full service reset
    echo "Restarting Tor service..."
    sudo systemctl restart tor
    
    echo "Waiting 25s for circuit establishment..."
    sleep 25
    
    # Final "Hail Mary" attempt
    if curl -m 30 -s -f --socks5-hostname "$TOR_PROXY" "http://$REMOTE_NODE/get_info" > /dev/null; then
        echo "Deep recovery successful! Connection established."
        CONNECTED=true
    fi
fi

if [ "$CONNECTED" = false ]; then
    echo "FAILURE: Connection unreachable after time-sync and service reset."
    exit 1
fi
# --- CONNECTION & CONDITIONAL RECOVERY END ---

for dir in "$BASE_DIR"/*/; do
    # 'watchonly' is the filename inside each folder
    WALLET_FILE="${dir}watchonly"

    if [ -f "$WALLET_FILE" ]; then
        # Get the address from the folder name to use for the output files
        ADDR_ID=$(basename "$dir")
        
        echo "--------------------------------------------------"
        echo "Processing: $ADDR_ID"

        # Capturing the full output once so we can get both balances
        OUTPUT=$(echo -e "balance\nexit" | monero-wallet-cli \
            --wallet-file "$WALLET_FILE" \
            --password "$PASSWORD" \
            --daemon-address "$REMOTE_NODE" \
            --proxy "$TOR_PROXY" \
            --trusted-daemon)

        # Extraction logic using your exact sed/grep method
        BALANCE=$(echo "$OUTPUT" | grep "Balance:" | sed -n 's/.*Balance: \([0-9.]*\).*/\1/p' | head -n 1)
        UNLOCKED=$(echo "$OUTPUT" | grep "unlocked balance:" | sed -n 's/.*unlocked balance: \([0-9.]*\).*/\1/p' | head -n 1)

        # Fallback to 0 if empty
        [ -z "$BALANCE" ] && BALANCE="0"
        [ -z "$UNLOCKED" ] && UNLOCKED="0"

        # Save results to your specific backend files using the address name
        printf "%s" "$BALANCE" | sudo tee "${BACKEND_DIR}/${ADDR_ID}_balance.txt" > /dev/null
        printf "%s" "$UNLOCKED" | sudo tee "${BACKEND_DIR}/${ADDR_ID}_unlocked.txt" > /dev/null

        echo "Balance: $BALANCE"
        echo "Unlocked: $UNLOCKED"
    fi
done

# Clean up any hanging processes
pkill -f monero-wallet-cli 2>/dev/null || true