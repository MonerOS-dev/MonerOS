#!/bin/bash
# --- /usr/local/bin/os/get_monero_balance ---
export PATH=/usr/bin:/bin:/usr/local/bin

BASE_DIR="/mnt/sallyport/watch_monero"
BACKEND_DIR="/var/www/backend/Monero"
sudo mkdir -p "$BACKEND_DIR"






# --- PRE-FLIGHT MASTER NODE HEALTH CHECK ---
NODE_CACHE_FILE="/home/user/monero_node.txt"
PROXY="127.0.0.1:9050" # Adjust to your Tor proxy if different

if [ -f "$NODE_CACHE_FILE" ]; then
    ACTIVE_NODE=$(cat "$NODE_CACHE_FILE" | tr -d '\n\r ')
else
    ACTIVE_NODE="127.0.0.1:18081"
fi

#echo "Verifying master node health before processing balances ($ACTIVE_NODE)..."

if [[ "$ACTIVE_NODE" == "127.0.0.1"* ]] || [[ "$ACTIVE_NODE" == "localhost"* ]]; then
    MASTER_CURL="curl -m 15 -s -f"
elif [[ "$ACTIVE_NODE" == *".onion"* ]]; then
    MASTER_CURL="curl -m 30 -s -f --socks5-hostname $PROXY"
else
    MASTER_CURL="curl -m 15 -s -f"
fi

if ! $MASTER_CURL "http://$ACTIVE_NODE/get_info" > /dev/null; then
    echo "[CRITICAL] Master node ($ACTIVE_NODE) is unreachable! Invoking recovery..."
    whiptail --msgbox "Selected node appears to be down or address is incorrect. Please try again" 0 0 </dev/tty1 >/dev/tty1
    sudo bash /usr/local/bin/os/reconfigure_monero
    
    # Re-read cache after recovery
    [ -f "$NODE_CACHE_FILE" ] && ACTIVE_NODE=$(cat "$NODE_CACHE_FILE" | tr -d '\n\r ')
    
    if ! $MASTER_CURL "http://$ACTIVE_NODE/get_info" > /dev/null; then
        echo "[FATAL] Recovery failed or node still down. Aborting balance run."
        exit 1
    fi
fi





echo "Querying Persistent Monero RPC Daemons..."

for dir in "$BASE_DIR"/*/; do
    WALLET_FILE="${dir}watchonly"
    PORT_FILE="${dir}rpc_port.cfg"

    # Safely skip directories that are still initializing or missing configurations
    if [ -f "$WALLET_FILE" ] && [ -f "$PORT_FILE" ]; then
        ADDR_ID=$(basename "$dir")
        RPC_PORT=$(cat "$PORT_FILE" | tr -d '\n\r ')
        BALANCE_FILE="${BACKEND_DIR}/${ADDR_ID}_balance.txt"
        UNLOCKED_FILE="${BACKEND_DIR}/${ADDR_ID}_unlocked.txt"
        
        echo "--------------------------------------------------"
        echo "Querying: $ADDR_ID on Port $RPC_PORT"

        # --- HARDENED POLLING HEALTH CHECK LOOP ---
        DAEMON_ONLINE=false
        ATTEMPT=0
        MAX_ATTEMPTS=12  # 12 attempts * 10 seconds = 2 minutes maximum wait time

        while [ "$DAEMON_ONLINE" = false ] && [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
            ((ATTEMPT++))
            
            # Request basic status verification to test if socket queue is clear
            if curl -s -m 5 http://127.0.0.1:$RPC_PORT/json_rpc -o /dev/null; then
                DAEMON_ONLINE=true
            else
                if [ $ATTEMPT -eq 1 ]; then
                    echo "[NOTICE] Daemon on port $RPC_PORT is processing crypto data. Holding pipeline..."
                fi
                echo "Waiting for daemon responsiveness... (Attempt $ATTEMPT/$MAX_ATTEMPTS)"
                sleep 10
            fi
        done

        # If the daemon completely fails to respond after 2 minutes, skip out safely
        if [ "$DAEMON_ONLINE" = false ]; then
            echo "[WARNING] Daemon on port $RPC_PORT remained offline or unresponsive after $MAX_ATTEMPTS attempts. Retaining old logs."
            continue
        fi

        # 2. Query the running daemon directly (now guaranteed responsive)
        RPC_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc \
            -d '{"jsonrpc":"2.0","id":"0","method":"get_balance","params":{"account_index":0,"all_accounts":true}}')
        
        # 3. HARDENED EXTRACTION 
        CLEAN_JSON=$(echo "$RPC_RESPONSE" | tr -d '\n\r ')
        
        # Verify JSON signature integrity to prevent wiping backend logs on empty payloads
        if echo "$CLEAN_JSON" | grep -q '"result":'; then
            RAW_BAL=$(echo "$CLEAN_JSON" | grep -oP '"result":\{"balance":\K[0-9]+')
            RAW_UNL=$(echo "$CLEAN_JSON" | grep -oP '"unlocked_balance":\K[0-9]+' | tail -n1)

            # Fallback values if fields parse empty
            [ -z "$RAW_BAL" ] && RAW_BAL=0
            [ -z "$RAW_UNL" ] && RAW_UNL=0

            # 4. MATH CONVERSIONS
            BALANCE=$(echo "scale=12; $RAW_BAL / 1000000000000" | bc | awk '{printf "%.12f\n", $0}')
            UNLOCKED=$(echo "scale=12; $RAW_UNL / 1000000000000" | bc | awk '{printf "%.12f\n", $0}')

            OLD_BALANCE="0.000000000000"
            [ -f "$BALANCE_FILE" ] && OLD_BALANCE=$(cat "$BALANCE_FILE")

            # Save updates to backend web directories
            printf "%s" "$BALANCE" | sudo tee "$BALANCE_FILE" > /dev/null
            printf "%s" "$UNLOCKED" | sudo tee "$UNLOCKED_FILE" > /dev/null

            # === INSERT PERMISSION FIX HERE ===
            sudo chown www-data:www-data "$BALANCE_FILE" "$UNLOCKED_FILE"
            sudo chmod 644 "$BALANCE_FILE" "$UNLOCKED_FILE"
            # ==================================

            echo "Status: Total Balance: $BALANCE XMR | Unlocked: $UNLOCKED XMR"
        else
            echo "[ERROR] Invalid RPC response received on port $RPC_PORT. Skipping file updates."
        fi
    fi
done