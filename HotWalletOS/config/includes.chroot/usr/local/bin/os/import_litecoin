#!/bin/bash
# /usr/local/bin/os/import_litecoin

if [[ $EUID -ne 0 ]]; then
   echo "FAILURE: This script must be run as root (use sudo)"
   exit 1
fi

BASE_DIR="/mnt/sallyport/watch_litecoin"

echo "Importing Litecoin"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

LTC_DATA_DIR="/home/user/.litecoin"
LTC_CLI="/usr/local/bin/litecoin-cli -datadir=$LTC_DATA_DIR -rpcwallet=sallyport"

# --- RAM Management: Shutdown Function ---
cleanup() {
    echo "Shutting down Litecoin daemon to save RAM..."
    # We call stop through the CLI
    /usr/local/bin/litecoin-cli -datadir=$LTC_DATA_DIR stop > /dev/null 2>&1
    # Wait for process to actually exit
    while pgrep -x "litecoind" > /dev/null; do sleep 1; done
    echo "Daemon stopped."
}
trap cleanup EXIT # This triggers cleanup when the script ends

# 1. Start Daemon if not running
if ! pgrep -x "litecoind" > /dev/null; then
    echo "Starting Litecoin daemon..."
    su - user -c "litecoind -daemon"
    echo "Waiting for RPC..."
    until /usr/local/bin/litecoin-cli -datadir=$LTC_DATA_DIR getblockchaininfo > /dev/null 2>&1; do
        echo -n "."
        sleep 2
    done
    echo " Ready."
fi

# 2. Ensure the 'sallyport' wallet exists
if ! /usr/local/bin/litecoin-cli -datadir=$LTC_DATA_DIR loadwallet "sallyport" > /dev/null 2>&1; then
    /usr/local/bin/litecoin-cli -datadir=$LTC_DATA_DIR createwallet "sallyport" true > /dev/null 2>&1
fi

# 3. Process Folders
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    if [ -f "${dir}watch_info.txt" ]; then
        CLEAN_DIR="${dir%/}"
        ADDR_FOLDER=$(basename "$CLEAN_DIR")
        ADDR=$(grep "ADDRESS:" "${dir}watch_info.txt" | awk '{print $2}' | tr -d '\r')
        [ -z "$ADDR" ] && continue

        echo "--------------------------------------------------"
        echo "Processing Folder: $ADDR_FOLDER"

        CHECK=$($LTC_CLI getaddressinfo "$ADDR" 2>/dev/null | grep "iswatchonly" | grep "true")
        if [ -z "$CHECK" ]; then
            echo "Importing $ADDR to Litecoin Core..."
            $LTC_CLI importaddress "$ADDR" "$ADDR_FOLDER" false
            echo "Success: $ADDR_FOLDER is now being watched."
        else
            echo "Address already watched. Skipping."
        fi

        echo "Generating transfer page..."
        sudo bash /usr/local/bin/os/generate_litecoin_tx_page "$ADDR_FOLDER"
    fi
done

echo "--------------------------------------------------"
echo "Submitting pending Litecoin transactions..."
# Assuming this script handles its own CLI calls
sudo bash /usr/local/bin/os/submit_litecoin 

# Cleanup will run now automatically because of 'trap'