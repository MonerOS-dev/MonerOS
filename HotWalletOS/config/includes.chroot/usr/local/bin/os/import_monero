#!/bin/bash

# Check for root privileges
if [[ $EUID -ne 0 ]]; then
   echo "FAILURE: This script must be run as root (use sudo)"
   exit 1
fi

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

# 2. ASSIGN NEWT COLORS
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# --- 1. BLOCK KEYBOARD INTERRUPTS ---
# This forces the script to ignore Ctrl+C (SIGINT) and Ctrl+Z (SIGTSTP)
trap '' SIGINT SIGTSTP

# Define target file container context here so cryptsetup knows what to test
TARGET_FILE="/mnt/external/sallyport.bin"

while true; do
    # Force whiptail to bind directly to the hardware terminal you claimed at boot
    PASSWORD=$(whiptail --passwordbox --fb --nocancel "\nEnter Master Password" 10 50 3>&1 1>&2 2>&3 </dev/tty1 >/dev/tty1)
    STATUS=$?
    
    if [ $STATUS -ne 0 ]; then
        whiptail --fb --msgbox "Input cancelled or failed. Please try again." 9 50 </dev/tty1 >/dev/tty1
        continue
    fi
    
    if [ -z "$PASSWORD" ]; then
        whiptail --fb --msgbox "Password cannot be blank. Please try again." 9 50 </dev/tty1 >/dev/tty1
        continue
    fi
    
    # Test the passphrase using the verified syntax
    if printf '%s' "$PASSWORD" | sudo cryptsetup open --type luks --test-passphrase "$TARGET_FILE" -d - > /dev/null 2>&1; then
        # Success! Clear the screen and proceed with $PASSWORD intact
        clear
        break
    else
        whiptail --fb --msgbox "Incorrect password. Please try again." 9 50 </dev/tty1 >/dev/tty1
        unset PASSWORD
    fi
done

clear

BASE_DIR="/mnt/sallyport/watch_monero"
PROXY="127.0.0.1:9050"
BACKEND_DIR="/var/www/backend/Monero"

if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet directory does not exist. Exiting."
    exit 0
else
    # Global permission reset
    sudo chown -R user:user "$BASE_DIR"
    
    # NEW: Cleanup logs
    echo "Cleaning up old log files..."
    find "$BASE_DIR" -name "rpc_daemon.log" -type f -delete
	  find "$BASE_DIR" -name "monero-wallet-rpc.log" -type f -delete
fi

echo "Importing Monero - Initializing Node Selection"



# --- GLOBAL PORT MAPPING PASS ---
# Bash naturally expands globs alphabetically. 
# The lowest alphabetical folder gets 18084, the next gets 18085, etc.

echo "Re-indexing wallet RPC ports alphabetically..."
START_PORT=18084
CURRENT_PORT=$START_PORT

# Prevent empty base directory from breaking the loop evaluation
shopt -s nullglob

for map_dir in "$BASE_DIR"/*/; do
    # We map the port regardless of whether 'watchonly' exists yet, 
    # ensuring the port assignment is permanently locked to this folder name.
    echo "$CURRENT_PORT" > "${map_dir}rpc_port.cfg"
    CURRENT_PORT=$((CURRENT_PORT + 1))
done

shopt -u nullglob
echo "Port mapping complete. Proceeding to node selection..."



# --- MASTER NODE SELECTION (SMART LOCAL DETECTION) ---
LOCAL_TOR_NODE="127.0.0.1:18081"
CUSTOM_REMOTE_PATH="/mnt/external/remote_node.cfg"

# Check if a local Monero daemon is actively listening on port 18081
if ss -tln | grep -q ":18081 "; then
    echo "[*] Local Monero node detected active on 18081. Defaulting to Self-Sync."
    REMOTE_NODE="$LOCAL_TOR_NODE"
# Otherwise, fall back to the remote config if it exists
elif [ -f "$CUSTOM_REMOTE_PATH" ] && [ -n "$(cat "$CUSTOM_REMOTE_PATH" | tr -d '[:space:]')" ]; then
    REMOTE_NODE=$(cat "$CUSTOM_REMOTE_PATH" | tr -d '\n\r ')
    echo "[*] Remote node configuration found: $REMOTE_NODE"
else
    echo "[!] No local node active and no remote config found. Defaulting to: $LOCAL_TOR_NODE"
    REMOTE_NODE="$LOCAL_TOR_NODE"
fi

# Keep the cache file in sync for downstream script dependencies
NODE_CACHE_FILE="/home/user/monero_node.txt"
echo "$REMOTE_NODE" > "$NODE_CACHE_FILE"

# Final verification
echo "Active Node: $REMOTE_NODE"


# --- RESILIENT CONNECTION & RECOVERY START ---
CONNECTED=false
ATTEMPT=0
FAIL_FILE="/home/user/node.fail"

while [ "$CONNECTED" = false ]; do
    
    # Re-evaluate node type and build CURL_CMD dynamically 
    if [[ "$REMOTE_NODE" == "127.0.0.1"* ]] || [[ "$REMOTE_NODE" == "localhost"* ]]; then
        CURL_CMD="curl -m 45 -s -f"
        echo "Checking connection to LOCAL Monero Node ($REMOTE_NODE)..."
    elif [[ "$REMOTE_NODE" == *".onion"* ]]; then
        CURL_CMD="curl -m 45 -s -f --socks5-hostname $PROXY"
        echo "Checking connection to REMOTE Monero Node ($REMOTE_NODE) via Tor..."
    else
        # Clearnet Remote Address -> Direct connection, no proxy
        CURL_CMD="curl -m 45 -s -f"
        echo "Checking connection to REMOTE Clearnet Monero Node ($REMOTE_NODE)..."
    fi

    ATTEMPT=$((ATTEMPT + 1))
    
    if $CURL_CMD "http://$REMOTE_NODE/get_info" > /dev/null; then
        echo "Successfully connected to the node on attempt $ATTEMPT."
        CONNECTED=true
        # Reset failure log to 0 on success
        echo "0" > "$FAIL_FILE"
    else
        echo "Attempt $ATTEMPT failed. Node unreachable."
        
        # Log current attempt count
        echo "$ATTEMPT" > "$FAIL_FILE"
        
        if [ $ATTEMPT -ge 5 ]; then
             echo "FAILURE: Selected node is down. Running recovery script..."
             whiptail --msgbox "Selected node appears to be down or the address is incorrect. Please try again" 0 0 </dev/tty1 >/dev/tty1
             
             sudo bash /usr/local/bin/os/reconfigure_monero
             
             echo "Recovery script finished. Re-evaluating node selection and restarting loop..."
             
             # Re-run Master Node Selection in case recovery changed the node/config
             if ss -tln | grep -q ":18081 "; then
                 REMOTE_NODE="$LOCAL_TOR_NODE"
             elif [ -f "$CUSTOM_REMOTE_PATH" ] && [ -n "$(cat "$CUSTOM_REMOTE_PATH" | tr -d '[:space:]')" ]; then
                 REMOTE_NODE=$(cat "$CUSTOM_REMOTE_PATH" | tr -d '\n\r ')
             else
                 REMOTE_NODE="$LOCAL_TOR_NODE"
             fi
             echo "$REMOTE_NODE" > "$NODE_CACHE_FILE"

             # Reset state to restart from the beginning
             ATTEMPT=0
             echo "0" > "$FAIL_FILE"
             sleep 5
             continue
        fi

        # Only SIGHUP Tor if we are actually trying to reach a Tor onion node
        if [[ "$CURL_CMD" == *"--socks5-hostname"* ]]; then
            echo "Refreshing Tor circuits (SIGHUP) and retrying..."
            killall -HUP tor 2>/dev/null || systemctl reload tor
        fi
        sleep 15
    fi
done

# Ensure backend directory exists
mkdir -p "$BACKEND_DIR"

# Prevent empty base directory from breaking the loop evaluation
shopt -s nullglob

# --- THE GRAND RESET ---
# Kill any lingering processes ONCE before starting the loop
echo "Performing global wallet lock reset..."
sudo pkill -9 monero-wallet-rpc 2>/dev/null
sudo pkill -9 monero-wallet-cli 2>/dev/null
# Delete all lock files across the entire directory tree
find "$BASE_DIR" -name "*.keys.lock" -type f -delete
sleep 2

# Prevent empty base directory from breaking the loop evaluation
shopt -s nullglob

for dir in "$BASE_DIR"/*/; do
    if [ -f "${dir}watch_info.txt" ]; then
        echo "--------------------------------------------------"
        echo "Processing Folder: $(basename "$dir")"
        
        # We don't need pkill inside the loop anymore! 
        # The start of the script cleared the path.

        cd "$dir" || continue

        ABS_DIR=$(pwd)
        
        # 1. READ THE PRE-ASSIGNED PORT IMMEDIATELY
        RPC_PORT=$(cat "rpc_port.cfg" | tr -d '\n\r ')
        fuser -k "$RPC_PORT/tcp" 2>/dev/null
        
        ADDR=$(grep "ADDRESS:" watch_info.txt | awk '{print $2}' | tr -d '\r')
        VIEW=$(grep "VIEW_KEY:" watch_info.txt | awk '{print $2}' | tr -d '\r')
        R_DATE=$(grep "RESTORE_DATE:" watch_info.txt | awk '{print $2}' | tr -d '\r')

        # --- WALLET GENERATION FLOW ---
        if [ ! -f "watchonly.keys" ]; then
            echo "Wallet keys not found. Rebuilding watch-only cache container for $ADDR..."
            export REMOTE_NODE PROXY PASSWORD ADDR VIEW R_DATE
            /usr/bin/expect <<'EOF'
set timeout -1
set NODE $env(REMOTE_NODE)
set PRX  $env(PROXY)
set PASS $env(PASSWORD)
set ADR  $env(ADDR)
set VW   $env(VIEW)
set DT   $env(R_DATE)

# Dynamic string evaluation to drop the proxy flag if running on local node/self
if {[string match "*.onion*" $NODE]} {
    spawn monero-wallet-cli --generate-from-view-key watchonly_TEMP --daemon-address $NODE --proxy $PRX --trusted-daemon
} {
    spawn monero-wallet-cli --generate-from-view-key watchonly_TEMP --daemon-address $NODE --trusted-daemon
}

expect "Standard address:"
send "$ADR\r"
expect "Secret view key:"
send "$VW\r"
expect "Enter a new password for the wallet:"
send "$PASS\r"
expect "Confirm password:"
send "$PASS\r"
expect "*alternatively from specific date (YYYY-MM-DD):"
send "$DT\r"
expect "*Is this okay?*"
send "y\r"
expect "*Do you want to do it now?*"
send "n\r"
expect "Background refresh thread started"
sleep 2
send "exit\r"
expect eof
EOF

            if [ -f "watchonly_TEMP.keys" ]; then
                mv "watchonly_TEMP.keys" "watchonly.keys"
                [ -f "watchonly_TEMP" ] && mv "watchonly_TEMP" "watchonly"
            fi
            
            # Clean up short-lived interactive processes safely
            pkill -x monero-wallet-cli 2>/dev/null || true
        fi
        
        # Clean up permissions and locks for the current folder
        chown -R user:user .
        rm -f *.keys.lock
        
        # --- RPC DAEMON SPIN-UP & HEALTH VERIFICATION LOOP ---
        RPC_READY=false

        while [ "$RPC_READY" = false ]; do
            
            # Kill any stale process holding this specific port first
            fuser -k "$RPC_PORT/tcp" 2>/dev/null
            sleep 1

            echo "Launching persistent RPC daemon on pre-assigned port $RPC_PORT..."
            
            RPC_PROXY_FLAG=""
            if [[ "$REMOTE_NODE" == *".onion"* ]]; then
                RPC_PROXY_FLAG="--proxy $PROXY"
            fi
            
            # Give Tor a brief moment to ensure circuit readiness
            sleep 2
            
            sudo -u user PASSWORD="$PASSWORD" monero-wallet-rpc \
                --wallet-file "watchonly" \
                --password "$PASSWORD" \
                --rpc-bind-port "$RPC_PORT" \
                --daemon-address "$REMOTE_NODE" \
                $RPC_PROXY_FLAG \
                --trusted-daemon \
                --disable-rpc-login \
                --shared-ringdb-dir /home/user/.shared-ringdb \
                --log-file "rpc_daemon.log" >/dev/null 2>&1 &
                
            sleep 3
            
            # Optimized Health Verification Loop (Polling HTTP API directly)
            echo "Verifying Monero Wallet RPC initialization state..."
            echo "This may take a while..."
            MAX_RETRIES=300   # 5 minutes per retry cycle for faster recovery
            RETRY_COUNT=0
            
            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
                HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X POST http://127.0.0.1:$RPC_PORT/json_rpc \
                    -d '{"jsonrpc":"2.0","id":"0","method":"get_height"}' \
                    -H 'Content-Type: application/json')
                
                if [ "$HTTP_STATUS" -eq 200 ] || [ "$HTTP_STATUS" -eq 401 ]; then
                    echo "RPC daemon confirmed active on port $RPC_PORT (HTTP status: $HTTP_STATUS)."
                    RPC_READY=true
                    break
                else
                    ((RETRY_COUNT++))
                    sleep 1
                fi
            done
            
            # If it failed to respond after max retries, force-kill and retry the outer loop iteration
            if [ "$RPC_READY" = false ]; then
                echo "[WARNING] RPC daemon on port $RPC_PORT failed to come online. Restarting process..."
                pkill -f "monero-wallet-rpc.*--rpc-bind-port $RPC_PORT" 2>/dev/null
                sleep 2
                continue
            fi
            
            # Break out of the spin-up wrapper once confirmed ready
            break
        done

        # --- UNIVERSAL SYNC LOOP ---
        echo "Synchronizing wallet with daemon..."
        SYNCED=false
        while [ "$SYNCED" = false ]; do
            # 1. Always query the LOCAL Wallet RPC (no proxy needed)
            CURRENT_HEIGHT=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc \
                -d '{"jsonrpc":"2.0","id":"0","method":"get_height"}' | jq -r '.result.height // empty')
            
            # 2. Query the DAEMON (Local or Remote)
            if [[ "$REMOTE_NODE" == *".onion"* ]]; then
                DAEMON_RESP=$(curl -s -m 45 --socks5-hostname "$PROXY" -X POST "http://$REMOTE_NODE/json_rpc" \
                    -d '{"jsonrpc":"2.0","id":"0","method":"get_info"}')
            else
                DAEMON_RESP=$(curl -s -m 20 -X POST "http://$REMOTE_NODE/json_rpc" \
                    -d '{"jsonrpc":"2.0","id":"0","method":"get_info"}')
            fi
            
            # 3. Handle 'target_height: 0' logic (Common on synced nodes)
            T_HT=$(echo "$DAEMON_RESP" | jq -r '.result.target_height // 0')
            R_HT=$(echo "$DAEMON_RESP" | jq -r '.result.height // 0')

            if [ "$T_HT" -gt "$R_HT" ]; then
                TARGET_HEIGHT=$T_HT
            else
                TARGET_HEIGHT=$R_HT
            fi
        
            # 4. Validation and Comparison
            if [[ "$CURRENT_HEIGHT" =~ ^[0-9]+$ ]] && [[ "$TARGET_HEIGHT" =~ ^[0-9]+$ ]] && [ "$TARGET_HEIGHT" -gt 0 ]; then
                echo "Progress: Wallet ($CURRENT_HEIGHT) / Daemon ($TARGET_HEIGHT)"
                if [ "$CURRENT_HEIGHT" -ge "$TARGET_HEIGHT" ]; then
                    echo "[OK] Wallet blockchain sync matches remote network top."
                    SYNCED=true
                fi
            else
                echo "[DEBUG] Waiting for valid height data... (Is the node or Tor responsive?)"
                # If we have a response but it's empty, it might be a dead Tor circuit
                if [ -z "$DAEMON_RESP" ] && [[ "$REMOTE_NODE" == *".onion"* ]]; then
                    echo "    -> Empty response from Onion node. Refreshing Tor..."
                    killall -HUP tor 2>/dev/null
                fi
            fi
            
            [ "$SYNCED" = false ] && sleep 10
        done
        
        # 1. Update the chain state
    		curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"refresh"}' >/dev/null
    
    		# 2. Reconcile spending with the updated chain
    		curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"rescan_spent"}' >/dev/null
    
    		# 3. Query the actual, updated balance
    		curl -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"get_balance"}'

        # ========================================================
        # BATCH IMPORT
        # ========================================================
        TARGET_KI_FILE="./key_images.json"

        if [ -f "$TARGET_KI_FILE" ]; then
            echo "Parsing key images from existing response object..."

            # Extract ONLY the array we need to send to the daemon
            # We use jq to pull the array out of the nested 'result' object
            jq -c '{
                "jsonrpc": "2.0",
                "id": "0",
                "method": "import_key_images",
                "params": {
                    "signed_key_images": .result.signed_key_images
                }
            }' "$TARGET_KI_FILE" > /tmp/batch_ki.json

            # Fire the request
            IMAGE_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc \
                -H "Content-Type: application/json" \
                -d @/tmp/batch_ki.json)

            # Check for success
            if echo "$IMAGE_RESPONSE" | jq -e '.result' >/dev/null 2>&1; then
                echo "[OK] Key images successfully imported."
                # Trigger the mandatory rescan
                curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc \
                     -d '{"jsonrpc":"2.0","id":"0","method":"rescan_spent"}' >/dev/null
            else
                echo "[FAILED] Import rejected."
            fi
        fi

        # ========================================================
        # UNCONDITIONAL EXPORT
        # ========================================================
        echo "Forcing fresh export of outputs via RPC..."
        #rm -f "outputs.hex"
        
        EXPORT_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"export_outputs","params":{"all":true}}')
        HEX=$(echo "$EXPORT_RESPONSE" | jq -r '.result.outputs_data_hex // empty')
        
        if [ -n "$HEX" ]; then
            echo "$HEX" > outputs.hex
            echo "[OK] outputs.hex written successfully"
        else
            ERR_MSG=$(echo "$EXPORT_RESPONSE" | jq -r '.error.message // "Unknown RPC Error"' 2>/dev/null)
            echo "[CRITICAL WARNING] export_outputs failed: $ERR_MSG"
        fi
        
        # 1. Force the wallet to save current memory state to disk
        echo "Committing wallet state..."
        curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"store"}' >/dev/null
        sleep 5

        # 2. Query balance ONLY after the store command is confirmed
        curl -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"get_balance"}'
        
        # 3. Shutdown gracefully so lockfiles are removed
        curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"stop_wallet"}' >/dev/null
        
        # 4. Final Cleanup of permissions (Run this as root to fix everything)
        sudo chown -R user:user "$ABS_DIR"
        
        # 1. Allow PHP to list files and check existence in this wallet directory
        sudo setfacl -m g:www-data:rx "$ABS_DIR"

        # 5. Run page generation as user to prevent root-owned file creation
        sudo bash /usr/local/bin/os/generate_monero_tx_page "$ADDR"
    fi
    
    sleep 5
done

unset PASSWORD

shopt -u nullglob

# Clean up short-lived interactive processes safely without touching the RPC daemons
pkill -x monero-wallet-cli 2>/dev/null || true