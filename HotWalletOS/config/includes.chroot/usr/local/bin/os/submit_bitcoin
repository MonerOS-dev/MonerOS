#!/bin/bash

# --- 1. REMAP ANSI PALETTE & WHIPTAIL COLORS ---
export TERM=linux
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

export NEWT_COLORS='
  root=black,black
  window=red,black
  shadow=black,black
  border=red,black
  title=red,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,red
  button=white,black
  actbutton=black,white
  entry=white,black
'

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_bitcoin"
ELECTRUM_BIN="/usr/local/bin/electrum"
LOG_FILE="/tmp/logs/submit_btc.log"

# --- Debug Mode ---
DEBUG=true

# Counters
S_COUNT=0
F_COUNT=0

mkdir -p "$(dirname "$LOG_FILE")"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

echo "Submitting signed Bitcoin Transactions via Electrum..."
echo "=================================================="

# 1. Find and sort all signed JSON transactions by timestamp using process substitution for safety
while read -r TX_PATH; do
    [ -z "$TX_PATH" ] && continue

    DIR=$(dirname "$TX_PATH")
    SIGNED_FILE=$(basename "$TX_PATH")
    
    ID_PART="${SIGNED_FILE#signed_tx_}"
    ID_PART="${ID_PART%.json}"
    
    UNSIGNED_FILE="unsigned_tx_${ID_PART}.psbt"
    SIGNED_RECORD_FILE="${DIR}/signed_record_${ID_PART}"
    ADDR_ID=$(basename "$DIR")

    if [ "$DEBUG" = true ]; then
        echo "------------------------------------------------"
        echo "Processing: $SIGNED_FILE ($ADDR_ID)"
    fi

    if [ ! -f "$TX_PATH" ]; then
        echo "[FAILED] $SIGNED_FILE ($ADDR_ID) - Transaction file missing or modified mid-process"
        ((F_COUNT++))
        continue
    fi

    # 2. Extract the 'hex' string from the JSON
    RAW_HEX=$(python3 -c "import json; print(json.load(open('$TX_PATH'))['hex'])" 2>/dev/null)

    if [ -z "$RAW_HEX" ]; then
        echo "[FAILED] $SIGNED_FILE (JSON Parse Error)"
        log_msg "ERROR: Could not parse hex from $SIGNED_FILE"
        ((F_COUNT++))
        continue
    fi

    # --- Retry Logic ---
    ATTEMPT=1
    MAX_ATTEMPTS=3
    RETRY_DELAY=15
    SUCCESS_FLAG=false

    while [ $ATTEMPT -le $MAX_ATTEMPTS ]; do
        if [ "$DEBUG" = true ] && [ $ATTEMPT -gt 1 ]; then
            echo "Attempt $ATTEMPT of $MAX_ATTEMPTS..."
        fi

        # 3. Broadcast via Electrum
        RESPONSE=$("$ELECTRUM_BIN" broadcast "$RAW_HEX" 2>&1)

        if [ "$DEBUG" = true ]; then
            echo "Electrum Response: $RESPONSE"
        fi

        # 4. Check for Success (Electrum returns the TXID - 64 hex characters)
        if [[ "$RESPONSE" =~ ^[0-9a-fA-F]{64}$ ]]; then
            TXID=$RESPONSE
            echo "[OK] $SIGNED_FILE | TXID: $TXID"
            log_msg "SUCCESS: $SIGNED_FILE | TXID: $TXID"
            ((S_COUNT++))

            # --- UI POPUP: Show Record Data & TXID (Matching Monero Workflow) ---
            if [ -f "$SIGNED_RECORD_FILE" ]; then
                RECORD_CONTENT=$(cat "$SIGNED_RECORD_FILE")
            else
                RECORD_CONTENT="No saved record details found for this transaction."
            fi

            whiptail --title " Broadcast Successful " \
                     --msgbox "Bitcoin Transaction Submitted!\n\nTXID: $TXID\n\n$RECORD_CONTENT" 0 0
            clear

            # Cleanup: Remove signed JSON, unsigned PSBT, and the signed record receipt
            rm -f "$TX_PATH" "$SIGNED_RECORD_FILE"
            [ -f "$DIR/$UNSIGNED_FILE" ] && rm -f "$DIR/$UNSIGNED_FILE"

            SUCCESS_FLAG=true
            break 
        else
            # Extract error (strip common Electrum noise)
            ERR_MSG=$(echo "$RESPONSE" | tr '\n' ' ')
            echo "[FAILED ATTEMPT $ATTEMPT] $SIGNED_FILE ($ERR_MSG)"

            if [ $ATTEMPT -lt $MAX_ATTEMPTS ]; then
                sleep $RETRY_DELAY
                ((ATTEMPT++))
            else
                echo "[FINAL FAILURE] $SIGNED_FILE"
                log_msg "FAILED: $SIGNED_FILE | Error: $ERR_MSG"
                ((F_COUNT++))
                break
            fi
        fi
    done

    sleep 1
done < <(find "$BASE_DIR" -type f -name "signed_tx_*.json" | sort -t '_' -k3 -n)

echo "=================================================="
echo "TRANSACTION PROCESSING LOOP EXHAUSTED"
if [ "$F_COUNT" -eq 0 ]; then
    echo "SUMMARY_SUCCESS: All $S_COUNT signed transactions successfully submitted."
else
    echo "SUMMARY_FAILURE: Execution finished with errors. Success Count: $S_COUNT, Failure Count: $F_COUNT"
fi

sleep 5