#!/bin/bash
# /usr/local/bin/os/import_dogecoin

if [[ $EUID -ne 0 ]]; then
   echo "FAILURE: This script must be run as root (use sudo)"
   exit 1
fi

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_dogecoin"

echo "Importing Dogecoin"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

DOGE_DATA_DIR="/home/user/.dogecoin"
# Note: Dogecoin older versions might not support multi-wallet rpcwallet flag 
# If your dogecoind version is 1.14.x, we specify the datadir.
DOGE_CLI="/usr/local/bin/dogecoin-cli -datadir=$DOGE_DATA_DIR"

# --- RAM Management: Shutdown Function ---
cleanup() {
    echo "Shutting down Dogecoin daemon to save RAM..."
    $DOGE_CLI stop > /dev/null 2>&1
    while pgrep -x "dogecoind" > /dev/null; do sleep 1; done
    echo "Daemon stopped."
}
trap cleanup EXIT 

# 1. Start Daemon if not running
if ! pgrep -x "dogecoind" > /dev/null; then
    echo "Starting Dogecoin daemon..."
    # Ensure the directory exists for the user
    mkdir -p "$DOGE_DATA_DIR"
    chown user:user "$DOGE_DATA_DIR"
    
    su - user -c "dogecoind -datadir=$DOGE_DATA_DIR -daemon"
    echo "Waiting for RPC..."
    until $DOGE_CLI getblockchaininfo > /dev/null 2>&1; do
        echo -n "."
        sleep 2
    done
    echo " Ready."
fi

# 2. Process Folders in Sallyport
mkdir -p "$BASE_DIR"
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    if [ -f "${dir}watch_info.txt" ]; then
        CLEAN_DIR="${dir%/}"
        ADDR_FOLDER=$(basename "$CLEAN_DIR")
        ADDR=$(grep "ADDRESS:" "${dir}watch_info.txt" | awk '{print $2}' | tr -d '\r')
        [ -z "$ADDR" ] && continue

        echo "--------------------------------------------------"
        echo "Processing Dogecoin Folder: $ADDR_FOLDER"

        # Check if address is already known
        # Dogecoin getaddressinfo returns 'iswatchonly'
        CHECK=$($DOGE_CLI getaddressinfo "$ADDR" 2>/dev/null | grep "iswatchonly" | grep "true")
        
        if [ -z "$CHECK" ]; then
            echo "Importing $ADDR to Dogecoin Core..."
            # importaddress <address> <label> <rescan=false>
            $DOGE_CLI importaddress "$ADDR" "$ADDR_FOLDER" false
            echo "Success: $ADDR_FOLDER is now being watched."
        else
            echo "Address already watched. Skipping."
        fi

        echo "Generating Dogecoin transfer page..."
        # We call the generator script (similar to your LTC/ETH ones)
        sudo bash /usr/local/bin/os/generate_dogecoin_tx_page "$ADDR_FOLDER"
    fi
done

echo "--------------------------------------------------"
echo "Submitting pending Dogecoin transactions..."
sudo bash /usr/local/bin/os/submit_dogecoin 

# Cleanup triggers here