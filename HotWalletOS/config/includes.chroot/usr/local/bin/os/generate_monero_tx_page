#!/bin/bash

# Define the target directory
WEB_DIR="/var/www/html"
ADDRESS=$1

# 1. Check if an address was provided
if [ -z "$ADDRESS" ]; then
    echo "Usage: $0 <wallet_address>"
    exit 1
fi

# 2. Basic sanitation
SAFE_ADDR=$(basename "$ADDRESS")
TARGET_FILE="${WEB_DIR}/${SAFE_ADDR}.php"

# 3. Check for root/sudo privileges
if [[ $EUID -ne 0 ]]; then
   echo "Error: Please run with sudo"
   exit 1
fi

# 4. Create the PHP content 
cat <<'EOF' > "$TARGET_FILE"
<?php
$address = "REPLACE_ME_ADDRESS";
$message = "";
$status_class = "";
$show_overwrite_warning = false;

// Form retention variables for the overwrite screen
$form_data = [
    'destination' => '',
    'amount' => '',
    'tip_percent' => '1.25',
    'password' => ''
];

// Path to the unlocked balance file
$balance_file = "/var/www/backend/Monero/{$address}_unlocked.txt";
$unlocked_balance = "0.0000000";

if (file_exists($balance_file)) {
    $unlocked_balance = trim(file_get_contents($balance_file));
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $dest = $_POST['destination'] ?? '';
    $amount = strtolower($_POST['amount'] ?? '');
    $tip_percent = $_POST['tip_percent'] ?? '1.25'; 
    $password = $_POST['password'] ?? '';
    $confirm_overwrite = $_POST['confirm_overwrite'] ?? '0';

    // Save for form re-submission in case warning triggers
    $form_data = [
        'destination' => $dest,
        'amount' => $amount,
        'tip_percent' => $tip_percent,
        'password' => $password
    ];

    // Scan the target directory for pre-existing unsigned transactions
    $target_dir = "/mnt/sallyport/watch_monero/{$address}/";
    $has_existing_tx = false;
    
    if (is_dir($target_dir) && ($files = @scandir($target_dir)) !== false) {
        foreach ($files as $file) {
            if (strpos($file, 'unsigned_tx') !== false) {
                $has_existing_tx = true;
                break;
            }
        }
    }

    // Check conditions: If a file exists and user has NOT already clicked "Overwrite"
    if ($has_existing_tx && $confirm_overwrite !== '1') {
        $show_overwrite_warning = true;
    } else {
        // Proceed to execution (No file exists, or user bypassed via overwrite confirmation)
        $cmd = "sudo /usr/bin/bash /usr/local/bin/os/transfer_monero " . 
                escapeshellarg($address) . " " . 
                escapeshellarg($dest) . " " . 
                escapeshellarg($amount) . " " . 
                escapeshellarg($tip_percent) . " " . 
                escapeshellarg($password);
        
        $output = shell_exec($cmd . " 2>&1");
        $message = trim($output);

        if (strpos($message, 'SUCCESS') !== false) {
            $status_class = "success";
        } else {
            $status_class = "error";
        }
    }
}
