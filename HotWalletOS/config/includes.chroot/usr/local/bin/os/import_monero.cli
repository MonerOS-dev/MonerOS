#!/bin/bash

# Check for root privileges
if [[ $EUID -ne 0 ]]; then
   echo "FAILURE: This script must be run as root (use sudo)"
   exit 1
fi

BASE_DIR="/mnt/sallyport/watch_monero"
NODE_LIST_URL="https://sourceforge.net/p/moneros/code/ci/main/tree/monero_nodes.txt?format=raw"
NODE_CACHE_FILE="/home/user/monero_node.txt"
HARDCODED_FALLBACK="cky2cwjjqchgqebbuheikewr26wy54wg3x637e3wc63mo33p4hhsu4qd.onion:18081"
PROXY="127.0.0.1:9050"
PASS_FILE="/home/user/password.cfg"
BACKEND_DIR="/var/www/backend/Monero"

echo "Importing Monero - Initializing Node Selection"

if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet directory does not exist. Exiting."
    exit 0
fi

# --- MASTER NODE SELECTION START ---
NEW_NODE=$(curl -s --socks5-hostname "$PROXY" "$NODE_LIST_URL" | sed '/^$/d' | shuf -n 1 | tr -d '\r\n ')

if [ -n "$NEW_NODE" ]; then
    echo "Successfully fetched new node from SourceForge: $NEW_NODE"
    echo "$NEW_NODE" > "$NODE_CACHE_FILE"
    REMOTE_NODE="$NEW_NODE"
elif [ -f "$NODE_CACHE_FILE" ]; then
    echo "Download failed. Using last known cached node..."
    REMOTE_NODE=$(cat "$NODE_CACHE_FILE" | tr -d '\n\r ')
else
    echo "No download or cache available. Using hardcoded fallback..."
    REMOTE_NODE="$HARDCODED_FALLBACK"
    echo "$REMOTE_NODE" > "$NODE_CACHE_FILE"
fi
# --- MASTER NODE SELECTION END ---

# Read password
if [ -f "$PASS_FILE" ]; then
    PASSWORD=$(tr -d '\n\r' < "$PASS_FILE")
else
    echo "Error: Password file not found at $PASS_FILE"
    exit 1
fi

# --- RESILIENT CONNECTION & RECOVERY START ---
CONNECTED=false
ATTEMPT=0
echo "Checking connection to Monero Node ($REMOTE_NODE) via Tor..."

while [ "$CONNECTED" = false ]; do
    ATTEMPT=$((ATTEMPT + 1))
    if curl -m 45 -s -f --socks5-hostname "$PROXY" "http://$REMOTE_NODE/get_info" > /dev/null; then
        echo "Successfully connected to the node on attempt $ATTEMPT."
        CONNECTED=true
    else
        echo "Attempt $ATTEMPT failed. Node unreachable."
        if [ $ATTEMPT -ge 5 ]; then
             echo "FAILURE: Selected node is down. Run script again to pick a different one."
             exit 1
        fi

        if (( ATTEMPT % 2 != 0 )); then
            echo "Refreshing Tor circuits (SIGHUP) and retrying in 15s..."
            sudo killall -HUP tor 2>/dev/null || sudo systemctl reload tor
            sleep 15
        else
            echo "Restarting Tor service and waiting 60s..."
            sudo systemctl restart tor
            sleep 60
        fi
    fi
done

# Ensure backend directory exists
sudo mkdir -p "$BACKEND_DIR"

for dir in "$BASE_DIR"/*/; do
    if [ -f "${dir}watch_info.txt" ]; then
        echo "--------------------------------------------------"
        echo "Processing Folder: $(basename "$dir")"
        cd "$dir"

        ADDR=$(grep "ADDRESS:" watch_info.txt | awk '{print $2}' | tr -d '\r')
        VIEW=$(grep "VIEW_KEY:" watch_info.txt | awk '{print $2}' | tr -d '\r')
        R_DATE=$(grep "RESTORE_DATE:" watch_info.txt | awk '{print $2}' | tr -d '\r')

        # --- KEY IMAGE SECURE IMPORT PASS ---
        # Checks if key images exist. If they do, imports them cleanly using an ephemeral CLI call.
        if [ -f "key_images.bin" ]; then
            echo "Incoming signed key images found. Importing into database..."
            export REMOTE_NODE PROXY PASSWORD
            /usr/bin/expect <<'EOF'
set timeout 60
set NODE $env(REMOTE_NODE)
set PRX  $env(PROXY)
set PASS $env(PASSWORD)

spawn monero-wallet-cli --wallet-file watchonly --daemon-address $NODE --proxy $PRX --trusted-daemon
expect "Wallet password:"
send "$PASS\r"
expect -re {\[wallet [A-Za-z0-9]+\]:}
send "import_key_images key_images.bin\r"
expect -re {\[wallet [A-Za-z0-9]+\]:}
send "exit\r"
expect eof
EOF
            # Archive the file so it doesn't process endlessly on future loops
            # mv "key_images.bin" "key_images.bin.bak"
        fi

        # --- WALLET GENERATION FLOW ---
        if [ ! -f "watchonly.keys" ]; then
            echo "Wallet keys not found. Rebuilding watch-only cache container for $ADDR..."
            export REMOTE_NODE PROXY PASSWORD ADDR VIEW R_DATE
            /usr/bin/expect <<'EOF'
set timeout -1
set NODE $env(REMOTE_NODE)
set PRX  $env(PROXY)
set PASS $env(PASSWORD)
set ADR  $env(ADDR)
set VW   $env(VIEW)
set DT   $env(R_DATE)

spawn monero-wallet-cli --generate-from-view-key watchonly_TEMP --daemon-address $NODE --proxy $PRX --trusted-daemon
expect "Standard address:"
send "$ADR\r"
expect "Secret view key:"
send "$VW\r"
expect "Enter a new password for the wallet:"
send "$PASS\r"
expect "Confirm password:"
send "$PASS\r"
expect "*alternatively from specific date (YYYY-MM-DD):"
send "$DT\r"
expect "*Is this okay?*"
send "y\r"
expect "*Do you want to do it now?*"
send "n\r"
expect "Background refresh thread started"
sleep 2

# --- EXPORT OUTPUTS BLOCK ---
expect -re {\[wallet [A-Za-z0-9]+\]:}
send "export_outputs all outputs.bin\r"
expect "Wallet password:"
send "$PASS\r"
expect "Outputs exported to"

send "exit\r"
expect eof
EOF

            if [ -f "watchonly_TEMP.keys" ]; then
                mv "watchonly_TEMP.keys" "watchonly.keys"
                [ -f "watchonly_TEMP" ] && mv "watchonly_TEMP" "watchonly"
            fi
        fi
        sudo bash /usr/local/bin/os/generate_monero_tx_page "$ADDR"
    fi
done

# Ensure all interactive operations are completed and unmapped cleanly
pkill -f monero-wallet-cli 2>/dev/null || true

# NOTICE: `refresh_monero` and `submit_monero` have been pulled out.
# Your unlock wrapper script handles execution chains sequentially from here.