#!/bin/bash
export PATH=/usr/bin:/bin:/usr/local/bin

BASE_DIR="/mnt/sallyport/watch_litecoin"

echo "Getting LTC Balance"
if [ ! -d "$BASE_DIR" ]; then
    echo "Wallet does not exist. Exiting."
    exit 0
fi

BACKEND_DIR="/var/www/backend/Litecoin"

# --- Configuration ---
MAX_RETRIES=3
RETRY_DELAY=20  # 20 seconds apart
mkdir -p "$BACKEND_DIR"

fetch_balance_online() {
    local addr=$1
    local attempt=1

    while [ $attempt -le $MAX_RETRIES ]; do
        local result=$(curl -s "https://litecoinspace.org/api/address/${addr}")

        # Extract values using sed to ensure we get clean integers
        local funded=$(echo "$result" | sed -n 's/.*"funded_txo_sum":\([0-9]*\).*/\1/p')
        local spent=$(echo "$result" | sed -n 's/.*"spent_txo_sum":\([0-9]*\).*/\1/p')
        
        # Pull mempool stats (unconfirmed)
        local m_funded=$(echo "$result" | sed -n 's/.*"mempool_stats":{[^}]*"funded_txo_sum":\([0-9]*\).*/\1/p')
        local m_spent=$(echo "$result" | sed -n 's/.*"mempool_stats":{[^}]*"spent_txo_sum":\([0-9]*\).*/\1/p')

        # Fallback to 0 if variables are empty to prevent syntax errors
        funded=${funded:-0}
        spent=${spent:-0}
        m_funded=${m_funded:-0}
        m_spent=${m_spent:-0}

        # Validate that we actually got a response from the API
        if [ "$result" != "" ] && [[ "$funded" =~ ^[0-9]+$ ]]; then
            # Calculate total satoshis
            local total_sat=$(( funded + m_funded - spent - m_spent ))
            
            # Convert Satoshis to LTC using awk
            local balance_ltc=$(awk -v sat="$total_sat" 'BEGIN {printf "%.8f", sat / 100000000}')
            echo "$balance_ltc"
            return 0
        fi

        echo "Attempt $attempt failed for $addr. Retrying..." >&2
        attempt=$((attempt + 1))
        [ $attempt -le $MAX_RETRIES ] && sleep $RETRY_DELAY
    done

    return 1
}

check_balance() {
    local dir=$1
    local INFO_FILE="${dir}watch_info.txt"
    
    if [ -f "$INFO_FILE" ]; then
        local ADDR=$(grep "ADDRESS:" "$INFO_FILE" | awk '{print $2}' | tr -d '\r')
        
        if [ -n "$ADDR" ]; then
            echo "Checking online Litecoin balance for: $ADDR"
            local NEW_BAL=$(fetch_balance_online "$ADDR")
            
            if [ $? -eq 0 ]; then
                # Writing to your backend directory
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_balance.txt" > /dev/null
                echo "$NEW_BAL" | sudo tee "${BACKEND_DIR}/${ADDR}_unlocked.txt" > /dev/null
                echo "SUCCESS: Updated $ADDR to $NEW_BAL LTC"
            else
                echo "ERROR: Failed to fetch balance for $ADDR after $MAX_RETRIES attempts."
            fi
        fi
    fi
}

# --- Main Loop ---
for dir in "$BASE_DIR"/*/; do
    [ -d "$dir" ] || continue
    check_balance "$dir"
done

echo "--- Litecoin online balance refresh cycle complete ---"