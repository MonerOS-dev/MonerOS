#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_dogecoin"
CONFIG_FILE="/home/user/password.cfg"
TIP_ADDRESS="DLZPZGTpXDUYvP4zt9ZqMfLqNSHBU6H64U"
LOG_FILE="/tmp/transfer_doge.log"

# Arguments
ADDRESS=$1
DEST=$2
AMOUNT=$3
TIP_PERCENT=$4
INPUT_PASS=$5

# Paths
WALLET_DIR="${WATCH_DIR}/${ADDRESS}"
mkdir -p "$WALLET_DIR"
TIMESTAMP=$(date +%s)

# 1. Verification
STORED_PASS=$(cat "$CONFIG_FILE" 2>/dev/null | tr -d '\r\n' | xargs)
if [[ "$INPUT_PASS" != "$STORED_PASS" ]]; then
    echo "FAILURE: Incorrect Wallet Password."
    exit 1
fi

# 2. Preparation & Sweep Logic
FEE_SAT=10000000 
THRESHOLD_SAT=1000000000

if [[ "$AMOUNT" == "sweep_all" ]]; then
    MAIN_SAT=0; TIP_SAT=0; IS_SWEEP="true"
else
    MAIN_SAT=$(python3 -c "print(int(float('$AMOUNT') * 100000000))")
    TIP_SAT=$(python3 -c "print(int($MAIN_SAT * (float('$TIP_PERCENT') / 100)))")
    IS_SWEEP="false"
fi

# 3. Fetch UTXOs
UTXO_DATA=$(curl -s "https://api.blockcypher.com/v1/doge/main/addrs/${ADDRESS}?unspentOnly=true")
if [[ -z "$UTXO_DATA" || "$UTXO_DATA" == *"error"* ]]; then
    echo "FAILURE: Could not reach Dogecoin API."
    exit 1
fi

# 4. Python Logic
export UTXO_DATA MAIN_SAT TIP_SAT FEE_SAT ADDRESS DEST TIP_ADDRESS IS_SWEEP TIP_PERCENT THRESHOLD_SAT
MANIFEST=$(python3 -c "
import json, sys, urllib.request, os
def get_script(txid, vout):
    try:
        url = f'https://api.blockcypher.com/v1/doge/main/txs/{txid}?limit=1000'
        with urllib.request.urlopen(url) as r:
            return json.loads(r.read().decode())['outputs'][vout]['script']
    except: return ''
try:
    data = json.loads(os.environ['UTXO_DATA'])
    f_sat, threshold, tip_pct = int(os.environ['FEE_SAT']), int(os.environ['THRESHOLD_SAT']), float(os.environ['TIP_PERCENT'])
    is_sweep = os.environ['IS_SWEEP'] == 'true'
    utxos = data.get('txrefs', [])
    sel_in, total_in = [], 0
    for u in utxos:
        s_hex = get_script(u['tx_hash'], u['tx_output_n'])
        if not s_hex: continue
        sel_in.append({'txid':u['tx_hash'], 'vout':u['tx_output_n'], 'script':s_hex, 'value':u['value']})
        total_in += u['value']
        if not is_sweep and total_in >= (int(os.environ['MAIN_SAT']) + int(os.environ['TIP_SAT']) + f_sat): break
    if is_sweep:
        # Step 1: Remove fee from total immediately
        available = total_in - f_sat
        
        # Step 2: FORCE TIP TO ZERO FOR SWEEPS
        t_sat = 0
            
        # Step 3: Main gets EVERY REMAINING SATOSHI
        m_sat = available - t_sat
    else:
        m_sat, t_sat = int(os.environ['MAIN_SAT']), int(os.environ['TIP_SAT'])
    needed = m_sat + t_sat + f_sat
    if total_in < needed or m_sat <= 0: sys.exit(1)
    manifest = {'network': 'dogecoin-mainnet', 'from': os.environ['ADDRESS'], 'inputs': sel_in, 'outputs': [{'address': os.environ['DEST'], 'value': m_sat}], 'fee': f_sat}
    if t_sat > 1000000: manifest['outputs'].append({'address': os.environ['TIP_ADDRESS'], 'value': t_sat})
    if not is_sweep and (total_in - needed) > 0: manifest['outputs'].append({'address': os.environ['ADDRESS'], 'value': (total_in - needed)})
    print(json.dumps(manifest))
except: sys.exit(1)
")

# 5. Final Output
if [[ $? -eq 0 ]]; then
    FILE_NAME="unsigned_doge_${TIMESTAMP}.json"
    echo "$MANIFEST" > "${WALLET_DIR}/${FILE_NAME}"
    chmod 666 "${WALLET_DIR}/${FILE_NAME}"
    
    echo "SUCCESS: Created ${FILE_NAME}"
    echo "NEXT: Sign this manifest on your cold-storage device."
    echo "[$(date)] SUCCESS: $ADDRESS (Sweep: $IS_SWEEP)" >> "$LOG_FILE" 2>/dev/null
else
    echo "FAILURE: Transaction creation failed. Check balance or API."
    exit 1
fi