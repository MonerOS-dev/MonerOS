#!/bin/bash

# --- Configuration ---
WATCH_DIR="/mnt/sallyport/watch_dogecoin"
CONFIG_FILE="/home/user/password.cfg"
TIP_ADDRESS="DLZPZGTpXDUYvP4zt9ZqMfLqNSHBU6H64U"
LOG_FILE="/tmp/transfer_doge.log"

# Arguments
ADDRESS=$1
DEST=$2
AMOUNT=$3
TIP_PERCENT=$4
INPUT_PASS=$5

# Paths
WALLET_DIR="${WATCH_DIR}/${ADDRESS}"
mkdir -p "$WALLET_DIR"
TIMESTAMP=$(date +%s)

# 1. Verification
STORED_PASS=$(cat "$CONFIG_FILE" 2>/dev/null | tr -d '\r\n' | xargs)
if [[ "$INPUT_PASS" != "$STORED_PASS" ]]; then
    echo "FAILURE: Incorrect Wallet Password."
    exit 1
fi

# 2. Preparation
FEE_PER_INPUT_SAT=1000000 
BASE_FEE_SAT=100000000 
MIN_TIP_SAT=1000000

if [[ "$AMOUNT" == "sweep_all" ]]; then
    MAIN_SAT=0; TIP_SAT=0; IS_SWEEP="true"
else
    MAIN_SAT=$(python3 -c "print(int(float('$AMOUNT') * 100000000))")
    TIP_SAT=$(python3 -c "print(int($MAIN_SAT * (float('$TIP_PERCENT') / 100)))")
    IS_SWEEP="false"
fi

# 3. Fetch UTXOs (UPDATED: Using SoChain for DOGE)
# SoChain's get_address_utxo endpoint
UTXO_DATA=$(curl -s "https://chain.so/api/v2/get_address_utxo/DOGE/${ADDRESS}")

if [[ -z "$UTXO_DATA" || "$UTXO_DATA" == *"\"status\":\"fail\""* ]]; then
    echo "FAILURE: Could not reach SoChain API or Address not found."
    exit 1
fi

# 4. Python Logic (UPDATED: For SoChain JSON structure)
export UTXO_DATA MAIN_SAT TIP_SAT BASE_FEE_SAT FEE_PER_INPUT_SAT ADDRESS DEST TIP_ADDRESS IS_SWEEP MIN_TIP_SAT
MANIFEST=$(python3 -c "
import json, sys, os

try:
    data = json.loads(os.environ['UTXO_DATA'])
    is_sweep = os.environ['IS_SWEEP'] == 'true'
    # SoChain puts UTXOs inside data['txs']
    utxos = data.get('data', {}).get('txs', [])
    
    if not utxos:
        print('Error: No unspent outputs found.')
        sys.exit(1)

    sel_in, total_in = [], 0
    m_sat = int(os.environ['MAIN_SAT'])
    t_sat = int(os.environ['TIP_SAT'])
    min_tip = int(os.environ['MIN_TIP_SAT'])
    
    for u in utxos:
        # SoChain provides: txid, output_no, script_asm/script_hex, and value
        s_hex = u.get('script_hex')
        val_sat = int(float(u['value']) * 100000000) # SoChain uses decimal strings
        
        if not s_hex: continue
        
        sel_in.append({
            'txid': u['txid'], 
            'vout': u['output_no'], 
            'script': s_hex, 
            'value': val_sat
        })
        total_in += val_sat
        
        # Current fee calculation
        current_fee = int(os.environ['BASE_FEE_SAT']) + (len(sel_in) * int(os.environ['FEE_PER_INPUT_SAT']))
        if not is_sweep and total_in >= (m_sat + t_sat + current_fee): break

    final_fee = int(os.environ['BASE_FEE_SAT']) + (len(sel_in) * int(os.environ['FEE_PER_INPUT_SAT']))

    if is_sweep:
        available = total_in - final_fee
        t_sat = 0 
        m_sat = available
    else:
        if t_sat < min_tip:
            t_sat = 0
            
    needed = m_sat + t_sat + final_fee
    
    if total_in < needed or m_sat <= 0:
        sys.exit(1)

    manifest = {
        'network': 'dogecoin-mainnet',
        'from': os.environ['ADDRESS'],
        'inputs': sel_in,
        'outputs': [{'address': os.environ['DEST'], 'value': m_sat}],
        'fee': final_fee
    }
    
    if t_sat > 0:
        manifest['outputs'].append({'address': os.environ['TIP_ADDRESS'], 'value': t_sat})
    
    change = total_in - needed
    if not is_sweep and change > 1000000: 
        manifest['outputs'].append({'address': os.environ['ADDRESS'], 'value': change})

    print(json.dumps(manifest))
except Exception as e:
    sys.exit(1)
")

# 5. Final Output
if [[ $? -eq 0 && -n "$MANIFEST" ]]; then
    FILE_NAME="unsigned_doge_${TIMESTAMP}.json"
    echo "$MANIFEST" > "${WALLET_DIR}/${FILE_NAME}"
    
    echo "SUCCESS: Created ${FILE_NAME}"
    echo "NEXT: Sign this manifest on your cold-storage device."
    echo "[$(date)] SUCCESS: $ADDRESS (Sweep: $IS_SWEEP)" >> "$LOG_FILE" 2>/dev/null
else
    echo "FAILURE: Transaction creation failed. Likely insufficient funds for amount + fee."
    exit 1
fi