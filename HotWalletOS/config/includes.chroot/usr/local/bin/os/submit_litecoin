#!/bin/bash

# --- Configuration ---
BASE_DIR="/mnt/sallyport/watch_litecoin"
RPC_URL="https://api.blockcypher.com/v1/ltc/main/txs/push"
LOG_FILE="/tmp/logs/submit_ltc.log"

# --- Debug Mode ---
DEBUG=true

# Counters
S_COUNT=0
F_COUNT=0

mkdir -p "$(dirname "$LOG_FILE")"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

echo "Submitting signed Litecoin Transactions via Public API"

# 1. UPDATED: Search for .json files with the ltc prefix
TX_LIST=$(find "$BASE_DIR" -type f -name "signed_ltc_*.json" | sort -t '_' -k3 -n)

if [ -z "$TX_LIST" ]; then
    echo "SUCCESS: No Litecoin transactions to process"
    exit 0
fi

for TX_PATH in $TX_LIST; do
    DIR=$(dirname "$TX_PATH")
    SIGNED_FILE=$(basename "$TX_PATH")
    # UPDATED: Match the pattern replacement for cleanup
    UNSIGNED_PATTERN=$(echo "$SIGNED_FILE" | sed 's/signed_ltc_/unsigned_ltc_/')
    ADDR_ID=$(basename "$DIR")

    if [ "$DEBUG" = true ]; then
        echo "------------------------------------------------"
        echo "Processing: $SIGNED_FILE ($ADDR_ID)"
    fi

    # 2. Extract the raw hex string from the JSON structure
    RAW_HEX=$(python3 -c "import sys, json; print(json.load(open('$TX_PATH')).get('hex', ''))" 2>/dev/null)

    if [ -z "$RAW_HEX" ]; then
        echo "[FAILED] $SIGNED_FILE (Could not extract hex from JSON)"
        ((F_COUNT++))
        continue
    fi

    # --- Retry Logic ---
    ATTEMPT=1
    MAX_ATTEMPTS=5
    RETRY_DELAY=20
    SUCCESS_FLAG=false

    while [ $ATTEMPT -le $MAX_ATTEMPTS ]; do
        if [ "$DEBUG" = true ] && [ $ATTEMPT -gt 1 ]; then
            echo "Attempt $ATTEMPT of $MAX_ATTEMPTS..."
        fi

        # 3. Broadcast via CURL
        RESPONSE=$(curl -s -X POST \
            -H "Content-Type: application/json" \
            --data "{\"tx\":\"$RAW_HEX\"}" \
            "$RPC_URL")

        if [ "$DEBUG" = true ]; then
            echo "API Response: $RESPONSE"
        fi

        # 4. Check for Success
        TX_HASH=$(echo "$RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('tx', {}).get('hash', ''))" 2>/dev/null)

        if [ -n "$TX_HASH" ] && [ "$TX_HASH" != "" ] && [ "$TX_HASH" != "None" ]; then
            echo "[OK] $SIGNED_FILE ($ADDR_ID)"
            log_msg "SUCCESS: $SIGNED_FILE | Hash: $TX_HASH"
            ((S_COUNT++))
            
            # Cleanup
            rm -f "$TX_PATH"
            find "$DIR" -name "$UNSIGNED_PATTERN" -delete
            
            SUCCESS_FLAG=true
            break 
        else
            # Extract Error Message
            ERR=$(echo "$RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('error', 'Unknown API Error'))" 2>/dev/null)
            
            echo "[FAILED ATTEMPT $ATTEMPT] $SIGNED_FILE ($ERR)"
            
            if [ $ATTEMPT -lt $MAX_ATTEMPTS ]; then
                echo "Waiting $RETRY_DELAY seconds..."
                sleep $RETRY_DELAY
                ((ATTEMPT++))
            else
                echo "[FINAL FAILURE] $SIGNED_FILE ($ERR)"
                log_msg "FAILED: $SIGNED_FILE | Error: $ERR"
                ((F_COUNT++))
                break
            fi
        fi
    done

    sleep 2
done

echo "------------------------------------------------"
if [ "$F_COUNT" -eq 0 ]; then
    echo "SUMMARY_SUCCESS: $S_COUNT processed"
else
    echo "SUMMARY_FAILURE: $S_COUNT ok, $F_COUNT failed"
fi