#!/bin/bash

# --- Configuration & Path Setup ---
WATCH_ADDR=$1
DEST=$2
COMMAND_OR_AMOUNT=$3
TIP_PERCENT=$4
PASSWORD=$5

TIP_ADDRESS="4652nzqaNoh2seCWJ2BkUei236kHpsWrMe8WRgcu14otNF8GqFaSFybNG1qtRtJcDn6S2hmzyhnaoSkdtxrWTzDXA6YirrK"
BASE_DIR="/mnt/sallyport/watch_monero"
OUTDIR="$BASE_DIR/$WATCH_ADDR"
TIMESTAMP=$(date +%s)
LOG_FILE="$OUTDIR/hot_process.log"
TIP_LOG="$OUTDIR/tip.log"
PORT_FILE="$OUTDIR/rpc_port.cfg"

# --- Silent Redirection Setup ---
# Save original terminal
exec 3>&1 4>&2
# Redirect all output to log file silently
exec > "$LOG_FILE" 2>&1

# Helper function to print to terminal only when desired
msg() {
    echo "$1" >&3
}

# Ensure log is fresh
rm -f "$LOG_FILE"

trap 'exec 1>&3 2>&4; echo "CRITICAL FAILURE: Script crashed. Check $LOG_FILE"; exit 1' ERR

#echo "Initializing operational workspace directory arrays..."
cd "$OUTDIR" || { echo "FAILURE: Critical execution directory not found: $OUTDIR"; exit 1; }

# Defensive Cleanup: Prevent stale transaction contamination
echo "Purging legacy transaction artifacts from workspace..."
rm -f "unsigned_tx_"* "response.json" "outputs.hex" "raw_out.json"

echo "Checking tracking state parameters and active connectivity maps..."
if [ -f "$PORT_FILE" ]; then
    RPC_PORT=$(tr -d '\n\r ' < "$PORT_FILE")
    echo "Active interface route found. Target connection assigned to port: $RPC_PORT"
else
    echo "FAILURE: No running RPC server port configuration found for this address segment."
    exit 1
fi

echo "Sending hard system refresh signal to the wallet tracking loop..."
curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"refresh","params":{"start_height":0}}' > /dev/null

echo "Retrieving current atomic wallet balance states from the local daemon..."
BAL_RESP=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"get_balance","params":{"account_index":0,"all_accounts":true}}')
BALANCE_RAW=$(echo "$BAL_RESP" | jq -r '.result.balance // 0')

echo "Sanitizing provided tip numeric character fields..."
TIP_PERCENT_CLEAN=$(echo "$TIP_PERCENT" | tr -cd '0-9.')

if [ -n "$TIP_PERCENT_CLEAN" ] && [ "$(echo "$BALANCE_RAW > 10000000000" | bc)" -eq 1 ]; then 
    echo "Calculating variable tracking tip allocation parameters..."
    TIP_ATOMIC=$(echo "$BALANCE_RAW * $TIP_PERCENT_CLEAN / 100" | bc | cut -d. -f1)
else
    echo "Tip percentage parameter evaluating to zero or wallet metrics beneath minimal threshold parameters."
    TIP_ATOMIC=0
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Watch: $WATCH_ADDR | Raw Balance: $BALANCE_RAW | Tip %: $TIP_PERCENT_CLEAN% | Calculated Tip (Atomic): $TIP_ATOMIC" >> "$TIP_LOG"

CMD_LOWER=$(echo "$COMMAND_OR_AMOUNT" | tr '[:upper:]' '[:lower:]')

if [ "$CMD_LOWER" == "sweep_all" ]; then
    echo "Command instruction interpreted as full balance sweep block configuration."
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing precision-split sweep via transfer simulation..." >> "$TIP_LOG"
    
    REMAINDER_ATOMIC=$BALANCE_RAW
    ITERATION_COUNT=0
    
    if [ "$TIP_ATOMIC" -le 0 ]; then
        echo "No tip allocations designated. Processing un-split direct native sweep_all map..."
        PAYLOAD=$(jq -n --arg dest "$DEST" '{"jsonrpc":"2.0","id":"0","method":"sweep_all","params":{"address":$dest,"account_index":0,"priority":1,"ring_size":16,"get_tx_set":true,"do_not_relay":true}}')
        RPC_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -H "Content-Type: application/json" -d "$PAYLOAD")
        echo "$RPC_RESPONSE" > "response.json"
    else
        echo "Tip values configured. Commencing iterative zero-dust deduction loop calculations..."
        while true; do
            ITERATION_COUNT=$((ITERATION_COUNT + 1))
            
            if [ "$ITERATION_COUNT" -gt 50 ]; then
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] FAILURE: Max loop iterations (50) reached. Safety exit." >> "$TIP_LOG"
                echo "FAILURE: Optimization loop took too many steps. Try manually adjusting fees."
                exit 1
            fi

            DEST_AMOUNT=$(echo "$REMAINDER_ATOMIC - $TIP_ATOMIC" | bc)
            
            if [ -z "$DEST_AMOUNT" ] || [ "$(echo "$DEST_AMOUNT <= 0" | bc)" -eq 1 ]; then
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] FAILURE: Wallet balance is too low to cover network fees and tips." >> "$TIP_LOG"
                echo "FAILURE: Wallet balance is too low to cover network fees and tips."
                exit 1
            fi
            
            PAYLOAD=$(jq -n --arg dest "$DEST" --argjson dest_amt "$DEST_AMOUNT" --arg tip_addr "$TIP_ADDRESS" --argjson tip_amt "$TIP_ATOMIC" \
                '{"jsonrpc":"2.0","id":"0","method":"transfer","params":{"destinations":[{"address":$dest,"amount":$dest_amt},{"address":$tip_addr,"amount":$tip_amt}],"account_index":0,"priority":1,"ring_size":16,"get_tx_set":true,"do_not_relay":true}}')
            
            RPC_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -H "Content-Type: application/json" -d "$PAYLOAD")
            
            if echo "$RPC_RESPONSE" | jq -e '.result.unsigned_txset' >/dev/null 2>&1; then
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] SUCCESS: Found zero-dust fee balance point on iteration $ITERATION_COUNT." >> "$TIP_LOG"
                echo "$RPC_RESPONSE" > "response.json"
                break
            else
                FEE_RESERVE=$(echo "$RPC_RESPONSE" | jq -r '.error.data.fee // empty')
                
                if [ -n "$FEE_RESERVE" ] && [ "$FEE_RESERVE" != "null" ] && [ "$FEE_RESERVE" -gt 0 ]; then
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Loop iteration $ITERATION_COUNT failed. Fee required: $FEE_RESERVE." >> "$TIP_LOG"
                    REMAINDER_ATOMIC=$(echo "$REMAINDER_ATOMIC - $FEE_RESERVE" | bc)
                else
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Loop iteration $ITERATION_COUNT failed without explicit fee parameters. Shaving 4000000 units." >> "$TIP_LOG"
                    REMAINDER_ATOMIC=$(echo "$REMAINDER_ATOMIC - 4000000" | bc)
                fi
            fi
        done
    fi
elif [[ "$CMD_LOWER" =~ ^[0-9.]+$ ]]; then
    echo "Command parsed as fixed-amount transfer logic configuration."
    AMT_ATOMIC=$(echo "$COMMAND_OR_AMOUNT * 1000000000000" | bc | cut -d. -f1)
    
    if [ -n "$TIP_PERCENT_CLEAN" ] && [ "$TIP_ATOMIC" -gt 0 ]; then
        TIP_ATOMIC=$(echo "$AMT_ATOMIC * $TIP_PERCENT_CLEAN / 100" | bc | cut -d. -f1)
    fi
    
    if [ "$TIP_ATOMIC" -gt 0 ]; then
        PAYLOAD=$(jq -n --arg dest "$DEST" --argjson amt "$AMT_ATOMIC" --arg tip_addr "$TIP_ADDRESS" --argjson tip_amt "$TIP_ATOMIC" \
            '{"jsonrpc":"2.0","id":"0","method":"transfer","params":{"destinations":[{"address":$dest,"amount":$amt},{"address":$tip_addr,"amount":$tip_amt}],"account_index":0,"priority":1,"ring_size":16,"get_tx_set":true,"do_not_relay":true}}')
    else
        PAYLOAD=$(jq -n --arg dest "$DEST" --argjson amt "$AMT_ATOMIC" \
            '{"jsonrpc":"2.0","id":"0","method":"transfer","params":{"destinations":[{"address":$dest,"amount":$amt}],"account_index":0,"priority":1,"ring_size":16,"get_tx_set":true,"do_not_relay":true}}')
    fi
    RPC_RESPONSE=$(curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -H "Content-Type: application/json" -d "$PAYLOAD")
    echo "$RPC_RESPONSE" > "response.json"
else
    echo "FAILURE: Invalid transactional instruction token parameter specified: '$COMMAND_OR_AMOUNT'"
    exit 1
fi

echo "Verifying server error payload data maps..."
RPC_ERR_MSG=$(echo "$RPC_RESPONSE" | jq -r '.error.message // empty')
if [ -n "$RPC_ERR_MSG" ]; then
    echo "FAILURE: Monero Wallet RPC server returned direct exception rule: $RPC_ERR_MSG"
    rm -f "response.json" "raw_out.json" "outputs.hex"
    exit 1
fi

echo "Compiling current outputs tracking data matrices from local wallet map..."
curl -s -X POST http://127.0.0.1:$RPC_PORT/json_rpc -d '{"jsonrpc":"2.0","id":"0","method":"export_outputs","params":{"all":true}}' > "raw_out.json"

OUT_HEX_DATA=$(jq -r '.result.outputs_data_hex // empty' "raw_out.json")

if [ -n "$OUT_HEX_DATA" ] && [ "$OUT_HEX_DATA" != "null" ]; then
    echo "$OUT_HEX_DATA" > "outputs.hex"
else
    echo "FAILURE: Critical exception. Could not parse outputs_data_hex token string from compile maps."
    rm -f "raw_out.json" "response.json"
    exit 1
fi
rm -f "raw_out.json"

TX_SET_HEX=$(jq -r '.result.unsigned_txset // .result.tx_metadata_list[0] // empty' "response.json")

# --- Final Status Report ---
exec 1>&3 2>&4
if [ -n "$TX_SET_HEX" ] && [ -f "outputs.hex" ]; then
    echo "$TX_SET_HEX" > "unsigned_tx_${TIMESTAMP}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] STATUS: SUCCESS generated tx file." >> "$TIP_LOG"
    rm -f "response.json" "$LOG_FILE"
    msg "SUCCESS: Created unsigned_tx_${TIMESTAMP}"
else
    msg "FAILURE: Final output validation checks encountered errors."
    cat "$LOG_FILE"
    rm -f "$LOG_FILE"
    exit 1
fi