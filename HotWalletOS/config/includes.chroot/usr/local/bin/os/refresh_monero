#!/bin/bash
# FORCED IMPORT AND VERIFY - SCAN ALL WALLETS VIA LOCAL TOR NODE

# --- Configuration ---
PASS_FILE="/home/user/password.cfg"
BASE_DIR="/mnt/sallyport/watch_monero"
# Your actual .onion address from your monerod.conf
DAEMON="cky2cwjjqchgqebbuheikewr26wy54wg3x637e3wc63mo33p4hhsu4qd.onion:18081"
PROXY="127.0.0.1:9050"

# Read password exactly
PASSWORD=$(tr -d '\n\r' < "$PASS_FILE")

# Export for Expect
export PASSWORD DAEMON PROXY

# Loop through every directory in watch_monero
for WALLET_PATH in "$BASE_DIR"/*/; do
    ADDR_ID=$(basename "$WALLET_PATH")
    cd "$WALLET_PATH" || continue

    if [ ! -f "watchonly" ]; then
        continue
    fi

    echo "=================================================="
    echo "Processing Wallet: $ADDR_ID"
    echo "Node: $DAEMON"
    echo "=================================================="

    /usr/bin/expect <<'EOF'
set timeout 600
set PASS $env(PASSWORD)
set NODE $env(DAEMON)
set PRX  $env(PROXY)

# Start wallet with proxy and onion daemon
spawn monero-wallet-cli --wallet-file "watchonly" --daemon-address "$NODE" --proxy "$PRX" --trusted-daemon

# 1. Login
expect "Wallet password:"
send -- "$PASS\r"

expect -re ".*\]:"
sleep 1

# 2. THE IMPORT (Only if file exists)
if {[file exists "key_images.bin"]} {
    send "import_key_images key_images.bin\r"
    expect {
        "Wallet password:" {
            send -- "$PASS\r"
            exp_continue
        }
        "Signed key images imported" {
            exp_continue
        }
        -re ".*\]:"
    }
}

# 3. THE RESCAN (Ensures balance is updated)
send "rescan_spent\r"
expect {
    "Wallet password:" {
        send -- "$PASS\r"
        exp_continue
    }
    -re ".*\]:"
}

# 4. THE FINAL CHECK
send "balance\r"
expect -re ".*\]:"

send "exit\r"
expect eof
EOF

    echo "--------------------------------------------------"
    echo "Finished $ADDR_ID"
done

echo "ALL WALLETS PROCESSED VIA TOR NODE."