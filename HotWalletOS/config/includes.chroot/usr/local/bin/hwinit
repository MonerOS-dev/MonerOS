#!/bin/bash

######################### This page should be edited in hwos_mods ###########################

#exit 0   # Temporarily disable this file

# 1. CLAIM THE HARDWARE (TTY1)
sudo chvt 1
exec < /dev/tty1 > /dev/tty1 2>&1

# 2. ENVIRONMENT & STYLE
export TERM=linux
stty sane

export LANG=C.UTF-8
reset
clear
setfont /usr/share/consolefonts/Lat2-TerminusBold32x16.psf.gz
setterm -cursor off

############################### Style and Unlock ############################################
export DISPLAY=:0

# --- 1. INITIALIZATION & KIOSK MODE ---
sleep 1

HW_VERSION=$(cat "/usr/local/bin/hwversion" | tr -d '\n' | xargs)

# Prevent exit via keyboard shortcuts
trap '' SIGINT SIGTERM SIGTSTP

# --- 2. CONFIGURATION & LOGGING ---
LOG_FILE="/tmp/logs/hwos_unlock.log"
sudo mkdir -p /tmp/logs
sudo chown 1000:1000 /tmp/logs

# Suppress kernel spam
sudo dmesg -n 3
export TERM=linux
stty sane

EXT_MNT="/mnt/external"
SALLY_MNT="/mnt/sallyport"
TARGET_FILE="$EXT_MNT/sallyport.bin"
SALLY_MAPPER="sallyport_unlocked"

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

# 2. ASSIGN NEWT COLORS
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# --- 3. IDENTIFY & MOUNT BOOT PARTITION ---
echo "--- Unlock Process Started: $(date) ---" > "$LOG_FILE"

# Find the disk we booted from
LIVE_DEV=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || findmnt -n -o SOURCE /)
PARENT_DISK=$(lsblk -no PKNAME "$LIVE_DEV" | head -n 1)

# Target Partition 3 (nvme0n1p3 vs sda3)
if [[ "$PARENT_DISK" == nvme* || "$PARENT_DISK" == mmcblk* ]]; then
    TARGET_PART="/dev/${PARENT_DISK}p3"
else
    TARGET_PART="/dev/${PARENT_DISK}3"
fi

echo "Targeting Partition: $TARGET_PART" >> "$LOG_FILE"

# Mount the external partition
sudo mkdir -p "$EXT_MNT"
sudo mount -t exfat -o uid=1000,gid=1000,fmask=0000,dmask=0000 "$TARGET_PART" "$EXT_MNT"

# Setup internet
while true; do
    sleep 2
    IP_ADDR=$(hostname -I)
    if [[ -z "${IP_ADDR// }" ]]; then
        sudo bash /usr/local/bin/os/wifi-setup
    else
        break
    fi
done

# Verify file exists
if [ ! -f "$TARGET_FILE" ]; then
    echo "CRITICAL: $TARGET_FILE not found!" >> "$LOG_FILE"
    whiptail --title " ERROR " --msgbox "No Sallyport File Detected!\n\nYou must connect this device and boot from ColdWalletOS first to setup Sallyport!\n\nClick 'OK' to shutdown now..." 0 0
    sudo poweroff
    exit 1
fi

# --- 4. UNLOCK LUKS LOOP CONTAINER ---
sudo mkdir -p "$SALLY_MNT"

# Quick structural verification that the target is a valid LUKS target image
if ! sudo cryptsetup isLuks "$TARGET_FILE" 2>/dev/null; then
    echo "CRITICAL: $TARGET_FILE is not a valid LUKS volume!" >> "$LOG_FILE"
    whiptail --title " ERROR " --msgbox "Sallyport container is corrupted or not configured for LUKS!\n\nClick 'OK' to shutdown..." 0 0
    sudo poweroff
    exit 1
fi

while true; do
    # 1. Capture password
    PASS=$(whiptail --title " $HW_VERSION " --passwordbox \
        "\nEnter password to unlock Sallyport:" 12 50 \
        --nocancel 3>&1 1>&2 2>&3)

    # 2. Pre-cleanup: Clean up any stale mapper nodes or partial hanging mounts safely
    sudo umount "$SALLY_MNT" > /dev/null 2>&1
    sudo cryptsetup close "$SALLY_MAPPER" > /dev/null 2>&1

    echo "Attempting LUKS decryption..." >> "$LOG_FILE"
    
    # 3. Open the container file natively through the loop interface using cryptsetup
    if printf '%s' "$PASS" | sudo timeout 15s cryptsetup open "$TARGET_FILE" "$SALLY_MAPPER" -d - >> "$LOG_FILE" 2>&1; then
        
        echo "Attempting to mount inner ext4 partition..." >> "$LOG_FILE"
        if sudo mount "/dev/mapper/$SALLY_MAPPER" "$SALLY_MNT" >> "$LOG_FILE" 2>&1; then
            # Ensure standard user space can read/write the unlocked ext4 partition payload
            sudo chown -R 1000:1000 "$SALLY_MNT"
            
            echo "SUCCESS: $TARGET_FILE mounted safely." >> "$LOG_FILE"
            unset PASS
            break 
        else
            echo "FAILED: Mount operation rejected." >> "$LOG_FILE"
            sudo cryptsetup close "$SALLY_MAPPER" 2>/dev/null
            whiptail --title " Error " --msgbox "Failed to mount partition. Filesystem might be damaged." 8 50
        fi
    else
        # 4. Immediate Notification on Decryption Failure
        echo "FAILED: Incorrect Password or Timeout" >> "$LOG_FILE"
        whiptail --title " Error " --msgbox "Incorrect password. Please try again." 8 40
    fi
done

# --- 5. CLEANUP & EXIT ---
# Restore terminal behavior
setterm -cursor on
stty sane
[[ "$TERM" == "xterm"* ]] && stty erase '^?' || stty erase '^H'

# Clear screen for a clean desktop transition
clear
sleep 1

### SYSTEM CLOCK SYNC ###
TIME=$(curl -sI --connect-timeout 2 http://deb.debian.org | grep -i '^Date:' | cut -d' ' -f2-)
if [ -n "$TIME" ]; then
    sudo date -s "$TIME"
    sudo hwclock --systohc
fi





echo "Searching for Monero Wallets..."
sudo bash /usr/local/bin/os/spinup_monero || true







echo "Getting Balances..."
sudo bash /usr/local/bin/os/get_crypto_balances || true

################################ Tor #########################################
sudo bash /usr/local/bin/os/start_tor_server || true

###############################################
# --- 6. SWITCH BACK TO X11 FOR GUI ---
###############################################

echo "Starting GUI..."
sleep 3

export DISPLAY=:0
xhost +local:root > /dev/null 2>&1
pkill xscreensaver > /dev/null 2>&1 || true

# 1. Launch black xterm overlay
xterm -fullscreen -bg black -fg black -e "sleep 30" > /dev/null 2>&1 &
XTERM_PID=$!

# 2. Wait for xterm to exist and set initial fullscreen state
until wmctrl -l -x 2>/dev/null | grep -i "xterm"; do
    sleep 0.1
done
wmctrl -r "xterm" -b add,fullscreen,above

# 3. Switch to VT7
sudo chvt 7

# 4. IMMEDIATELY FORCE XTERM TO FRONT AFTER VT SWITCH
wmctrl -r "xterm" -b add,fullscreen,above 2>/dev/null
wmctrl -a "xterm" 2>/dev/null

# 5. Hide mouse cursor
if command -v unclutter >/dev/null; then
    # After (waits 3 seconds after mouse stops before hiding):
    nohup unclutter -idle 3 -root >/dev/null 2>&1 &
fi

# 6. Launch Surf 
sudo -u user DISPLAY=:0 WEBKIT_DISABLE_COMPOSITING_MODE=1 nohup surf -K -F -N http://localhost > /dev/null 2>&1 &
# Old way to launch surf
#sudo -u user DISPLAY=:0 nohup surf -K -F -N http://localhost > /dev/null 2>&1 &

# 7. Wait for Surf window to map
until wmctrl -l -x 2>/dev/null | grep -i "surf"; do
    sleep 0.2
done

# 8. Hold the curtain up for 8 seconds while WebKit renders in secret
for i in $(seq 1 40); do
    wmctrl -r "xterm" -b add,fullscreen,above 2>/dev/null
    wmctrl -a "xterm" 2>/dev/null
    sleep 0.2
done

# 9. Promote Surf to top and drop the xterm curtain
wmctrl -r "surf" -b add,fullscreen,above
kill $XTERM_PID 2>/dev/null || true





sudo tee /etc/systemd/system/monero-node-monitor.service > /dev/null << 'EOF'
[Unit]
Description=Monero Master Node Health Monitor
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/os/monero_node_monitor
Restart=always
RestartSec=5
KillMode=process
User=root

[Install]
WantedBy=multi-user.target
EOF

# --- Reload and Enable ---
sudo chmod +x /usr/local/bin/os/monero_node_monitor
sudo systemctl daemon-reload
sudo systemctl enable --now monero-node-monitor.service
echo -e "${WHITE}[*] Node Monitor injected and started successfully.${NC}"
    
    

exit 0