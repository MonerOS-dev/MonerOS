#!/bin/sh
set -e

# 1. Fix SSH: Create directory and generate keys
mkdir -p /run/sshd
ssh-keygen -A

# 2. Fix WiFi: Ensure NetworkManager doesn't ignore your interfaces
# Sometimes live-build leaves interfaces in /etc/network/interfaces which blocks NM
echo "managed=true" >> /etc/NetworkManager/NetworkManager.conf

# 3. Security: Ensure your custom sshd_config has correct permissions
chmod 644 /etc/ssh/sshd_config
