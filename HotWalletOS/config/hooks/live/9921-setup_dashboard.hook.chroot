#!/bin/sh
set -e

DASH_DIR="/usr/local/bin/dashboard"

if [ ! -d "$DASH_DIR" ]; then
    echo "=== Setting up BasicSwap Dashboard Environment ==="

    export DEBIAN_FRONTEND=noninteractive
    apt-get update

    # 1. Purge any old system-packaged python3-webview (which is too old/broken)
    apt-get purge -y python3-webview || true

    # 2. Install required runtime system bindings (GTK + WebKit2)
    apt-get install -y --no-install-recommends \
        python3-venv \
        python3-pip \
        python3-gi \
        python3-gi-cairo \
        gir1.2-gtk-3.0 \
        gir1.2-webkit2-4.1

    # 3. Create clean directory and isolated venv WITH system-site-packages 
    #    (Required so pywebview can access the apt-installed python3-gi bindings)
    mkdir -p "$DASH_DIR"
    python3 -m venv --system-site-packages "$DASH_DIR/venv"

    # 4. Upgrade pip and install the latest pywebview directly from PyPI
    "$DASH_DIR/venv/bin/pip" install --upgrade pip
    "$DASH_DIR/venv/bin/pip" install pywebview

    # 5. Write the Python launcher script
    cat << 'EOF' > "$DASH_DIR/launch_dashboard.py"
import os
import sys
import fcntl
import webview

def bring_to_front():
    """Brings the existing window to the front using pure Python/GTK or fallback commands."""
    # 1. Try using standard X11 utility if present (usually pre-installed on most desktop Linux distros)
    if os.system('which wmctrl > /dev/null 2>&1') == 0:
        os.system('wmctrl -a "BasicSwap Dashboard"')
        return

    # 2. Pure Python GTK/GdkX11 approach (if PyGObject is available)
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk, GdkX11
        
        # Look through all open top-level windows for our title
        for window in Gtk.Window.list_toplevels():
            if window.get_title() == "BasicSwap Dashboard":
                window.present()  # Un-minimizes and brings to focus
                return
    except Exception:
        pass

    # 3. Ultimate fallback: standard shell tools
    os.system('xdotool search --name "BasicSwap Dashboard" windowactivate 2>/dev/null')

def open_window():
    storage_path = os.path.expanduser('~/.local/share/basicswap_webview')
    os.makedirs(storage_path, exist_ok=True)

    # --- Single-Instance Lock Mechanism (Pure Python standard library) ---
    lock_file_path = os.path.join(storage_path, 'app.lock')
    lock_file = open(lock_file_path, 'w')
    
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (IOError, BlockingIOError):
        # Already running: bring it to view and exit this secondary launch
        bring_to_front()
        sys.exit(0)
    # -------------------------------------------------------------------

    webview.create_window(
        'BasicSwap Dashboard',
        'http://127.0.0.1:12700',
        maximized=True,
        fullscreen=False
    )
    
    webview.start(
        private_mode=False,
        storage_path=storage_path,
        debug=False
    )

if __name__ == '__main__':
    open_window()
EOF

    # 6. Create the global shell wrapper
    cat << 'EOF' > /usr/local/bin/start-dashboard
#!/bin/sh
export DISPLAY=:0
exec /usr/local/bin/dashboard/venv/bin/python /usr/local/bin/dashboard/launch_dashboard.py > /dev/null 2>&1 &
EOF
    chmod +x /usr/local/bin/start-dashboard

    # 7. Completely purge and clean up pip, wheel, setuptools, and binaries
    apt-get purge -y python3-pip python3-wheel python3-setuptools python-pip-whl || true
    apt-get autoremove -y
    apt-get clean
    rm -f /usr/bin/pip /usr/bin/pip3 /usr/local/bin/pip /usr/local/bin/pip3 || true
    rm -rf /root/.cache/pip /home/user/.cache/pip || true

    echo "=== BasicSwap Dashboard Setup Complete ==="
fi