#!/bin/bash

######################### This page should be edited in hwos_mods ###########################

#exit 0   # Temporarily disable this file

HW_VERSION=$(cat "/usr/local/bin/hwversion" | tr -d '\n' | xargs)

############################### Style and Unlock ############################################
export DISPLAY=:0

# --- 1. INITIALIZATION & KIOSK MODE ---
sleep 1

# UI Styling
export TERM=linux
stty sane

# Disable the screensaver immediately
xset s off s noblank -dpms
pkill xscreensaver > /dev/null 2>&1 || true

# Set terminal title
echo -ne "\033]0;Sallyport-Unlock\007"

# Wait until the window with that title actually exists
until wmctrl -l 2>/dev/null | grep -q "Sallyport-Unlock"; do
    sleep 0.1
done

# Now safely fullscreen it
wmctrl -r "Sallyport-Unlock" -b add,fullscreen,above

# Hide cursor and clear screen
setterm -cursor off
clear

# Prevent exit via keyboard shortcuts
trap '' SIGINT SIGTERM SIGTSTP

# --- 2. CONFIGURATION & LOGGING ---
LOG_FILE="/tmp/logs/hwos_unlock.log"
sudo mkdir -p /tmp/logs
sudo chown 1000:1000 /tmp/logs

# Suppress kernel spam
sudo dmesg -n 3
export TERM=linux
stty sane

EXT_MNT="/mnt/external"
SALLY_MNT="/mnt/sallyport"
TARGET_FILE="$EXT_MNT/sallyport.bin"
SALLY_MAPPER="sallyport_unlocked"

# 1. REMAP ANSI PALETTE
if [ "$TERM" = "linux" ]; then
    # Color 4 (Blue) -> Bright Red (#ff0000)
    echo -ne "\e]P4ff0000" 
    # Color 7 (Lightgray) -> Pure White
    echo -ne "\e]P7ffffff" 
    clear
fi

# 2. ASSIGN NEWT COLORS
export NEWT_COLORS='
  root=black,black
  window=blue,black
  shadow=black,black
  border=blue,black
  title=blue,black
  textbox=white,black
  label=white,black
  listbox=white,black
  actlistbox=black,blue
  button=white,black
  actbutton=black,white
  entry=white,black
'

# --- 3. IDENTIFY & MOUNT BOOT PARTITION ---
echo "--- Unlock Process Started: $(date) ---" > "$LOG_FILE"

# Find the disk we booted from
LIVE_DEV=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || findmnt -n -o SOURCE /)
PARENT_DISK=$(lsblk -no PKNAME "$LIVE_DEV" | head -n 1)

# Target Partition 3 (nvme0n1p3 vs sda3)
if [[ "$PARENT_DISK" == nvme* || "$PARENT_DISK" == mmcblk* ]]; then
    TARGET_PART="/dev/${PARENT_DISK}p3"
else
    TARGET_PART="/dev/${PARENT_DISK}3"
fi

echo "Targeting Partition: $TARGET_PART" >> "$LOG_FILE"

# Mount the external partition
sudo mkdir -p "$EXT_MNT"
sudo mount -t exfat -o uid=1000,gid=1000,fmask=0000,dmask=0000 "$TARGET_PART" "$EXT_MNT"

# Setup internet
sleep 2
IP_ADDR=$(hostname -I)
if [[ -z "${IP_ADDR// }" ]]; then
    sudo bash /usr/local/bin/os/wifi-setup
fi

# Verify file exists
if [ ! -f "$TARGET_FILE" ]; then
    echo "CRITICAL: $TARGET_FILE not found!" >> "$LOG_FILE"
    whiptail --title " ERROR " --msgbox "No Sallyport File Detected!\n\nYou must connect this device and boot from ColdWalletOS first to setup Sallyport!\n\nClick 'OK' to shutdown now..." 0 0
    sudo poweroff
    exit 1
fi

# --- 4. UNLOCK LUKS LOOP CONTAINER ---
sudo mkdir -p "$SALLY_MNT"

# Quick verification that the file is actually a valid LUKS volume
if ! sudo cryptsetup isLuks "$TARGET_FILE" 2>/dev/null; then
    echo "CRITICAL: $TARGET_FILE is not a valid LUKS volume!" >> "$LOG_FILE"
    whiptail --title " ERROR " --msgbox "Sallyport container is corrupted or not configured for LUKS!\n\nClick 'OK' to shutdown..." 0 0
    sudo poweroff
    exit 1
fi

while true; do
    # 1. Capture password
    PASS=$(whiptail --title " $HW_VERSION " --passwordbox \
        "\nEnter password to unlock Sallyport:" 12 50 \
        --nocancel 3>&1 1>&2 2>&3)

    # 2. Pre-cleanup: Clean up any old mapper nodes or hanging mounts safely
    sudo umount "$SALLY_MNT" > /dev/null 2>&1
    sudo cryptsetup close "$SALLY_MAPPER" > /dev/null 2>&1

    echo "Attempting LUKS decryption..." >> "$LOG_FILE"
    
    # 3. Open the container file natively through the loop interface using cryptsetup
    if printf '%s' "$PASS" | sudo timeout 15s cryptsetup open "$TARGET_FILE" "$SALLY_MAPPER" -d - >> "$LOG_FILE" 2>&1; then
        
        echo "Attempting to mount inner ext4 partition..." >> "$LOG_FILE"
        if sudo mount "/dev/mapper/$SALLY_MAPPER" "$SALLY_MNT" >> "$LOG_FILE" 2>&1; then
            # Ensure standard user can read/write the unlocked ext4 container contents
            sudo chown -R 1000:1000 "$SALLY_MNT"
            
            echo "SUCCESS: $TARGET_FILE mounted safely." >> "$LOG_FILE"
            unset PASS
            break 
        else
            echo "FAILED: Mount operation rejected." >> "$LOG_FILE"
            sudo cryptsetup close "$SALLY_MAPPER" 2>/dev/null
            whiptail --title " Error " --msgbox "Failed to mount partition. Filesystem might be damaged." 8 50
        fi
    else
        # 4. Immediate Notification on Failure
        echo "FAILED: Incorrect Password or Timeout" >> "$LOG_FILE"
        whiptail --title " Error " --msgbox "Incorrect password. Please try again." 8 40
    fi
done

# --- 5. CLEANUP & EXIT ---
# Restore terminal behavior
setterm -cursor on
stty sane
[[ "$TERM" == "xterm"* ]] && stty erase '^?' || stty erase '^H'

# Clear screen for a clean desktop transition
clear
sleep 1

### SYSTEM CLOCK SYNC ###
TIME=$(curl -sI --connect-timeout 2 http://deb.debian.org | grep -i '^Date:' | cut -d' ' -f2-)
if [ -n "$TIME" ]; then
    sudo date -s "$TIME"
    sudo hwclock --systohc
fi






if df -h | grep -qE '/run/live/medium|/usr/lib/live/mount/medium'; then
    LIVE_DEV=$(df /run/live/medium 2>/dev/null | tail -n1 | awk '{print $1}')
    BOOT_DISK=$(lsblk -no PKNAME "$LIVE_DEV" | head -n1)
else
    ROOT_DEV=$(df / | tail -n1 | awk '{print $1}')
    BOOT_DISK=$(lsblk -no PKNAME "$ROOT_DEV" | head -n1)
fi
[ -z "$BOOT_DISK" ] && BOOT_DISK=$(lsblk -nro NAME,TYPE | grep 'disk' | head -n1 | awk '{print $1}')
DISK_PATH="/dev/$BOOT_DISK"

# Launch backend infrastructure imports
REMOTE_NODE_CFG="/mnt/external/remote_node.cfg"

# 1. EXPAND TARGET PARTITION PATH BASED ON ARCHITECTURE
if [[ "$DISK_PATH" == *"nvme"* || "$DISK_PATH" == *"mmcblk"* ]]; then
    TARGET_PART4_PATH="${DISK_PATH}p4"
else
    TARGET_PART4_PATH="${DISK_PATH}4"
fi

# 2. EVALUATE SYSTEM SETUP STRATEGY
RUN_SELF_SETUP=false

# Bypass all wizard prompts if a custom remote node configuration already exists
if [ -f "$REMOTE_NODE_CFG" ] && [ -n "$(cat "$REMOTE_NODE_CFG" | tr -d '[:space:]')" ]; then
    echo "Custom remote node configuration found. Skipping wizard." >> "$LOG_FILE"

# FIXED: Check the explicit partition block device instead of the raw parent drive path
elif [ -b "$TARGET_PART4_PATH" ]; then
    echo "Local storage partition ($TARGET_PART4_PATH) already exists. Defaulting to local sync without prompts." >> "$LOG_FILE"
    RUN_SELF_SETUP=true

else
    # --- NO CONFIG AND NO PARTITION DETECTED: RUN INTERACTIVE SETUP ---
    sudo mkdir -p /mnt/external

    # Space Check on the raw parent block device to see if hosting a local node is viable
    REQUIRED_BYTES=$((200 * 1024 * 1024 * 1024))
    TOTAL_DISK_BYTES=$(lsblk -bno SIZE "$DISK_PATH" | head -n1 | xargs)
    TOTAL_DISK_BYTES=${TOTAL_DISK_BYTES:-0}

    # SCENARIO A: STORAGE DEPRIVED (MUST MANUALLY INPUT REMOTE TARGET)
    if [ "$TOTAL_DISK_BYTES" -lt "$REQUIRED_BYTES" ]; then
    
        MSG_LOW_SPACE="You do not have enough disk space (200GB required) to host a local node.\nYou must manually configure a custom remote node address to proceed or choose to shut down.\n\nAlternatively, you can mount HWOS_SALLY partition and add a text file named remote_node.cfg containing the remote node address."
    
        if whiptail --title " Insufficient Space " \
            --yesno "$MSG_LOW_SPACE" 15 50 --fb \
            --yes-button "Remote Node" --no-button "Shut Down"; then

            # Prompt operator for manual remote node specification
            while true; do
                USER_NODE=$(whiptail --inputbox "Enter remote node address (e.g., 123.45.67.89:18081 or onion:18081):" 15 50 --fb 3>&1 1>&2 2>&3)
                
                if [ $? -ne 0 ]; then
                    sudo bash /usr/local/bin/os/safe_shutdown
                    exit 0
                fi
                
                CLEAN_NODE=$(echo "$USER_NODE" | tr -d '[:space:]')
                if [ -n "$CLEAN_NODE" ]; then
                    if [[ "$CLEAN_NODE" =~ :[0-9]+$ ]]; then
                        echo "$CLEAN_NODE" | sudo tee "$REMOTE_NODE_CFG" > /dev/null
                        break
                    else
                        whiptail --fb --msgbox "Missing port mapping. You must specify the port explicitly (e.g., target.onion:18081)." 9 50
                    fi
                else
                    whiptail --fb --msgbox "Node address cannot be blank. Please try again." 8 50
                fi
            done
    
        else
            sudo bash /usr/local/bin/os/safe_shutdown
            exit 0
        fi
    
    # SCENARIO B: SUFFICIENT SPACE AVAILABLE (PROMPT FOR SETUP TYPE)
    else
    
        MSG_NODE="System storage is verified. Would you like to host your own node locally (Self-Sync) or connect to an external node?\n\nNote: Self-Sync provides absolute privacy but can take up to 1-3 days to sync"
    
        if whiptail --title " Node Synchronization Engine " \
            --yesno "$MSG_NODE" 15 50 --fb \
            --yes-button "Remote Node" --no-button "Self-Sync"; then

            # User chose to bypass local syncing -> Collect manual node metadata
            while true; do
                USER_NODE=$(whiptail --inputbox "Enter remote node address (e.g., 123.45.67.89:18081 or onion:18081):" 12 50 --fb 3>&1 1>&2 2>&3)
                
                if [ $? -ne 0 ]; then
                    sudo bash /usr/local/bin/os/safe_shutdown
                    exit 0
                fi
                
                CLEAN_NODE=$(echo "$USER_NODE" | tr -d '[:space:]')
                
                if [ -n "$CLEAN_NODE" ]; then
                    if [[ "$CLEAN_NODE" =~ :[0-9]+$ ]]; then
                        echo "$CLEAN_NODE" | sudo tee "$REMOTE_NODE_CFG" > /dev/null
                        break
                    else
                        whiptail --fb --msgbox "Missing port mapping. You must specify the port explicitly (e.g., target.onion:18081)." 9 50
                    fi
                else
                    whiptail --fb --msgbox "Node address cannot be blank. Please try again." 8 50
                fi
            done
    
        else
            # Confirmed local deployment -> Execute local node synchronization
            RUN_SELF_SETUP=true
        fi
    fi
    
    sleep 5
fi

# --- 3. PARTITIONING & FORMATTING ---

if [ "$RUN_SELF_SETUP" = true ]; then
    if [[ "$DISK_PATH" == *"nvme"* || "$DISK_PATH" == *"mmcblk"* ]]; then
        TARGET_PART_PATH="${DISK_PATH}p4"
    else
        TARGET_PART_PATH="${DISK_PATH}4"
    fi

    if [ ! -b "$TARGET_PART_PATH" ]; then
        {
            echo 10
            # We send all the "Disk in use" chatter to /dev/null
            sudo fdisk -w always -W always "$DISK_PATH" <<EOF > /dev/null 2>&1
n
p
4


w
EOF
            echo 50
            # Force kernel to see it, keep it quiet
            sudo partx -u "$DISK_PATH" > /dev/null 2>&1 || true
            sudo udevadm settle
            sleep 5
            
            echo 80
            # Format cleanly. No "-K" flag, forcing ext4 to fully map out its inode tables now.
            sudo mkfs.ext4 -F "$TARGET_PART_PATH" > /dev/null 2>&1
            echo 100
        } | bash -c 'whiptail --title " Storage Setup " --gauge "Creating and Formatting Partition 4..." 8 50 0 2>/dev/tty'
    fi
    
    sleep 5

    # --- 4. MOUNTING & SWAP ---
    sudo mkdir -p /mnt/p4
    
    # Advanced mount flags to eliminate metadata write amplification for the LMDB runtime
    MOUNT_OPTS_PERF="noatime,nodiratime,lazytime,commit=60"
    # Fallback standard flags
    MOUNT_OPTS_SAFE="defaults"

    if ! mountpoint -q /mnt/p4; then
        # 1. Try high-performance mount
        if ! sudo mount -o $MOUNT_OPTS_PERF "$TARGET_PART_PATH" /mnt/p4 > /dev/null 2>&1; then
            sudo partprobe "$DISK_PATH" > /dev/null 2>&1
            sleep 5
            
            # 2. Try high-performance mount one last time
            if ! sudo mount -o $MOUNT_OPTS_PERF "$TARGET_PART_PATH" /mnt/p4 > /dev/null 2>&1; then
                
                # 3. FATAL FALLBACK: Strip all custom flags and try to mount safely
                if ! sudo mount -o $MOUNT_OPTS_SAFE "$TARGET_PART_PATH" /mnt/p4 > /dev/null 2>&1; then
                    whiptail --title " Critical Failure " --msgbox "Catastrophic mount failure. The partition may be corrupted." 16 50 2>/dev/tty </dev/tty
                    exit 1
                fi
                
            fi
        fi
    fi

    sudo mkdir -p /mnt/p4/monero
    sudo chown user:user /mnt/p4/monero

    if [ ! -f /mnt/p4/swapfile ]; then
        {
            echo 20; sudo fallocate -l 8G /mnt/p4/swapfile > /dev/null 2>&1
            echo 50; sudo chmod 600 /mnt/p4/swapfile > /dev/null 2>&1
            echo 70; sudo mkswap /mnt/p4/swapfile > /dev/null 2>&1
            echo 90; sudo swapon /mnt/p4/swapfile > /dev/null 2>&1
            echo 100
        } | bash -c 'whiptail --title " Optimization " --gauge "Creating 8GB Swap File..." 8 50 0 2>/dev/tty'
    fi
    
    # Tune Kernel Swap behavior right before daemon runtime to protect physical RAM mapping
    sudo sysctl vm.swappiness=10 > /dev/null 2>&1
    
    # startup self-hosted sync
    sudo bash /usr/local/bin/os/start_self_monero
fi







sudo bash /usr/local/bin/os/import_monero || true
sudo bash /usr/local/bin/os/start_monero_daemon || true
sudo bash /usr/local/bin/os/submit_monero || true

echo "Getting Balances..."
sudo bash /usr/local/bin/os/get_crypto_balances || true

################################ Tor #########################################
sudo bash /usr/local/bin/os/start_tor_server || true

########################### testing #######################################
# --- 6. OPEN LOCALHOST IN FULLSCREEN BROWSER ---
clear
echo "Finalizing UI..."

# 1. Open X11 permissions so root-initiated processes can draw on the screen
xhost +local:root > /dev/null 2>&1

# 2. Launch Surf as the standard user
sudo -u user DISPLAY=:0 nohup surf -K -F -N http://localhost > /dev/null 2>&1 &

# 3. Hide cursor (Runs as root, which is fine for unclutter)
if command -v unclutter >/dev/null; then
    nohup unclutter -idle 3 -root >/dev/null 2>&1 &
fi

# 4. Give surf time to stabilize
sleep 2

# 5. Wait for browser to be up before we actually exit the script
sleep 30